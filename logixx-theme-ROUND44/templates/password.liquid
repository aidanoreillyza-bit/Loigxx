<section class="lx-password" style="min-height:100dvh;display:flex;align-items:center;justify-content:center;text-align:center;padding:2rem;background:var(--lx-bg-soft);">
  <div style="max-width:420px;">
    <h1 style="margin-bottom:.5rem;">{{ shop.name }}</h1>
    <p style="color:var(--lx-muted);margin-bottom:2rem;">{{ page_description | default: 'Opening soon.' }}</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Password"
             style="padding:.75rem 1.1rem;border:1.5px solid var(--lx-line-strong);border-radius:var(--lx-pill);font-family:var(--lx-body);width:100%;margin-bottom:.75rem;">
      <button type="submit" class="btn btn-primary btn-block">Enter</button>
    {% endform %}
  </div>
</section>
