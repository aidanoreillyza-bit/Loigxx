<section class="edu-banner">
  <div class="container">
    {% if section.settings.eyebrow != blank %}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>
    {% form 'contact' %}
      <div class="newsletter-form">
        <input type="email" name="contact[email]" placeholder="Enter your email" required>
        <button type="submit" class="btn">{{ section.settings.btn_text }}</button>
      </div>
    {% endform %}
  </div>
</section>
{% stylesheet %}
.edu-banner{ padding-block:clamp(3.5rem,7vw,6rem); background:var(--lx-blue); text-align:center; }
.edu-banner .eyebrow{ color:rgba(255,255,255,.75); }
.edu-banner h2{ color:#fff; margin:.6rem 0 1rem; font-size:clamp(1.6rem,4vw,2.4rem); }
.edu-banner p{ color:rgba(255,255,255,.85); font-size:1.05rem; max-width:48ch; margin:0 auto 2rem; line-height:1.65; }
.newsletter-form{ display:flex; gap:.6rem; max-width:480px; margin-inline:auto; flex-wrap:wrap; }
.newsletter-form input[type="email"]{ flex:1; min-width:200px; padding:.75rem 1.1rem; border:none; border-radius:var(--lx-pill); font-family:var(--lx-body); font-size:.95rem; outline:none; }
.newsletter-form input[type="email"]:focus{ box-shadow:0 0 0 3px rgba(255,255,255,.4); }
.newsletter-form .btn{ background:#fff; color:var(--lx-blue-700); font-weight:700; border-radius:var(--lx-pill); padding:.75rem 1.5rem; border:none; cursor:pointer; white-space:nowrap; transition:background var(--lx-dur) var(--lx-ease), color var(--lx-dur); }
.newsletter-form .btn:hover{ background:var(--lx-navy); color:#fff; }
{% endstylesheet %}

{% schema %}
{
  "name": "Education banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay informed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Knowledge is power." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Join our community for weekly expert tips on your fertility journey, plus 10% off your first order." },
    { "type": "text", "id": "btn_text", "label": "Button", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Education banner" }]
}
{% endschema %}
