<section class="trust-bar">
  <div class="container">
    <div class="trust-grid">

      <div class="trust-item">
        <div class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg></div>
        <div class="trust-text"><strong>Clinically proven</strong><span>Backed by science</span></div>
      </div>

      <div class="trust-item">
        <div class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <div class="trust-text"><strong>Doctor recommended</strong><span>40+ countries</span></div>
      </div>

      <div class="trust-item">
        <div class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
        <div class="trust-text"><strong>Free UK delivery</strong><span>On orders over £50</span></div>
      </div>

      <div class="trust-item">
        <div class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></div>
        <div class="trust-text"><strong>311k+ couples</strong><span>Helped on their journey</span></div>
      </div>

    </div>
  </div>
</section>
{% stylesheet %}
.trust-bar{ background:#fff; border-block:1px solid var(--lx-line); }
.trust-grid{ display:grid; grid-template-columns:repeat(4,1fr); }
.trust-item{ display:flex; align-items:center; gap:.9rem; padding:clamp(1.3rem,2.5vw,1.9rem) clamp(1rem,2vw,1.75rem); position:relative; }
.trust-item + .trust-item::before{ content:""; position:absolute; left:0; top:22%; bottom:22%; width:1px; background:var(--lx-line); }
.trust-icon{ width:46px; height:46px; flex:none; border-radius:12px; display:flex; align-items:center; justify-content:center; background:var(--lx-blue-050); color:var(--lx-blue); transition:transform var(--lx-dur) var(--lx-ease), background var(--lx-dur); }
.trust-icon svg{ width:23px; height:23px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
.trust-item:hover .trust-icon{ transform:translateY(-2px); background:var(--lx-blue-100); }
.trust-text{ display:flex; flex-direction:column; }
.trust-text strong{ font-family:var(--lx-display); font-size:1rem; color:var(--lx-navy); line-height:1.2; }
.trust-text span{ font-size:.82rem; color:var(--lx-muted); }
@media (max-width:860px){
  .trust-grid{ grid-template-columns:repeat(2,1fr); }
  .trust-item:nth-child(odd)::before{ display:none; }
  .trust-item:nth-child(n+3){ border-top:1px solid var(--lx-line); }
}
@media (max-width:460px){
  .trust-grid{ grid-template-columns:1fr; }
  .trust-item::before{ display:none; }
  .trust-item + .trust-item{ border-top:1px solid var(--lx-line); }
}
{% endstylesheet %}

{% schema %}{"name":"Trust bar","settings":[]}{% endschema %}
