<section class="lx-tips" id="lx-tips-{{ section.id }}">

  <!-- Reading progress bar -->
  <div class="lx-tips-progress" id="lx-tips-progress-{{ section.id }}"></div>

  <!-- HERO -->
  <div class="lx-tips-hero">
    <div class="container">
      <div class="lx-tips-hero-inner">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h1>{{ section.settings.heading }}</h1>
        <p class="lx-tips-lead">{{ section.settings.subheading }}</p>
      </div>
    </div>
  </div>

  <!-- TIPS LIST (numbered, alternating) -->
  {% assign tip_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'tip' %}{% assign tip_count = tip_count | plus: 1 %}{% endif %}{% endfor %}

  {% if tip_count > 0 %}
    <div class="lx-tips-list">
      <div class="container">
        {% for block in section.blocks %}
          {% if block.type == 'tip' %}
            <article class="lx-tip{% cycle '', ' lx-tip--alt' %}" {{ block.shopify_attributes }}>
              <div class="lx-tip-text">
                <div class="lx-tip-num-row">
                  <span class="lx-tip-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="lx-tip-pill">{{ block.settings.eyebrow }}</span>
                </div>
                <h2>{{ block.settings.title }}</h2>
                <div class="lx-tip-body rte">{{ block.settings.body }}</div>

                {% if block.settings.show_link %}
                  <a href="{{ block.settings.link_url }}" class="lx-tip-link">
                    {{ block.settings.link_text | default: 'Learn more' }}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </a>
                {% endif %}
              </div>
              <div class="lx-tip-visual">
                <div class="lx-tip-icon-card">
                  <div class="lx-tip-icon"><i class="{{ block.settings.icon }}"></i></div>
                  {% if block.settings.stat_num != blank %}
                    <div class="lx-tip-stat">
                      <strong>{{ block.settings.stat_num }}</strong>
                      <span>{{ block.settings.stat_label }}</span>
                    </div>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <!-- QUICK WINS (compact grid of mini-tips) -->
  {% assign mini_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'mini' %}{% assign mini_count = mini_count | plus: 1 %}{% endif %}{% endfor %}

  {% if mini_count > 0 %}
    <div class="lx-tips-quick">
      <div class="container">
        <div class="lx-tips-section-head">
          <span class="lx-tips-mini-eyebrow">{{ section.settings.quick_eyebrow }}</span>
          <h2>{{ section.settings.quick_heading }}</h2>
          <p>{{ section.settings.quick_sub }}</p>
        </div>
        <div class="lx-tips-quick-grid">
          {% for block in section.blocks %}
            {% if block.type == 'mini' %}
              <div class="lx-tip-mini" {{ block.shopify_attributes }}>
                <div class="lx-tip-mini-icon"><i class="{{ block.settings.icon }}"></i></div>
                <strong>{{ block.settings.title }}</strong>
                <span>{{ block.settings.description }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- RECOMMENDED PRODUCTS -->
  {% assign prod_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'product_card' %}{% assign prod_count = prod_count | plus: 1 %}{% endif %}{% endfor %}

  {% if prod_count > 0 %}
    <div class="lx-tips-products">
      <div class="container">
        <div class="lx-tips-section-head">
          <span class="lx-tips-mini-eyebrow">{{ section.settings.prod_eyebrow }}</span>
          <h2>{{ section.settings.prod_heading }}</h2>
          <p>{{ section.settings.prod_sub }}</p>
        </div>
        <div class="lx-tips-products-grid">
          {% for block in section.blocks %}
            {% if block.type == 'product_card' %}
              <a href="{{ block.settings.link }}" class="lx-tip-product" {{ block.shopify_attributes }}>
                <div class="lx-tip-product-icon">
                  <i class="{{ block.settings.icon }}"></i>
                </div>
                <div class="lx-tip-product-body">
                  <span class="lx-tip-product-tag">{{ block.settings.tag }}</span>
                  <strong>{{ block.settings.title }}</strong>
                  <span class="lx-tip-product-desc">{{ block.settings.description }}</span>
                </div>
                <div class="lx-tip-product-arrow">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- CLOSING CTA -->
  {% if section.settings.show_closing %}
    <div class="lx-tips-closing">
      <div class="container">
        <div class="lx-tips-closing-card">
          {% if section.settings.closing_heading != blank %}<h2>{{ section.settings.closing_heading }}</h2>{% endif %}
          <p>{{ section.settings.closing_sub }}</p>
          <div class="lx-tips-closing-actions">
            <a href="{{ section.settings.closing_btn1_link }}" class="btn btn-primary">{{ section.settings.closing_btn1_text }}</a>
            <a href="{{ section.settings.closing_btn2_link }}" class="btn btn-ghost">{{ section.settings.closing_btn2_text }}</a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</section>

<script>
(function(){
  var section = document.getElementById('lx-tips-{{ section.id }}');
  if (!section) return;
  var bar = document.getElementById('lx-tips-progress-{{ section.id }}');
  if (bar) {
    window.addEventListener('scroll', function(){
      var rect = section.getBoundingClientRect();
      var winH = window.innerHeight;
      var total = section.offsetHeight - winH;
      var scrolled = Math.max(0, -rect.top);
      var pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
      bar.style.width = pct + '%';
    }, { passive: true });
  }
})();
</script>

{% stylesheet %}
.lx-tips{ font-family:var(--lx-body); }
.lx-tips-progress{ position:fixed; top:0; left:0; height:3px; background:var(--lx-blue); z-index:999; width:0; transition:width .1s linear; }
.lx-tips-hero{ padding-block:clamp(3.5rem,7vw,6rem); background:var(--lx-bg-soft); border-bottom:1px solid var(--lx-line); text-align:center; }
.lx-tips-hero-inner{ max-width:640px; margin-inline:auto; }
.lx-tips-hero-inner h1{ margin:.75rem 0 0; font-size:clamp(2rem,5vw,3.2rem); }
.lx-tips-lead{ color:var(--lx-muted); font-size:1.1rem; margin-top:.75rem; line-height:1.65; }
.lx-tips-list{ padding-block:clamp(2.5rem,5vw,4.5rem); }
.lx-tip{ display:grid; grid-template-columns:1fr 320px; gap:clamp(2rem,5vw,4rem); align-items:center; padding-block:clamp(2.5rem,5vw,4rem); border-bottom:1px solid var(--lx-line); }
.lx-tip--alt{ direction:rtl; }
.lx-tip--alt > *{ direction:ltr; }
.lx-tip-num-row{ display:flex; align-items:center; gap:.9rem; margin-bottom:1.1rem; }
.lx-tip-num{ font-family:var(--lx-display); font-size:2.2rem; font-weight:900; color:var(--lx-blue-100); line-height:1; }
.lx-tip-pill{ background:var(--lx-blue-050); color:var(--lx-blue-ink); font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; padding:.25rem .75rem; border-radius:var(--lx-pill); }
.lx-tip-text h2{ font-size:clamp(1.3rem,3vw,1.9rem); color:var(--lx-navy); margin:0 0 .9rem; }
.lx-tip-body.rte{ color:var(--lx-muted); line-height:1.75; }
.lx-tip-body.rte p{ margin-bottom:.9rem; }
.lx-tip-link{ display:inline-flex; align-items:center; gap:.45rem; margin-top:1rem; font-weight:600; font-size:.9rem; color:var(--lx-blue-ink); text-decoration:none; transition:gap var(--lx-dur); }
.lx-tip-link:hover{ gap:.7rem; }
.lx-tip-icon-card{ background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:2rem 1.5rem; text-align:center; box-shadow:var(--lx-sh); }
.lx-tip-icon{ font-size:3.5rem; color:var(--lx-blue); margin-bottom:1rem; }
.lx-tip-stat strong{ display:block; font-family:var(--lx-display); font-size:2rem; color:var(--lx-navy); line-height:1; }
.lx-tip-stat span{ font-size:.85rem; color:var(--lx-muted); display:block; margin-top:.3rem; }
.lx-tips-section-head{ text-align:center; margin-bottom:2.5rem; max-width:560px; margin-inline:auto; }
.lx-tips-mini-eyebrow{ text-transform:uppercase; letter-spacing:.14em; font-size:.78rem; font-weight:700; color:var(--lx-blue-ink); display:block; margin-bottom:.6rem; }
.lx-tips-section-head h2{ margin:.4rem 0 .6rem; }
.lx-tips-section-head p{ color:var(--lx-muted); }
.lx-tips-quick{ padding-block:clamp(3rem,6vw,5rem); background:var(--lx-bg-soft); }
.lx-tips-quick-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:1.1rem; }
.lx-tip-mini{ background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r); padding:1.25rem; transition:transform var(--lx-dur), box-shadow var(--lx-dur), border-color var(--lx-dur); }
.lx-tip-mini:hover{ transform:translateY(-3px); box-shadow:var(--lx-sh); border-color:transparent; }
.lx-tip-mini-icon{ width:40px; height:40px; background:var(--lx-blue-050); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:1.3rem; color:var(--lx-blue); margin-bottom:.9rem; }
.lx-tip-mini strong{ display:block; font-size:.9rem; color:var(--lx-navy); margin-bottom:.35rem; }
.lx-tip-mini span{ font-size:.82rem; color:var(--lx-muted); line-height:1.5; }
.lx-tips-products{ padding-block:clamp(3rem,6vw,5rem); }
.lx-tips-products-grid{ display:flex; flex-direction:column; gap:.75rem; max-width:680px; }
.lx-tip-product{ display:flex; align-items:center; gap:1.25rem; background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:1.25rem 1.5rem; text-decoration:none; color:inherit; transition:transform var(--lx-dur), box-shadow var(--lx-dur), border-color var(--lx-dur); }
.lx-tip-product:hover{ transform:translateX(4px); box-shadow:var(--lx-sh); border-color:var(--lx-blue); }
.lx-tip-product-icon{ width:44px; height:44px; background:var(--lx-blue-050); border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.4rem; color:var(--lx-blue); flex:none; }
.lx-tip-product-body{ flex:1; }
.lx-tip-product-tag{ display:block; font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--lx-blue-ink); margin-bottom:.25rem; }
.lx-tip-product-body strong{ display:block; color:var(--lx-navy); font-size:.95rem; }
.lx-tip-product-desc{ font-size:.82rem; color:var(--lx-muted); }
.lx-tip-product-arrow{ color:var(--lx-faint); flex:none; }
.lx-tips-closing{ padding-block:clamp(3rem,5vw,4.5rem); background:var(--lx-navy); }
.lx-tips-closing-card{ text-align:center; }
.lx-tips-closing-card h2{ color:#fff; margin:0 0 .75rem; }
.lx-tips-closing-card p{ color:rgba(255,255,255,.7); max-width:44ch; margin:0 auto 2rem; line-height:1.65; }
.lx-tips-closing-actions{ display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; }
@media(max-width:860px){ .lx-tip,.lx-tip--alt{ grid-template-columns:1fr; direction:ltr; } .lx-tip-visual{ order:-1; } }
@media(max-width:520px){ .lx-tips-quick-grid{ grid-template-columns:1fr 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Tips Page",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fertility tips" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Simple changes that make a difference" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Evidence-based lifestyle tips that can measurably improve fertility outcomes for couples trying to conceive." },

    { "type": "header", "content": "Quick wins grid" },
    { "type": "text", "id": "quick_eyebrow", "label": "Eyebrow", "default": "Quick wins" },
    { "type": "text", "id": "quick_heading", "label": "Heading", "default": "Daily habits that help" },
    { "type": "textarea", "id": "quick_sub", "label": "Sub-text", "default": "Small, consistent changes add up. Here's what to focus on every day." },

    { "type": "header", "content": "Recommended products" },
    { "type": "text", "id": "prod_eyebrow", "label": "Eyebrow", "default": "Science-backed support" },
    { "type": "text", "id": "prod_heading", "label": "Heading", "default": "If you need more than lifestyle changes" },
    { "type": "textarea", "id": "prod_sub", "label": "Sub-text", "default": "Where the science supports it, our clinically-validated products can complement lifestyle changes." },

    { "type": "header", "content": "Closing CTA" },
    { "type": "checkbox", "id": "show_closing", "label": "Show closing CTA", "default": true },
    { "type": "text", "id": "closing_heading", "label": "Heading", "default": "Ready for the next step?" },
    { "type": "textarea", "id": "closing_sub", "label": "Sub-text", "default": "Our specialists can guide you through your options, whether that's lifestyle, testing, or treatment." },
    { "type": "text", "id": "closing_btn1_text", "label": "Primary button", "default": "Speak to a specialist" },
    { "type": "text", "id": "closing_btn1_link", "label": "Primary button link", "default": "/pages/contact" },
    { "type": "text", "id": "closing_btn2_text", "label": "Secondary button", "default": "Browse products" },
    { "type": "text", "id": "closing_btn2_link", "label": "Secondary button link", "default": "/pages/shop" }
  ],
  "blocks": [
    {
      "type": "tip",
      "name": "Main tip",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Pill text", "default": "Lifestyle" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "text", "id": "icon", "label": "Icon (Phosphor)", "default": "ph ph-heart" },
        { "type": "text", "id": "stat_num", "label": "Stat number (optional)" },
        { "type": "text", "id": "stat_label", "label": "Stat label (optional)" },
        { "type": "checkbox", "id": "show_link", "label": "Show link", "default": false },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "Learn more" },
        { "type": "text", "id": "link_url", "label": "Link URL" }
      ]
    },
    {
      "type": "mini",
      "name": "Quick win (mini)",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "ph ph-check-circle" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    },
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "ph ph-package" },
        { "type": "text", "id": "tag", "label": "Tag" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "link", "label": "Link URL" }
      ]
    }
  ],
  "presets": [{ "name": "Tips Page" }]
}
{% endschema %}
