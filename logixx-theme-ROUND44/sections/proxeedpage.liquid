<section class="lx-pxd lx-pxd--{{ section.settings.theme }}" id="lx-pxd-{{ section.id }}">

  <!-- Background swimmers -->
  <div class="lx-pxd-swimmers" aria-hidden="true">
    {% for i in (1..30) %}
      <svg class="lx-swimmer" viewBox="0 0 60 12">
        <ellipse cx="6" cy="6" rx="5" ry="4"/>
        <line x1="11" y1="6" x2="58" y2="6" stroke-width="0.8" opacity="0.6"/>
      </svg>
    {% endfor %}
  </div>

  <!-- HERO -->
  <div class="lx-pxd-hero">
    <div class="container">
      <div class="lx-pxd-hero-grid">
        <div class="lx-pxd-hero-text">
          <div class="lx-pxd-eyebrow-row">
            <span class="lx-pxd-eyebrow">{{ section.settings.eyebrow }}</span>
            {% if section.settings.badge != blank %}
              <span class="lx-pxd-badge">{{ section.settings.badge }}</span>
            {% endif %}
          </div>
          <h1>{{ section.settings.heading }}</h1>
          <p class="lx-pxd-lead">{{ section.settings.subheading }}</p>

          {% if section.settings.show_tags %}
            <div class="lx-pxd-tags">
              {% if section.settings.tag_1 != blank %}<span class="lx-pxd-tag"><i class="ph ph-check-circle"></i>{{ section.settings.tag_1 }}</span>{% endif %}
              {% if section.settings.tag_2 != blank %}<span class="lx-pxd-tag"><i class="ph ph-check-circle"></i>{{ section.settings.tag_2 }}</span>{% endif %}
              {% if section.settings.tag_3 != blank %}<span class="lx-pxd-tag"><i class="ph ph-check-circle"></i>{{ section.settings.tag_3 }}</span>{% endif %}
              {% if section.settings.tag_4 != blank %}<span class="lx-pxd-tag"><i class="ph ph-check-circle"></i>{{ section.settings.tag_4 }}</span>{% endif %}
            </div>
          {% endif %}

          <div class="lx-pxd-actions">
            <a href="{{ section.settings.cta_link }}" class="lx-pxd-btn lx-pxd-btn--primary">
              {{ section.settings.cta_text }}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="{{ section.settings.cta2_link }}" class="lx-pxd-btn lx-pxd-btn--ghost">{{ section.settings.cta2_text }}</a>
          </div>
        </div>
        <div class="lx-pxd-hero-visual">
          {% if section.settings.hero_image != blank %}
            <img src="{{ section.settings.hero_image | image_url: width: 1200 }}" alt="{{ section.settings.heading }}">
          {% else %}
            <div class="lx-pxd-hero-placeholder">
              <i class="ph ph-package"></i>
              <span>Add product image</span>
            </div>
          {% endif %}

          {% if section.settings.show_float %}
            <div class="lx-pxd-float-card">
              <div class="lx-pxd-float-icon"><i class="{{ section.settings.float_icon }}"></i></div>
              <div>
                <strong>{{ section.settings.float_title }}</strong>
                <span>{{ section.settings.float_sub }}</span>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      {% if section.settings.show_stats %}
        <div class="lx-pxd-stats">
          <div class="lx-pxd-stat"><strong>{{ section.settings.stat_1_num }}</strong><span>{{ section.settings.stat_1_label }}</span></div>
          <div class="lx-pxd-stat"><strong>{{ section.settings.stat_2_num }}</strong><span>{{ section.settings.stat_2_label }}</span></div>
          <div class="lx-pxd-stat"><strong>{{ section.settings.stat_3_num }}</strong><span>{{ section.settings.stat_3_label }}</span></div>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- SAFE SIMPLE PROVEN — animated brand band -->
  {% if section.settings.show_ssp %}
    {%- assign ssp1 = section.settings.ssp_word1 | default: 'Safe.' -%}
    {%- assign ssp2 = section.settings.ssp_word2 | default: 'Simple.' -%}
    {%- assign ssp3 = section.settings.ssp_word3 | default: 'Proven.' -%}
    <div class="lx-ssp" aria-label="{{ ssp1 }} {{ ssp2 }} {{ ssp3 }}">
      <svg class="lx-ssp-swirl" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <radialGradient id="ssp-core-{{ section.id }}" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9"/>
            <stop offset="42%" stop-color="#ffffff" stop-opacity="0.6"/>
            <stop offset="72%" stop-color="#eef1f8" stop-opacity="0.14"/>
            <stop offset="100%" stop-color="#eef1f8" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="ssp-ribA-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="10%"><stop offset="0%" stop-color="#c7d0e3" stop-opacity="0"/><stop offset="22%" stop-color="#c7d0e3" stop-opacity="0.9"/><stop offset="60%" stop-color="#aab8d6" stop-opacity="0.95"/><stop offset="100%" stop-color="#aab8d6" stop-opacity="0"/></linearGradient>
          <linearGradient id="ssp-ribB-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="20%"><stop offset="0%" stop-color="#d6dded" stop-opacity="0"/><stop offset="30%" stop-color="#cfd7ea" stop-opacity="0.85"/><stop offset="70%" stop-color="#b6c1dc" stop-opacity="0.9"/><stop offset="100%" stop-color="#b6c1dc" stop-opacity="0"/></linearGradient>
          <linearGradient id="ssp-ribC-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#9aa9cd" stop-opacity="0"/><stop offset="35%" stop-color="#94a4ca" stop-opacity="0.85"/><stop offset="65%" stop-color="#8294c0" stop-opacity="0.9"/><stop offset="100%" stop-color="#8294c0" stop-opacity="0"/></linearGradient>
          <linearGradient id="ssp-ribO-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="15%"><stop offset="0%" stop-color="#f6cd9c" stop-opacity="0"/><stop offset="28%" stop-color="#f4c089" stop-opacity="0.8"/><stop offset="66%" stop-color="#efa863" stop-opacity="0.85"/><stop offset="100%" stop-color="#efa863" stop-opacity="0"/></linearGradient>
          <linearGradient id="ssp-ribO2-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#f3b878" stop-opacity="0"/><stop offset="35%" stop-color="#f0a85a" stop-opacity="0.78"/><stop offset="65%" stop-color="#ec9842" stop-opacity="0.82"/><stop offset="100%" stop-color="#ec9842" stop-opacity="0"/></linearGradient>
          <filter id="ssp-s6-{{ section.id }}" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="5"/></filter>
          <filter id="ssp-s10-{{ section.id }}" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="9"/></filter>
          <filter id="ssp-s16-{{ section.id }}" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="15"/></filter>
        </defs>
        <g class="lx-ssp-vortex"><g class="lx-ssp-rings"></g></g>
        <ellipse class="lx-ssp-core" cx="960" cy="540" rx="230" ry="210" fill="url(#ssp-core-{{ section.id }})"></ellipse>
      </svg>
      <div class="lx-ssp-particles" aria-hidden="true"></div>
      <div class="lx-ssp-lockup">
        <span class="lx-ssp-word">{{ ssp1 }}</span>
        <span class="lx-ssp-word">{{ ssp2 }}</span>
        <span class="lx-ssp-word">{{ ssp3 }}</span>
      </div>
    </div>
  {% endif %}

  <!-- KEY INGREDIENTS PILLARS -->
  {% if section.settings.show_pillars %}
    <div class="lx-pxd-pillars">
      <div class="container">
        <div class="lx-pxd-section-head">
          <span class="lx-pxd-mini-eyebrow">{{ section.settings.pillars_eyebrow }}</span>
          <h2>{{ section.settings.pillars_heading }}</h2>
          <p>{{ section.settings.pillars_sub }}</p>
        </div>
        <div class="lx-pxd-pillars-grid">
          {% for block in section.blocks %}
            {% if block.type == 'pillar' %}
              <div class="lx-pxd-pillar" {{ block.shopify_attributes }}>
                <div class="lx-pxd-pillar-icon"><i class="{{ block.settings.icon }}"></i></div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.description }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- INGREDIENT BREAKDOWN (alternating) -->
  {% assign ing_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'ingredient' %}{% assign ing_count = ing_count | plus: 1 %}{% endif %}{% endfor %}
  {% if ing_count > 0 %}
    <div class="lx-pxd-ingredients">
      <div class="container">
        <div class="lx-pxd-section-head">
          <span class="lx-pxd-mini-eyebrow">{{ section.settings.ing_eyebrow }}</span>
          <h2>{{ section.settings.ing_heading }}</h2>
        </div>
        {% for block in section.blocks %}
          {% if block.type == 'ingredient' %}
            <article class="lx-pxd-ing{% cycle '', ' lx-pxd-ing--alt' %}" {{ block.shopify_attributes }}>
              <div class="lx-pxd-ing-text">
                <div class="lx-pxd-ing-name-row">
                  <span class="lx-pxd-ing-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <h3>{{ block.settings.name }}</h3>
                </div>
                {% if block.settings.tag != blank %}<span class="lx-pxd-ing-tag">{{ block.settings.tag }}</span>{% endif %}
                <div class="lx-pxd-ing-body rte">{{ block.settings.body }}</div>
                {% if block.settings.fact != blank %}
                  <div class="lx-pxd-ing-fact">
                    <i class="ph ph-info"></i>
                    <span>{{ block.settings.fact }}</span>
                  </div>
                {% endif %}
              </div>
              <div class="lx-pxd-ing-visual">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.name }}">
                {% else %}
                  <div class="lx-pxd-ing-placeholder">
                    <i class="{{ block.settings.icon | default: 'ph ph-flask' }}"></i>
                  </div>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <!-- HOW TO TAKE — editorial 3-step -->
  {% if section.settings.show_howto %}
    <div class="lx-pxd-howto">
      <div class="container">
        <div class="lx-pxd-section-head">
          <span class="lx-pxd-mini-eyebrow">{{ section.settings.howto_eyebrow }}</span>
          <h2>{{ section.settings.howto_heading }}</h2>
          <p>{{ section.settings.howto_sub }}</p>
        </div>

        <div class="lx-pxd-howto-flow">
          <div class="lx-pxd-howto-step">
            <div class="lx-pxd-howto-step-icon"><i class="ph-fill ph-package"></i></div>
            <span class="lx-pxd-howto-step-num">01</span>
            <strong class="lx-pxd-howto-step-title">{{ section.settings.step1_title }}</strong>
            <span class="lx-pxd-howto-step-sub">{{ section.settings.step1_sub }}</span>
          </div>

          <div class="lx-pxd-howto-arrow">
            <svg width="32" height="16" viewBox="0 0 32 16" fill="none"><path d="M1 8h28m0 0l-6-6m6 6l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>

          <div class="lx-pxd-howto-step">
            <div class="lx-pxd-howto-step-icon"><i class="ph-fill ph-drop"></i></div>
            <span class="lx-pxd-howto-step-num">02</span>
            <strong class="lx-pxd-howto-step-title">{{ section.settings.step2_title }}</strong>
            <span class="lx-pxd-howto-step-sub">{{ section.settings.step2_sub }}</span>
          </div>

          <div class="lx-pxd-howto-arrow">
            <svg width="32" height="16" viewBox="0 0 32 16" fill="none"><path d="M1 8h28m0 0l-6-6m6 6l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>

          <div class="lx-pxd-howto-step lx-pxd-howto-step--final">
            <div class="lx-pxd-howto-step-icon lx-pxd-howto-step-icon--accent"><i class="ph-fill ph-fork-knife"></i></div>
            <span class="lx-pxd-howto-step-num">03</span>
            <strong class="lx-pxd-howto-step-title">{{ section.settings.step3_title }}</strong>
            <span class="lx-pxd-howto-step-sub">{{ section.settings.step3_sub }}</span>
          </div>
        </div>

        <div class="lx-pxd-cycle-band">
          <div class="lx-pxd-cycle-text">
            <span class="lx-pxd-cycle-label">{{ section.settings.cycle_label }}</span>
            <strong class="lx-pxd-cycle-formula">{{ section.settings.cycle_formula }}</strong>
          </div>
          <div class="lx-pxd-cycle-arrow">
            <svg width="32" height="16" viewBox="0 0 32 16" fill="none"><path d="M1 8h28m0 0l-6-6m6 6l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="lx-pxd-cycle-result">
            <strong>{{ section.settings.cycle_result }}</strong>
            <span>{{ section.settings.cycle_result_label }}</span>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- BENEFITS GRID -->
  {% assign benefit_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'benefit' %}{% assign benefit_count = benefit_count | plus: 1 %}{% endif %}{% endfor %}
  {% if benefit_count > 0 %}
    <div class="lx-pxd-benefits">
      <div class="container">
        <div class="lx-pxd-section-head">
          <span class="lx-pxd-mini-eyebrow">{{ section.settings.benefits_eyebrow }}</span>
          <h2>{{ section.settings.benefits_heading }}</h2>
        </div>
        <div class="lx-pxd-benefits-grid">
          {% for block in section.blocks %}
            {% if block.type == 'benefit' %}
              <div class="lx-pxd-benefit-card" {{ block.shopify_attributes }}>
                <div class="lx-pxd-benefit-icon"><i class="{{ block.settings.icon }}"></i></div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.description }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- COMPARE-TO callout (small, links to range page) -->
  {% if section.settings.show_compare_callout %}
    <div class="lx-pxd-compare-callout">
      <div class="container">
        <div class="lx-pxd-callout-card">
          <div class="lx-pxd-callout-icon"><i class="ph ph-arrows-left-right"></i></div>
          <div class="lx-pxd-callout-text">
            <strong>{{ section.settings.callout_title }}</strong>
            <span>{{ section.settings.callout_sub }}</span>
          </div>
          <a href="{{ section.settings.callout_link }}" class="lx-pxd-btn lx-pxd-btn--primary lx-pxd-callout-btn">
            {{ section.settings.callout_btn }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- FAQ -->
  {% assign faq_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'faq' %}{% assign faq_count = faq_count | plus: 1 %}{% endif %}{% endfor %}
  {% if faq_count > 0 %}
    <div class="lx-pxd-faq">
      <div class="container">
        <div class="lx-pxd-section-head">
          <span class="lx-pxd-mini-eyebrow">{{ section.settings.faq_eyebrow }}</span>
          <h2>{{ section.settings.faq_heading }}</h2>
        </div>
        <div class="lx-pxd-faq-list">
          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              <details class="lx-pxd-faq-item" {{ block.shopify_attributes }}>
                <summary class="lx-pxd-faq-q">
                  <span>{{ block.settings.question }}</span>
                  <i class="ph ph-plus lx-pxd-faq-icon"></i>
                </summary>
                <div class="lx-pxd-faq-a rte">{{ block.settings.answer }}</div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- CLOSING CTA -->
  {% if section.settings.show_closing %}
    <div class="lx-pxd-closing">
      <div class="container">
        <div class="lx-pxd-closing-card">
          {% if section.settings.closing_heading != blank %}<h2>{{ section.settings.closing_heading }}</h2>{% endif %}
          <p>{{ section.settings.closing_sub }}</p>
          <div class="lx-pxd-closing-actions">
            <a href="{{ section.settings.closing_btn1_link }}" class="lx-pxd-btn lx-pxd-btn--white">{{ section.settings.closing_btn1_text }}</a>
            <a href="{{ section.settings.closing_btn2_link }}" class="lx-pxd-btn lx-pxd-btn--outline-white">{{ section.settings.closing_btn2_text }}</a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</section>

<script>
(function(){
  var section = document.getElementById('lx-pxd-{{ section.id }}');
  if (!section) return;
  var faqs = section.querySelectorAll('.lx-pxd-faq-item');
  faqs.forEach(function(faq){
    faq.addEventListener('toggle', function(){
      if (faq.open) faqs.forEach(function(o){ if (o !== faq) o.open = false; });
    });
  });

  // ---- Safe Simple Proven swirl + particles ----
  var ssp = section.querySelector('.lx-ssp');
  if (ssp && ssp.dataset.built !== '1') {
    ssp.dataset.built = '1';
    var SVGNS = "http://www.w3.org/2000/svg", CX = 960, CY = 540;
    var sid = "{{ section.id }}";
    function rnd(a,b){ return a + Math.random()*(b-a); }
    var ringsG = ssp.querySelector('.lx-ssp-rings');
    var pField = ssp.querySelector('.lx-ssp-particles');
    if (ringsG) {
      var rings = [
        [442,0.86,8,0.70,58,"ssp-ribB","ssp-s16",0.20,34,false],
        [410,0.90,74,0.62,64,"ssp-ribO","ssp-s16",0.24,28,true],
        [388,0.83,142,0.74,46,"ssp-ribB","ssp-s10",0.22,38,false],
        [352,0.92,210,0.58,70,"ssp-ribA","ssp-s10",0.30,24,true],
        [330,0.80,28,0.66,40,"ssp-ribO2","ssp-s10",0.26,42,false],
        [300,0.95,118,0.60,56,"ssp-ribB","ssp-s6",0.32,20,true],
        [274,0.84,196,0.72,34,"ssp-ribA","ssp-s6",0.30,36,false],
        [246,0.90,52,0.55,44,"ssp-ribO","ssp-s6",0.28,18,true],
        [214,0.88,150,0.64,28,"ssp-ribC","ssp-s6",0.26,30,false],
        [184,0.93,244,0.58,34,"ssp-ribA","ssp-s6",0.30,22,true],
        [150,0.86,96,0.62,22,"ssp-ribO2","ssp-s6",0.26,26,false]
      ];
      rings.forEach(function(r){
        var radius=r[0],ry=r[1],rot=r[2],onFrac=r[3],sw=r[4],grad=r[5]+"-"+sid,blur=r[6]+"-"+sid,op=r[7],dur=r[8],rev=r[9];
        var g=document.createElementNS(SVGNS,"g");
        g.setAttribute("class","lx-ssp-ring"+(rev?" rev":""));
        g.style.animationDuration=dur+"s";
        g.style.animationDelay=(-Math.random()*dur).toFixed(1)+"s";
        var c=document.createElementNS(SVGNS,"circle");
        c.setAttribute("cx",CX); c.setAttribute("cy",CY); c.setAttribute("r",radius);
        c.setAttribute("fill","none"); c.setAttribute("stroke","url(#"+grad+")");
        c.setAttribute("stroke-width",sw); c.setAttribute("stroke-linecap","round");
        var circ=2*Math.PI*radius, on=circ*onFrac;
        c.setAttribute("stroke-dasharray",on.toFixed(1)+" "+(circ-on).toFixed(1));
        c.setAttribute("transform","rotate("+rot+" "+CX+" "+CY+") translate("+CX+" "+CY+") scale(1 "+ry+") translate("+(-CX)+" "+(-CY)+")");
        c.setAttribute("filter","url(#"+blur+")"); c.setAttribute("opacity",op);
        g.appendChild(c); ringsG.appendChild(g);
      });
    }
    if (pField) {
      var palette=["#27408a","#5566a3","#5566a3","#8a97bf","#8a97bf","#8a97bf","#9cc3e6","#9cc3e6","#9cc3e6","#c3d8f0","#c3d8f0","#ef8a2a","#ef8a2a","#ef8a2a","#f4b063","#f4b063"];
      var frag=document.createDocumentFragment();
      for(var i=0;i<120;i++){
        var d=document.createElement("div"); d.className="lx-ssp-dot";
        var x,y,ang=rnd(0,Math.PI*2),rr=rnd(0,1);
        if(rr<0.62){var rad=rnd(170,540); x=960+Math.cos(ang)*rad*1.02; y=540+Math.sin(ang)*rad*0.92;}
        else{x=rnd(40,1880); y=rnd(40,1040);}
        x+=rnd(-26,26); y+=rnd(-26,26);
        if(x<6||x>1914||y<6||y>1074){i--;continue;}
        var size=rnd(1.6,4.4),dim=Math.min(1,Math.hypot(x-960,y-540)/360);
        d.style.left=(x/1920*100).toFixed(2)+"%"; d.style.top=(y/1080*100).toFixed(2)+"%";
        d.style.width=size.toFixed(1)+"px"; d.style.height=size.toFixed(1)+"px";
        d.style.background=palette[(Math.random()*palette.length)|0];
        var oHi=rnd(0.45,0.95)*(0.4+0.6*dim);
        d.style.setProperty("--o-hi",oHi.toFixed(2));
        d.style.setProperty("--o-lo",(oHi*rnd(0.18,0.4)).toFixed(2));
        d.style.setProperty("--tw",rnd(2.6,6.5).toFixed(2)+"s");
        d.style.setProperty("--twd",(-rnd(0,6)).toFixed(2)+"s");
        d.style.setProperty("--dx",rnd(-50,50).toFixed(1)+"px");
        d.style.setProperty("--dy",rnd(-55,45).toFixed(1)+"px");
        d.style.setProperty("--dr",rnd(8,17).toFixed(1)+"s");
        d.style.setProperty("--drd",(-rnd(0,16)).toFixed(2)+"s");
        frag.appendChild(d);
      }
      pField.appendChild(frag);
    }
  }
})();
</script>

{% stylesheet %}
/* ============================================================
   PROXEED PRODUCT PAGE  —  scoped to .lx-pxd
   All classes here are unique to this section.
   DO NOT restyle .container, .btn*, .eyebrow, .card, etc.
   ============================================================ */

/* ── Root section ── */
.lx-pxd {
  position: relative;
  overflow: hidden;
  background: var(--lx-bg);
  color: var(--lx-ink);
  font-family: var(--lx-body);
}

/* ── Theme accent tokens ── */
.lx-pxd--plus  { --pxd-accent: var(--lx-orange);   --pxd-accent-soft: #FFF0E6; --pxd-accent-mid: #E8833A; }
.lx-pxd--men   { --pxd-accent: var(--lx-green);    --pxd-accent-soft: #E8F5EF; --pxd-accent-mid: #267A56; }
.lx-pxd--women { --pxd-accent: var(--lx-pink);     --pxd-accent-soft: #FDEEF5; --pxd-accent-mid: #B23A7C; }

/* ── Background swimmers ── */
.lx-pxd-swimmers {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}
.lx-swimmer {
  position: absolute;
  width: clamp(36px, 4vw, 60px);
  height: auto;
  opacity: 0;
  fill: var(--pxd-accent, var(--lx-blue));
  stroke: var(--pxd-accent, var(--lx-blue));
  animation: pxd-swim linear infinite;
}
/* Scatter swimmers pseudo-randomly using nth-child offsets */
.lx-swimmer:nth-child(odd)  { animation-duration: calc(18s + 1s * var(--n, 0)); }
.lx-swimmer:nth-child(even) { animation-duration: calc(22s + 1s * var(--n, 0)); }
{% for i in (1..30) %}
.lx-swimmer:nth-child({{ i }}) {
  top: {{ i | times: 3 | modulo: 97 }}%;
  left: -8%;
  animation-delay: calc(-{{ i | times: 0.7 }}s);
  transform: scaleY({{ i | modulo: 3 | plus: 1 | times: 0.3 | plus: 0.4 }});
  opacity: 0;
}
{% endfor %}
@keyframes pxd-swim {
  0%   { left: -8%;  opacity: 0; }
  5%   { opacity: 0.18; }
  90%  { opacity: 0.12; }
  100% { left: 108%; opacity: 0; }
}

/* ──────────────────────────────────────────
   HERO
   ────────────────────────────────────────── */
.lx-pxd-hero {
  position: relative;
  z-index: 1;
  padding: clamp(4rem, 9vw, 7.5rem) 0 clamp(2.5rem, 5vw, 4rem);
  background: linear-gradient(160deg, var(--lx-bg) 55%, var(--lx-bg-soft) 100%);
}

.lx-pxd-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}

/* Hero text */
.lx-pxd-hero-text {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.lx-pxd-eyebrow-row {
  display: flex;
  align-items: center;
  gap: .75rem;
  flex-wrap: wrap;
}

.lx-pxd-eyebrow {
  font-family: var(--lx-body);
  font-size: .75rem;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--lx-blue-ink);
}

.lx-pxd-badge {
  display: inline-flex;
  align-items: center;
  padding: .2em .75em;
  background: var(--pxd-accent, var(--lx-orange));
  color: #fff;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  border-radius: var(--lx-pill);
  line-height: 1.6;
}

.lx-pxd-hero-text h1 {
  margin: 0;
  font-family: var(--lx-display);
  font-size: clamp(2.6rem, 5.5vw, 4.2rem);
  font-weight: 800;
  color: var(--lx-navy);
  line-height: 1.08;
  letter-spacing: -.02em;
}

.lx-pxd-lead {
  font-size: clamp(1rem, 1.5vw, 1.15rem);
  color: var(--lx-muted);
  line-height: 1.65;
  max-width: 52ch;
  margin: 0;
}

/* Feature tags */
.lx-pxd-tags {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
}

.lx-pxd-tag {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  padding: .35em .85em;
  background: var(--lx-blue-050);
  color: var(--lx-blue-ink);
  border: 1px solid var(--lx-blue-100);
  border-radius: var(--lx-pill);
  font-size: .8rem;
  font-weight: 500;
  line-height: 1.4;
}

.lx-pxd-tag i {
  color: var(--lx-blue);
  font-size: .9em;
}

/* CTA buttons */
.lx-pxd-actions {
  display: flex;
  flex-wrap: wrap;
  gap: .75rem;
  align-items: center;
}

.lx-pxd-btn {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  padding: .72em 1.6em;
  border-radius: var(--lx-pill);
  font-family: var(--lx-body);
  font-size: .9rem;
  font-weight: 600;
  line-height: 1.3;
  text-decoration: none;
  border: 2px solid transparent;
  cursor: pointer;
  transition: transform var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease),
              background var(--lx-dur) var(--lx-ease),
              border-color var(--lx-dur) var(--lx-ease);
}

.lx-pxd-btn--primary {
  background: var(--pxd-accent, var(--lx-blue));
  color: #fff;
  border-color: var(--pxd-accent, var(--lx-blue));
  box-shadow: 0 4px 16px color-mix(in srgb, var(--pxd-accent, var(--lx-blue)) 30%, transparent);
}
.lx-pxd-btn--primary:hover,
.lx-pxd-btn--primary:focus-visible {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px color-mix(in srgb, var(--pxd-accent, var(--lx-blue)) 40%, transparent);
  background: var(--pxd-accent-mid, var(--lx-blue-600));
  border-color: var(--pxd-accent-mid, var(--lx-blue-600));
}

.lx-pxd-btn--ghost {
  background: transparent;
  color: var(--lx-navy);
  border-color: var(--lx-line-strong);
}
.lx-pxd-btn--ghost:hover,
.lx-pxd-btn--ghost:focus-visible {
  transform: translateY(-2px);
  border-color: var(--lx-blue);
  color: var(--lx-blue-ink);
  box-shadow: var(--lx-sh-sm);
}

.lx-pxd-btn--white {
  background: #fff;
  color: var(--lx-navy);
  border-color: #fff;
}
.lx-pxd-btn--white:hover,
.lx-pxd-btn--white:focus-visible {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0,0,0,.15);
}

.lx-pxd-btn--outline-white {
  background: transparent;
  color: #fff;
  border-color: rgba(255,255,255,.6);
}
.lx-pxd-btn--outline-white:hover,
.lx-pxd-btn--outline-white:focus-visible {
  transform: translateY(-2px);
  border-color: #fff;
  background: rgba(255,255,255,.1);
}

/* Hero visual */
.lx-pxd-hero-visual {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.lx-pxd-hero-visual img {
  width: 100%;
  max-width: 560px;
  height: auto;
  border-radius: var(--lx-r-lg);
  object-fit: cover;
  box-shadow: var(--lx-sh-lg);
}

.lx-pxd-hero-placeholder {
  width: 100%;
  max-width: 440px;
  aspect-ratio: 4/5;
  background: var(--lx-bg-alt);
  border: 2px dashed var(--lx-line-strong);
  border-radius: var(--lx-r-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: .75rem;
  color: var(--lx-faint);
}

.lx-pxd-hero-placeholder i {
  font-size: 3rem;
}

.lx-pxd-hero-placeholder span {
  font-size: .875rem;
  font-weight: 500;
}

/* Floating trust badge */
.lx-pxd-float-card {
  position: absolute;
  bottom: -1.5rem;
  left: -1.5rem;
  display: flex;
  align-items: center;
  gap: .75rem;
  padding: .9rem 1.25rem;
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r);
  box-shadow: var(--lx-sh);
  min-width: 200px;
  animation: pxd-float-bob 4s ease-in-out infinite;
}

.lx-pxd-float-icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--pxd-accent-soft, var(--lx-blue-050));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  color: var(--pxd-accent, var(--lx-blue));
}

.lx-pxd-float-card strong {
  display: block;
  font-size: .85rem;
  font-weight: 700;
  color: var(--lx-navy);
  line-height: 1.25;
}

.lx-pxd-float-card span {
  display: block;
  font-size: .75rem;
  color: var(--lx-muted);
}

@keyframes pxd-float-bob {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-6px); }
}

/* Stats bar below hero */
.lx-pxd-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  margin-top: clamp(2.5rem, 5vw, 4rem);
  background: var(--lx-line);
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r);
  overflow: hidden;
}

.lx-pxd-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 1.4rem 1rem;
  background: #fff;
  text-align: center;
  gap: .25rem;
}

.lx-pxd-stat strong {
  font-family: var(--lx-display);
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  font-weight: 800;
  color: var(--pxd-accent, var(--lx-blue));
  line-height: 1;
}

.lx-pxd-stat span {
  font-size: .8rem;
  color: var(--lx-muted);
  font-weight: 500;
  letter-spacing: .04em;
}

/* ──────────────────────────────────────────
   SAFE · SIMPLE · PROVEN BAND
   ────────────────────────────────────────── */
.lx-ssp {
  position: relative;
  overflow: hidden;
  z-index: 1;
  background: linear-gradient(135deg, #0b1e2e 0%, #0d2d43 50%, #0a1e30 100%);
  min-height: clamp(340px, 45vw, 560px);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lx-ssp-swirl {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lx-ssp-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.lx-ssp-dot {
  position: absolute;
  border-radius: 50%;
  opacity: var(--o-lo, .12);
  animation:
    pxd-dot-twinkle var(--tw, 4s) var(--twd, 0s) ease-in-out infinite alternate,
    pxd-dot-drift   var(--dr, 12s) var(--drd, 0s) ease-in-out infinite alternate;
}

@keyframes pxd-dot-twinkle {
  0%   { opacity: var(--o-lo, .1); }
  100% { opacity: var(--o-hi, .7); }
}

@keyframes pxd-dot-drift {
  0%   { translate: 0 0; }
  100% { translate: var(--dx, 30px) var(--dy, -25px); }
}

.lx-ssp-rings {
  /* container for JS-generated ring elements */
}

.lx-ssp-ring {
  transform-origin: 960px 540px;
  animation: pxd-ring-spin 34s linear infinite;
}

.lx-ssp-ring.rev {
  animation-direction: reverse;
}

@keyframes pxd-ring-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.lx-ssp-lockup {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: clamp(1rem, 3vw, 2.5rem);
  padding: 2rem;
  text-align: center;
}

.lx-ssp-word {
  font-family: var(--lx-display);
  font-size: clamp(2.4rem, 7vw, 6rem);
  font-weight: 900;
  color: #fff;
  letter-spacing: -.02em;
  line-height: 1;
  text-shadow: 0 2px 24px rgba(0,0,0,.3);
  animation: pxd-ssp-fadein .8s var(--lx-ease) both;
}

.lx-ssp-word:nth-child(2) { animation-delay: .15s; }
.lx-ssp-word:nth-child(3) { animation-delay: .3s; }

@keyframes pxd-ssp-fadein {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ──────────────────────────────────────────
   SHARED SECTION HEADER  (unique to this page)
   ────────────────────────────────────────── */
.lx-pxd-section-head {
  text-align: center;
  max-width: 700px;
  margin: 0 auto clamp(2.5rem, 5vw, 4rem);
}

.lx-pxd-section-head h2 {
  font-family: var(--lx-display);
  font-size: clamp(1.75rem, 3.5vw, 2.6rem);
  font-weight: 800;
  color: var(--lx-navy);
  margin: .5rem 0 .75rem;
  line-height: 1.15;
}

.lx-pxd-section-head p {
  font-size: clamp(.9rem, 1.4vw, 1.05rem);
  color: var(--lx-muted);
  line-height: 1.65;
  margin: 0;
}

.lx-pxd-mini-eyebrow {
  display: inline-block;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--lx-blue-ink);
}

/* ──────────────────────────────────────────
   KEY PILLARS
   ────────────────────────────────────────── */
.lx-pxd-pillars {
  position: relative;
  z-index: 1;
  padding: clamp(3.5rem, 7vw, 6.5rem) 0;
  background: var(--lx-bg-soft);
}

.lx-pxd-pillars-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
}

.lx-pxd-pillar {
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r-lg);
  padding: 2rem 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  transition: transform var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease),
              border-color var(--lx-dur) var(--lx-ease);
}

.lx-pxd-pillar:hover {
  transform: translateY(-4px);
  box-shadow: var(--lx-sh-lg);
  border-color: transparent;
}

.lx-pxd-pillar-icon {
  width: 52px;
  height: 52px;
  border-radius: 15px;
  background: var(--lx-blue-050);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  color: var(--lx-blue);
  flex-shrink: 0;
}

.lx-pxd-pillar h3 {
  font-family: var(--lx-display);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--lx-navy);
  margin: 0;
  line-height: 1.25;
}

.lx-pxd-pillar p {
  font-size: .9rem;
  color: var(--lx-muted);
  line-height: 1.6;
  margin: 0;
}

/* ──────────────────────────────────────────
   INGREDIENT BREAKDOWN  (alternating rows)
   ────────────────────────────────────────── */
.lx-pxd-ingredients {
  position: relative;
  z-index: 1;
  padding: clamp(3.5rem, 7vw, 6.5rem) 0;
  background: var(--lx-bg);
}

.lx-pxd-ing {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2rem, 5vw, 4.5rem);
  align-items: center;
  padding: clamp(2rem, 4vw, 3.5rem) 0;
  border-bottom: 1px solid var(--lx-line);
}

.lx-pxd-ing:last-child {
  border-bottom: none;
}

.lx-pxd-ing--alt {
  direction: rtl;
}
.lx-pxd-ing--alt > * {
  direction: ltr;
}

.lx-pxd-ing-text {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.lx-pxd-ing-name-row {
  display: flex;
  align-items: baseline;
  gap: .75rem;
}

.lx-pxd-ing-num {
  font-family: var(--lx-display);
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--lx-line-strong);
  line-height: 1;
  flex-shrink: 0;
  letter-spacing: -.04em;
}

.lx-pxd-ing-name-row h3 {
  font-family: var(--lx-display);
  font-size: clamp(1.3rem, 2.5vw, 1.75rem);
  font-weight: 800;
  color: var(--lx-navy);
  margin: 0;
  line-height: 1.2;
}

.lx-pxd-ing-tag {
  display: inline-flex;
  align-items: center;
  padding: .3em .9em;
  background: var(--pxd-accent-soft, var(--lx-blue-050));
  color: var(--pxd-accent, var(--lx-blue-ink));
  border: 1px solid color-mix(in srgb, var(--pxd-accent, var(--lx-blue)) 25%, transparent);
  border-radius: var(--lx-pill);
  font-size: .78rem;
  font-weight: 600;
  letter-spacing: .04em;
  align-self: flex-start;
}

.lx-pxd-ing-body {
  font-size: .95rem;
  color: var(--lx-ink);
  line-height: 1.7;
}

.lx-pxd-ing-body p { margin: 0 0 .5em; }
.lx-pxd-ing-body p:last-child { margin-bottom: 0; }

.lx-pxd-ing-fact {
  display: flex;
  align-items: flex-start;
  gap: .6rem;
  padding: .85rem 1.1rem;
  background: var(--lx-blue-050);
  border-left: 3px solid var(--lx-blue);
  border-radius: 0 var(--lx-r-sm) var(--lx-r-sm) 0;
  font-size: .85rem;
  color: var(--lx-blue-ink);
  line-height: 1.5;
}

.lx-pxd-ing-fact i {
  font-size: 1.05rem;
  flex-shrink: 0;
  margin-top: .1em;
  color: var(--lx-blue);
}

.lx-pxd-ing-visual {
  border-radius: var(--lx-r-lg);
  overflow: hidden;
  background: var(--lx-bg-alt);
}

.lx-pxd-ing-visual img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: var(--lx-r-lg);
  object-fit: cover;
  aspect-ratio: 4/3;
  transition: transform .45s var(--lx-ease);
}

.lx-pxd-ing:hover .lx-pxd-ing-visual img {
  transform: scale(1.03);
}

.lx-pxd-ing-placeholder {
  aspect-ratio: 4/3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3.5rem;
  color: var(--lx-faint);
  background: var(--lx-bg-alt);
  border-radius: var(--lx-r-lg);
}

/* ──────────────────────────────────────────
   HOW TO TAKE
   ────────────────────────────────────────── */
.lx-pxd-howto {
  position: relative;
  z-index: 1;
  padding: clamp(3.5rem, 7vw, 6.5rem) 0;
  background: var(--lx-bg-soft);
}

.lx-pxd-howto-flow {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: clamp(.75rem, 2.5vw, 2rem);
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
}

.lx-pxd-howto-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: .6rem;
  flex: 1;
  min-width: 140px;
  max-width: 220px;
  padding: 1.75rem 1.25rem;
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r-lg);
  transition: transform var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease);
}

.lx-pxd-howto-step:hover {
  transform: translateY(-3px);
  box-shadow: var(--lx-sh);
}

.lx-pxd-howto-step--final {
  border-color: var(--pxd-accent, var(--lx-blue));
  background: var(--pxd-accent-soft, var(--lx-blue-050));
}

.lx-pxd-howto-step-icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--lx-blue-050);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  color: var(--lx-blue);
  flex-shrink: 0;
}

.lx-pxd-howto-step-icon--accent {
  background: var(--pxd-accent-soft, var(--lx-blue-050));
  color: var(--pxd-accent, var(--lx-blue));
}

.lx-pxd-howto-step-num {
  font-family: var(--lx-display);
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .15em;
  color: var(--lx-faint);
  text-transform: uppercase;
}

.lx-pxd-howto-step-title {
  font-size: .95rem;
  font-weight: 700;
  color: var(--lx-navy);
  display: block;
}

.lx-pxd-howto-step-sub {
  font-size: .82rem;
  color: var(--lx-muted);
  display: block;
}

.lx-pxd-howto-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--lx-faint);
  flex-shrink: 0;
  padding-top: 1.5rem;
  align-self: center;
}

/* Cycle / dosage band */
.lx-pxd-cycle-band {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 1.5rem;
  padding: 1.5rem 2rem;
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r);
  max-width: 760px;
  margin: 0 auto;
}

.lx-pxd-cycle-text {
  display: flex;
  flex-direction: column;
  gap: .2rem;
  text-align: center;
}

.lx-pxd-cycle-label {
  font-size: .75rem;
  color: var(--lx-muted);
  font-weight: 500;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.lx-pxd-cycle-formula {
  font-family: var(--lx-display);
  font-size: clamp(1rem, 2vw, 1.3rem);
  font-weight: 800;
  color: var(--lx-navy);
}

.lx-pxd-cycle-arrow {
  color: var(--pxd-accent, var(--lx-blue));
}

.lx-pxd-cycle-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .15rem;
  text-align: center;
}

.lx-pxd-cycle-result strong {
  font-family: var(--lx-display);
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  font-weight: 900;
  color: var(--pxd-accent, var(--lx-blue));
  line-height: 1;
}

.lx-pxd-cycle-result span {
  font-size: .8rem;
  color: var(--lx-muted);
  font-weight: 500;
}

/* ──────────────────────────────────────────
   BENEFITS GRID
   ────────────────────────────────────────── */
.lx-pxd-benefits {
  position: relative;
  z-index: 1;
  padding: clamp(3.5rem, 7vw, 6.5rem) 0;
  background: var(--lx-bg);
}

.lx-pxd-benefits-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.25rem;
}

.lx-pxd-benefit-card {
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r-lg);
  padding: 1.75rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: .85rem;
  transition: transform var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease),
              border-color var(--lx-dur) var(--lx-ease);
}

.lx-pxd-benefit-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--lx-sh-lg);
  border-color: transparent;
}

.lx-pxd-benefit-icon {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: var(--lx-blue-050);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.35rem;
  color: var(--lx-blue);
  flex-shrink: 0;
}

.lx-pxd-benefit-card h3 {
  font-family: var(--lx-display);
  font-size: 1rem;
  font-weight: 700;
  color: var(--lx-navy);
  margin: 0;
  line-height: 1.3;
}

.lx-pxd-benefit-card p {
  font-size: .875rem;
  color: var(--lx-muted);
  line-height: 1.6;
  margin: 0;
}

/* ──────────────────────────────────────────
   COMPARE-TO CALLOUT
   ────────────────────────────────────────── */
.lx-pxd-compare-callout {
  position: relative;
  z-index: 1;
  padding: clamp(2.5rem, 5vw, 4rem) 0;
  background: var(--lx-bg-soft);
}

.lx-pxd-callout-card {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  padding: 1.75rem 2rem;
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r-lg);
  box-shadow: var(--lx-sh-sm);
  flex-wrap: wrap;
}

.lx-pxd-callout-icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--lx-blue-050);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  color: var(--lx-blue);
  flex-shrink: 0;
}

.lx-pxd-callout-text {
  flex: 1;
  min-width: 200px;
  display: flex;
  flex-direction: column;
  gap: .2rem;
}

.lx-pxd-callout-text strong {
  font-size: 1rem;
  font-weight: 700;
  color: var(--lx-navy);
}

.lx-pxd-callout-text span {
  font-size: .875rem;
  color: var(--lx-muted);
  line-height: 1.5;
}

.lx-pxd-callout-btn {
  flex-shrink: 0;
  white-space: nowrap;
}

/* ──────────────────────────────────────────
   FAQ ACCORDION
   ────────────────────────────────────────── */
.lx-pxd-faq {
  position: relative;
  z-index: 1;
  padding: clamp(3.5rem, 7vw, 6.5rem) 0;
  background: var(--lx-bg);
}

.lx-pxd-faq-list {
  max-width: 800px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: .75rem;
}

.lx-pxd-faq-item {
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r);
  overflow: hidden;
  transition: box-shadow var(--lx-dur) var(--lx-ease),
              border-color var(--lx-dur) var(--lx-ease);
}

.lx-pxd-faq-item[open] {
  box-shadow: var(--lx-sh);
  border-color: var(--lx-line-strong);
}

.lx-pxd-faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.2rem 1.5rem;
  cursor: pointer;
  list-style: none;
  user-select: none;
  font-weight: 600;
  font-size: .95rem;
  color: var(--lx-navy);
  transition: background var(--lx-dur) var(--lx-ease);
}

.lx-pxd-faq-q::-webkit-details-marker { display: none; }

.lx-pxd-faq-q:hover {
  background: var(--lx-bg-soft);
}

.lx-pxd-faq-q span {
  flex: 1;
  line-height: 1.45;
}

.lx-pxd-faq-icon {
  font-size: 1.1rem;
  flex-shrink: 0;
  color: var(--lx-blue);
  transition: transform var(--lx-dur) var(--lx-ease);
}

.lx-pxd-faq-item[open] .lx-pxd-faq-icon {
  transform: rotate(45deg);
}

.lx-pxd-faq-a {
  padding: 0 1.5rem 1.25rem;
  font-size: .9rem;
  color: var(--lx-muted);
  line-height: 1.7;
}

.lx-pxd-faq-a p   { margin: 0 0 .5em; }
.lx-pxd-faq-a p:last-child { margin-bottom: 0; }

/* ──────────────────────────────────────────
   CLOSING CTA
   ────────────────────────────────────────── */
.lx-pxd-closing {
  position: relative;
  z-index: 1;
  padding: clamp(3.5rem, 7vw, 6.5rem) 0;
}

.lx-pxd-closing-card {
  background: linear-gradient(135deg, var(--lx-navy) 0%, var(--lx-blue-700) 100%);
  border-radius: var(--lx-r-lg);
  padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  box-shadow: var(--lx-sh-lg);
  position: relative;
  overflow: hidden;
}

.lx-pxd-closing-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 70% 60% at 60% 40%, rgba(0,151,212,.25), transparent);
  pointer-events: none;
}

.lx-pxd-closing-card h2 {
  font-family: var(--lx-display);
  font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  font-weight: 800;
  color: #fff;
  margin: 0;
  line-height: 1.15;
  position: relative;
  z-index: 1;
}

.lx-pxd-closing-card p {
  font-size: clamp(.9rem, 1.4vw, 1.05rem);
  color: rgba(255,255,255,.75);
  max-width: 52ch;
  line-height: 1.65;
  margin: 0;
  position: relative;
  z-index: 1;
}

.lx-pxd-closing-actions {
  display: flex;
  flex-wrap: wrap;
  gap: .85rem;
  justify-content: center;
  position: relative;
  z-index: 1;
}

/* ──────────────────────────────────────────
   RESPONSIVE  —  ≤860px
   ────────────────────────────────────────── */
@media (max-width: 860px) {
  .lx-pxd-hero-grid {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .lx-pxd-hero-text {
    align-items: center;
    order: 1;
  }

  .lx-pxd-hero-visual {
    order: 0;
  }

  .lx-pxd-lead {
    max-width: 100%;
  }

  .lx-pxd-actions {
    justify-content: center;
  }

  .lx-pxd-float-card {
    position: static;
    margin-top: 1rem;
    justify-content: center;
  }

  .lx-pxd-stats {
    grid-template-columns: repeat(3, 1fr);
  }

  .lx-pxd-ing {
    grid-template-columns: 1fr;
  }

  .lx-pxd-ing--alt {
    direction: ltr;
  }

  .lx-pxd-howto-arrow {
    transform: rotate(90deg);
    padding-top: 0;
  }

  .lx-pxd-callout-card {
    flex-direction: column;
    text-align: center;
  }

  .lx-pxd-callout-text {
    align-items: center;
  }
}

/* ──────────────────────────────────────────
   RESPONSIVE  —  ≤520px
   ────────────────────────────────────────── */
@media (max-width: 520px) {
  .lx-pxd-stats {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .lx-pxd-stat {
    border-bottom: 1px solid var(--lx-line);
  }

  .lx-pxd-stat:last-child {
    border-bottom: none;
  }

  .lx-pxd-pillars-grid {
    grid-template-columns: 1fr;
  }

  .lx-pxd-benefits-grid {
    grid-template-columns: 1fr;
  }

  .lx-pxd-howto-flow {
    flex-direction: column;
    align-items: center;
  }

  .lx-pxd-howto-arrow {
    transform: rotate(90deg);
  }

  .lx-pxd-cycle-band {
    flex-direction: column;
    text-align: center;
  }

  .lx-pxd-cycle-arrow {
    transform: rotate(90deg);
  }

  .lx-pxd-ssp-word {
    font-size: clamp(2rem, 10vw, 3rem);
  }

  .lx-pxd-closing-actions {
    flex-direction: column;
    align-items: center;
  }
}

/* ──────────────────────────────────────────
   REDUCED MOTION GUARD
   ────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .lx-swimmer,
  .lx-ssp-dot,
  .lx-ssp-ring,
  .lx-ssp-word,
  .lx-pxd-float-card {
    animation: none !important;
    opacity: 1;
    transform: none !important;
    translate: none !important;
  }

  .lx-pxd-btn,
  .lx-pxd-pillar,
  .lx-pxd-benefit-card,
  .lx-pxd-howto-step,
  .lx-pxd-faq-item,
  .lx-pxd-ing-visual img {
    transition: none !important;
  }
}
