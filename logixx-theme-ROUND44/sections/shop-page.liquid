<section class="shop-page">
  <div class="container">

    <!-- Centered header -->
    <header class="shop-head">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 600 }}"
             alt="{{ section.settings.heading }}"
             class="shop-head-logo"
             style="max-height: {{ section.settings.logo_height }}px;">
      {% else %}
        <h1>{{ section.settings.heading }}</h1>
      {% endif %}
      <p>{{ section.settings.subheading }}</p>
    </header>

    <!-- Body: sidebar + grid -->
    <div class="shop-body">

      <!-- Filter sidebar -->
      <aside class="shop-sidebar">
        <h3 class="shop-sidebar-title">Filters</h3>

        <div class="shop-search">
          <form action="/search" method="get" role="search">
            <input type="search" name="q" placeholder="Search" value="">
            <button type="submit" aria-label="Search"><i class="ph ph-magnifying-glass"></i></button>
          </form>
        </div>

        <a href="/pages/shop" class="shop-reset">Reset filters</a>

        <details class="shop-filter-group" open>
          <summary>
            <span>Categories</span>
            <i class="ph ph-caret-down"></i>
          </summary>
          <ul class="shop-filter-list">
            <li><a href="/collections/all">All products</a></li>
            <li><a href="/collections/male-fertility">Male fertility</a></li>
            <li><a href="/collections/female-fertility">Female fertility</a></li>
            <li><a href="/collections/wellness">Wellness</a></li>
            <li><a href="/collections/diagnostics">Diagnostics</a></li>
          </ul>
        </details>

        <details class="shop-filter-group" open>
          <summary>
            <span>Brands</span>
            <i class="ph ph-caret-down"></i>
          </summary>
          <ul class="shop-filter-list">
            <li><a href="/collections/proxeed">Proxeed</a></li>
            <li><a href="/collections/punalpin">Punalpin</a></li>
            <li><a href="/collections/lenshooke">LensHooke</a></li>
            <li><a href="/collections/mioxsys">MiOXSYS</a></li>
          </ul>
        </details>
      </aside>

      <!-- Product grid -->
      <div class="shop-grid">
        {% assign featured = collections[section.settings.collection] %}

        {% if featured.products.size > 0 %}
          <div class="product-grid product-grid--3col">
            {% for product in featured.products limit: 12 %}
              <a href="{{ product.url }}" class="product-card">
                <div class="product-image">
                  {% if product.featured_image %}
                    <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  {% endif %}
                  {% if product.compare_at_price > product.price %}
                    <span class="product-badge">Sale</span>
                  {% endif %}
                </div>
                <div class="product-info">
                  {% if product.vendor %}
                    <div class="product-cat">{{ product.vendor }}</div>
                  {% endif %}
                  <h3 class="product-title">{{ product.title }}</h3>
                  <div class="product-price">
                    {{ product.price | money }}
                    {% if product.compare_at_price > product.price %}
                      <span class="compare">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                  </div>
                </div>
              </a>
            {% endfor %}
          </div>
        {% else %}
          <!-- Demo cards if no collection set -->
          <div class="product-grid product-grid--3col">

            <a href="/products/proxeed-plus" class="product-card">
              <div class="product-image">
                <span class="product-badge">Bestseller</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
              <div class="product-info">
                <div class="product-cat">Proxeed</div>
                <h3 class="product-title">Proxeed Plus</h3>
                <div class="product-price">£34.99 <span class="compare">£44.99</span></div>
              </div>
            </a>

            <a href="/products/proxeed-men" class="product-card">
              <div class="product-image">
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
              <div class="product-info">
                <div class="product-cat">Proxeed</div>
                <h3 class="product-title">Proxeed Men</h3>
                <div class="product-price">£39.99</div>
              </div>
            </a>

            <a href="/products/proxeed-women" class="product-card">
              <div class="product-image">
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
              <div class="product-info">
                <div class="product-cat">Proxeed</div>
                <h3 class="product-title">Proxeed Women</h3>
                <div class="product-price">£32.99 <span class="compare">£39.99</span></div>
              </div>
            </a>

            <a href="/products/punalpin" class="product-card">
              <div class="product-image">
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
              <div class="product-info">
                <div class="product-cat">Punalpin</div>
                <h3 class="product-title">Punalpin (90 days)</h3>
                <div class="product-price">£29.99</div>
              </div>
            </a>

            <a href="/products/lenshooke" class="product-card">
              <div class="product-image">
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </div>
              <div class="product-info">
                <div class="product-cat">LensHooke</div>
                <h3 class="product-title">LensHooke X1 PRO</h3>
                <div class="product-price">Request quote</div>
              </div>
            </a>

            <a href="/products/mioxsys" class="product-card">
              <div class="product-image">
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </div>
              <div class="product-info">
                <div class="product-cat">MiOXSYS</div>
                <h3 class="product-title">MiOXSYS Redox System</h3>
                <div class="product-price">Request quote</div>
              </div>
            </a>

          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop Page",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional)", "info": "If set, replaces the heading text with your logo." },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 40, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "text",     "id": "heading",    "label": "Heading (used if no logo)", "default": "LogixX store" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Our mission is to create positive change in the world of fertility. Clinically proven supplements and diagnostics — trusted by 311,000+ couples worldwide." },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection to display", "info": "Pick a collection from your store. Leave blank to show demo product cards." }
  ],
  "presets": [{ "name": "Shop Page" }]
}
{% endschema %}
