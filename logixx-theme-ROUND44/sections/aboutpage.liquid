<section class="about-v2">

  <!-- HERO -->
  <div class="aboutv2-hero">
    <div class="container">
      <div class="aboutv2-hero-grid">
        <div class="aboutv2-hero-text">
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          <h1>{{ section.settings.heading }}</h1>
          <p class="aboutv2-lead">{{ section.settings.subheading }}</p>
          <div class="aboutv2-hero-actions">
            {% if section.settings.cta1_link != blank %}
              <a href="{{ section.settings.cta1_link }}" class="btn btn-primary">
                {{ section.settings.cta1_text }}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            {% endif %}
            {% if section.settings.cta2_link != blank %}
              <a href="{{ section.settings.cta2_link }}" class="btn btn-ghost">{{ section.settings.cta2_text }}</a>
            {% endif %}
          </div>
        </div>

        <div class="aboutv2-hero-visual">
          <div class="aboutv2-hero-image">
            {% if section.settings.hero_image != blank %}
              <img src="{{ section.settings.hero_image | image_url: width: 1200 }}" alt="{{ section.settings.heading }}">
            {% else %}
              <div class="aboutv2-hero-placeholder"><i class="ph ph-image"></i><span>Add hero image</span></div>
            {% endif %}
          </div>
          {% if section.settings.show_float %}
            <div class="aboutv2-float-card">
              <div class="aboutv2-float-card-icon"><i class="ph ph-shield-check"></i></div>
              <div>
                <strong>{{ section.settings.float_title }}</strong>
                <span>{{ section.settings.float_sub }}</span>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- STATS -->
  {% if section.settings.show_stats %}
    <div class="aboutv2-stats">
      <div class="container">
        <div class="aboutv2-stats-grid">
          <div class="aboutv2-stat"><strong>{{ section.settings.stat_1_num }}</strong><span>{{ section.settings.stat_1_label }}</span></div>
          <div class="aboutv2-stat"><strong>{{ section.settings.stat_2_num }}</strong><span>{{ section.settings.stat_2_label }}</span></div>
          <div class="aboutv2-stat"><strong>{{ section.settings.stat_3_num }}</strong><span>{{ section.settings.stat_3_label }}</span></div>
          <div class="aboutv2-stat"><strong>{{ section.settings.stat_4_num }}</strong><span>{{ section.settings.stat_4_label }}</span></div>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- STORY -->
  {% if section.settings.story_body != blank %}
    <div class="aboutv2-story">
      <div class="container">
        <div class="aboutv2-story-grid">
          <div class="aboutv2-story-side">
            <span class="eyebrow">{{ section.settings.story_eyebrow }}</span>
            <h2>{{ section.settings.story_heading }}</h2>
          </div>
          <div class="aboutv2-story-body rte">{{ section.settings.story_body }}</div>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- TIMELINE — editorial redesign -->
  {% assign milestone_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'milestone' %}{% assign milestone_count = milestone_count | plus: 1 %}{% endif %}{% endfor %}

  {% if milestone_count > 0 %}
    <div class="aboutv2-timeline" id="aboutv2-tl-{{ section.id }}">
      <div class="container">
        <div class="aboutv2-timeline-head">
          <span class="eyebrow">{{ section.settings.timeline_eyebrow }}</span>
          <h2>{{ section.settings.timeline_heading }}</h2>
          <p>{{ section.settings.timeline_sub }}</p>
        </div>

        <!-- Sticky year nav -->
        <div class="aboutv2-tl-nav-wrap">
          <div class="aboutv2-tl-nav">
            {% for block in section.blocks %}
              {% if block.type == 'milestone' %}
                <button type="button" class="aboutv2-tl-pill{% if forloop.first %} is-active{% endif %}" data-target="{{ block.id }}">{{ block.settings.year }}</button>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <!-- Editorial timeline -->
        <div class="aboutv2-tl">
          <div class="aboutv2-tl-axis"></div>
          <div class="aboutv2-tl-axis-fill" id="aboutv2-tl-progress-{{ section.id }}"></div>

          {% assign idx = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'milestone' %}
              <article class="aboutv2-tl-row{% if idx == 0 %} is-active{% endif %}{% if idx == 0 %} is-first{% endif %}" id="{{ block.id }}" data-index="{{ idx }}" {{ block.shopify_attributes }}>

                <div class="aboutv2-tl-axis-marker">
                  <span class="aboutv2-tl-tick"></span>
                </div>

                <!-- Year marker (oversized typography) -->
                <div class="aboutv2-tl-year-block">
                  <span class="aboutv2-tl-year-big">{{ block.settings.year }}</span>
                </div>

                <!-- Content side: text + adjacent image -->
                <div class="aboutv2-tl-content">
                  <div class="aboutv2-tl-text-card">
                    <h3>{{ block.settings.title }}</h3>
                    <p>{{ block.settings.description }}</p>
                  </div>

                  {% if block.settings.image != blank %}
                    <div class="aboutv2-tl-image-frame">
                      <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title }}" loading="lazy">
                    </div>
                  {% endif %}
                </div>

              </article>
              {% assign idx = idx | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- CLOSING CTA -->
  {% if section.settings.show_closing %}
    <div class="aboutv2-closing">
      <div class="container">
        <div class="aboutv2-closing-card">
          {% if section.settings.closing_heading != blank %}<h2>{{ section.settings.closing_heading }}</h2>{% endif %}
          {% if section.settings.closing_sub != blank %}<p>{{ section.settings.closing_sub }}</p>{% endif %}
          <div class="aboutv2-closing-actions">
            {% if section.settings.closing_btn1_link != blank %}
              <a href="{{ section.settings.closing_btn1_link }}" class="btn btn-primary">{{ section.settings.closing_btn1_text }}</a>
            {% endif %}
            {% if section.settings.closing_btn2_link != blank %}
              <a href="{{ section.settings.closing_btn2_link }}" class="btn btn-ghost">{{ section.settings.closing_btn2_text }}</a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</section>

<script>
(function(){
  var section = document.getElementById('aboutv2-tl-{{ section.id }}');
  if (!section) return;
  var rows = section.querySelectorAll('.aboutv2-tl-row');
  var pills = section.querySelectorAll('.aboutv2-tl-pill');
  var progressBar = document.getElementById('aboutv2-tl-progress-{{ section.id }}');
  if (!rows.length) return;

  // Click year pill → smooth scroll
  pills.forEach(function(pill){
    pill.addEventListener('click', function(){
      var target = document.getElementById(pill.dataset.target);
      if (target) window.scrollTo({ top: window.pageYOffset + target.getBoundingClientRect().top - 140, behavior: 'smooth' });
    });
  });

  // Reveal animations — only enable if IntersectionObserver supported
  if ('IntersectionObserver' in window) {
    section.classList.add('js-anim-ready');

    var revealIO = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) {
          e.target.classList.add('is-revealed');
          revealIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });

    rows.forEach(function(row){ revealIO.observe(row); });

    // Failsafe: reveal anything still hidden after 2s
    setTimeout(function(){
      rows.forEach(function(row){ row.classList.add('is-revealed'); });
    }, 2000);

    // Active state — middle of viewport
    var activeIO = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting) {
          var idx = parseInt(entry.target.dataset.index, 10);
          rows.forEach(function(r){ r.classList.remove('is-active'); });
          entry.target.classList.add('is-active');
          pills.forEach(function(p, i){ p.classList.toggle('is-active', i === idx); });
        }
      });
    }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
    rows.forEach(function(row){ activeIO.observe(row); });
  }

  // Smooth progress bar fill
  var ticking = false;
  function updateProgress(){
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function(){
      var first = rows[0].getBoundingClientRect();
      var last = rows[rows.length - 1].getBoundingClientRect();
      var totalHeight = last.bottom - first.top;
      var scrolled = Math.max(0, (window.innerHeight / 2) - first.top);
      var pct = Math.min(100, Math.max(0, (scrolled / totalHeight) * 100));
      if (progressBar) progressBar.style.height = pct + '%';
      ticking = false;
    });
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress, { passive: true });
  updateProgress();
})();
</script>

{% stylesheet %}
/* ============================================================
   ABOUT PAGE — aboutpage.liquid
   Root wrapper: .about-v2
   All rules scoped to avoid global collisions.
   ============================================================ */

/* ---------- Section base ---------- */
.about-v2 {
  overflow: hidden;
}

/* ---------- HERO ---------- */
.aboutv2-hero {
  padding-block: clamp(4rem, 9vw, 8rem) clamp(3.5rem, 7vw, 6rem);
  background: var(--lx-bg);
}

.aboutv2-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2.5rem, 5vw, 5rem);
  align-items: center;
}

.aboutv2-hero-text {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.aboutv2-lead {
  font-size: clamp(1.05rem, 1.8vw, 1.2rem);
  color: var(--lx-muted);
  line-height: 1.65;
  margin: 0;
}

.aboutv2-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: .75rem;
  margin-top: .5rem;
}

/* Ghost button variant */
.about-v2 .btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  padding: .65rem 1.4rem;
  border-radius: var(--lx-pill);
  border: 1.5px solid var(--lx-line-strong);
  color: var(--lx-ink);
  font-size: .92rem;
  font-weight: 600;
  background: transparent;
  text-decoration: none;
  transition: border-color var(--lx-dur) var(--lx-ease),
              background var(--lx-dur) var(--lx-ease),
              color var(--lx-dur) var(--lx-ease);
}
.about-v2 .btn-ghost:hover {
  border-color: var(--lx-blue);
  background: var(--lx-blue-050);
  color: var(--lx-blue-ink);
}

/* Hero visual */
.aboutv2-hero-visual {
  position: relative;
}

.aboutv2-hero-image {
  border-radius: var(--lx-r-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--lx-bg-soft);
  box-shadow: var(--lx-sh-lg);
}

.aboutv2-hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.aboutv2-hero-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: .75rem;
  color: var(--lx-faint);
  font-size: .9rem;
}
.aboutv2-hero-placeholder i { font-size: 2.5rem; }

/* Floating badge */
.aboutv2-float-card {
  position: absolute;
  bottom: -1.5rem;
  left: -1.75rem;
  display: flex;
  align-items: center;
  gap: .85rem;
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r);
  padding: .85rem 1.2rem;
  box-shadow: var(--lx-sh);
  min-width: 210px;
}

.aboutv2-float-card-icon {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: var(--lx-blue-050);
  color: var(--lx-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.35rem;
  flex-shrink: 0;
}

.aboutv2-float-card strong {
  display: block;
  font-size: .88rem;
  font-weight: 700;
  color: var(--lx-navy);
  line-height: 1.3;
}

.aboutv2-float-card span {
  display: block;
  font-size: .78rem;
  color: var(--lx-muted);
  margin-top: .15rem;
}

/* ---------- STATS ---------- */
.aboutv2-stats {
  padding-block: clamp(2rem, 4vw, 3.5rem);
  background: var(--lx-navy);
}

.aboutv2-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: rgba(255,255,255,.1);
  border-radius: var(--lx-r);
  overflow: hidden;
}

.aboutv2-stat {
  background: var(--lx-navy);
  padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.75rem);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .4rem;
  text-align: center;
}

.aboutv2-stat strong {
  display: block;
  font-family: var(--lx-display);
  font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  font-weight: 800;
  color: #fff;
  letter-spacing: -.02em;
  line-height: 1;
}

.aboutv2-stat span {
  font-size: .82rem;
  color: rgba(255,255,255,.6);
  letter-spacing: .06em;
  text-transform: uppercase;
}

/* ---------- STORY ---------- */
.aboutv2-story {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg-soft);
}

.aboutv2-story-grid {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: clamp(2.5rem, 5vw, 5rem);
  align-items: start;
}

.aboutv2-story-side {
  display: flex;
  flex-direction: column;
  gap: .75rem;
  position: sticky;
  top: 6rem;
}

.aboutv2-story-side h2 {
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  color: var(--lx-navy);
  margin: 0;
  line-height: 1.25;
}

.aboutv2-story-body {
  font-size: clamp(.97rem, 1.5vw, 1.1rem);
  color: var(--lx-ink);
  line-height: 1.75;
}

.aboutv2-story-body p + p {
  margin-top: 1.1rem;
}

/* ---------- TIMELINE ---------- */
.aboutv2-timeline {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg);
}

.aboutv2-timeline-head {
  text-align: center;
  max-width: 640px;
  margin-inline: auto;
  margin-bottom: clamp(2.5rem, 4vw, 4rem);
  display: flex;
  flex-direction: column;
  gap: .7rem;
}

.aboutv2-timeline-head h2 {
  font-size: clamp(1.6rem, 2.8vw, 2.25rem);
  color: var(--lx-navy);
  margin: 0;
}

.aboutv2-timeline-head p {
  color: var(--lx-muted);
  font-size: 1rem;
  margin: 0;
}

/* Year nav pills */
.aboutv2-tl-nav-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: clamp(2rem, 4vw, 3.5rem);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.aboutv2-tl-nav {
  display: flex;
  gap: .5rem;
  flex-wrap: nowrap;
  padding: .25rem;
  background: var(--lx-bg-alt);
  border-radius: var(--lx-pill);
  border: 1px solid var(--lx-line);
}

.aboutv2-tl-pill {
  padding: .45rem 1.1rem;
  border-radius: var(--lx-pill);
  border: none;
  background: transparent;
  color: var(--lx-muted);
  font-size: .85rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: background var(--lx-dur) var(--lx-ease),
              color var(--lx-dur) var(--lx-ease);
}

.aboutv2-tl-pill:hover,
.aboutv2-tl-pill.is-active {
  background: var(--lx-blue);
  color: #fff;
}

/* Axis */
.aboutv2-tl {
  position: relative;
  padding-left: 3rem;
}

.aboutv2-tl-axis {
  position: absolute;
  left: calc(3rem - 1px);
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--lx-line);
  border-radius: 2px;
}

.aboutv2-tl-axis-fill {
  position: absolute;
  left: calc(3rem - 1px);
  top: 0;
  width: 2px;
  background: var(--lx-blue);
  border-radius: 2px;
  transition: height .15s linear;
  height: 0%;
}

/* Timeline row */
.aboutv2-tl-row {
  position: relative;
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: clamp(1.5rem, 3vw, 2.5rem);
  padding: clamp(1.5rem, 3vw, 2.5rem) 0;
  border-bottom: 1px solid var(--lx-line);
}

.aboutv2-tl-row:last-child {
  border-bottom: none;
}

.aboutv2-tl-axis-marker {
  position: absolute;
  left: -3rem;
  top: clamp(2rem, 3vw, 2.75rem);
  width: 3rem;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: .75rem;
}

.aboutv2-tl-tick {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--lx-line-strong);
  border: 2px solid #fff;
  box-shadow: 0 0 0 2px var(--lx-line-strong);
  display: block;
  transition: background var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease);
}

.aboutv2-tl-row.is-active .aboutv2-tl-tick {
  background: var(--lx-blue);
  box-shadow: 0 0 0 3px var(--lx-blue-100);
}

.aboutv2-tl-year-block {
  display: flex;
  align-items: flex-start;
  padding-top: .15rem;
}

.aboutv2-tl-year-big {
  font-family: var(--lx-display);
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 800;
  color: var(--lx-line-strong);
  letter-spacing: -.04em;
  line-height: 1;
  transition: color var(--lx-dur) var(--lx-ease);
}

.aboutv2-tl-row.is-active .aboutv2-tl-year-big {
  color: var(--lx-blue);
}

.aboutv2-tl-content {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
}

.aboutv2-tl-text-card {
  flex: 1;
}

.aboutv2-tl-text-card h3 {
  font-size: clamp(1rem, 1.6vw, 1.2rem);
  color: var(--lx-navy);
  margin: 0 0 .5rem;
}

.aboutv2-tl-text-card p {
  color: var(--lx-muted);
  font-size: .95rem;
  line-height: 1.6;
  margin: 0;
}

.aboutv2-tl-image-frame {
  flex-shrink: 0;
  width: clamp(130px, 18vw, 200px);
  border-radius: var(--lx-r);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--lx-bg-soft);
}

.aboutv2-tl-image-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Reveal animation */
.about-v2.js-anim-ready .aboutv2-tl-row {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity .45s var(--lx-ease), transform .45s var(--lx-ease);
}

.about-v2.js-anim-ready .aboutv2-tl-row.is-revealed {
  opacity: 1;
  transform: none;
}

/* ---------- CLOSING CTA ---------- */
.aboutv2-closing {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg-soft);
}

.aboutv2-closing-card {
  background: var(--lx-navy);
  border-radius: var(--lx-r-lg);
  padding: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 5vw, 4rem);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  box-shadow: var(--lx-sh-blue);
}

.aboutv2-closing-card h2 {
  color: #fff;
  font-size: clamp(1.5rem, 3vw, 2.25rem);
  margin: 0;
}

.aboutv2-closing-card p {
  color: rgba(255,255,255,.7);
  font-size: 1.05rem;
  margin: 0;
  max-width: 540px;
}

.aboutv2-closing-actions {
  display: flex;
  flex-wrap: wrap;
  gap: .75rem;
  justify-content: center;
  margin-top: .5rem;
}

/* Ghost button inside dark card */
.aboutv2-closing-card .btn-ghost {
  border-color: rgba(255,255,255,.3);
  color: rgba(255,255,255,.85);
}
.aboutv2-closing-card .btn-ghost:hover {
  border-color: rgba(255,255,255,.7);
  background: rgba(255,255,255,.1);
  color: #fff;
}

/* ---- Responsive ---- */
@media (max-width: 860px) {
  .aboutv2-hero-grid {
    grid-template-columns: 1fr;
  }
  .aboutv2-hero-visual {
    max-width: 540px;
    margin-inline: auto;
  }
  .aboutv2-float-card {
    left: auto;
    right: 0;
    bottom: -1rem;
  }
  .aboutv2-stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .aboutv2-story-grid {
    grid-template-columns: 1fr;
  }
  .aboutv2-story-side {
    position: static;
  }
  .aboutv2-tl-row {
    grid-template-columns: 80px 1fr;
  }
  .aboutv2-tl-content {
    flex-direction: column;
  }
  .aboutv2-tl-image-frame {
    width: 100%;
    max-width: 340px;
  }
}

@media (max-width: 520px) {
  .aboutv2-stats-grid {
    grid-template-columns: 1fr 1fr;
  }
  .aboutv2-tl {
    padding-left: 1.75rem;
  }
  .aboutv2-tl-row {
    grid-template-columns: 70px 1fr;
    gap: 1rem;
  }
  .aboutv2-tl-axis,
  .aboutv2-tl-axis-fill {
    left: calc(1.75rem - 1px);
  }
  .aboutv2-tl-axis-marker {
    left: -1.75rem;
    width: 1.75rem;
  }
  .aboutv2-float-card {
    position: static;
    margin-top: 1rem;
    border-radius: var(--lx-r);
  }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .about-v2.js-anim-ready .aboutv2-tl-row {
    opacity: 1;
    transform: none;
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "About Page",
  "max_blocks": 16,
