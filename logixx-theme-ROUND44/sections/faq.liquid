{%- comment -%}
  FAQ accordion — collapsible Q&A. Each FAQ is a Block, fully editable.
{%- endcomment -%}

<section class="lx-faq" id="lx-faq-{{ section.id }}">
  <div class="lx-faq-inner">

    <div class="lx-faq-head">
      {% if section.settings.eyebrow != blank %}
        <p class="lx-faq-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="lx-faq-heading">{{ section.settings.heading | default: 'Frequently asked questions' }}</h2>
      {% if section.settings.sub != blank %}
        <p class="lx-faq-sub">{{ section.settings.sub }}</p>
      {% endif %}
    </div>

    <div class="lx-faq-list">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <details class="lx-faq-item" {{ block.shopify_attributes }}>
              <summary class="lx-faq-q">
                <span>{{ block.settings.question }}</span>
                <span class="lx-faq-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <div class="lx-faq-a">{{ block.settings.answer }}</div>
            </details>
          {% endif %}
        {% endfor %}
      {% else %}
        <details class="lx-faq-item">
          <summary class="lx-faq-q">
            <span>How long does UK delivery take?</span>
            <span class="lx-faq-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></span>
          </summary>
          <div class="lx-faq-a"><p>Standard UK delivery arrives in 2–3 working days. Free on orders over £50.</p></div>
        </details>
        <details class="lx-faq-item">
          <summary class="lx-faq-q">
            <span>Do you ship to the US?</span>
            <span class="lx-faq-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></span>
          </summary>
          <div class="lx-faq-a"><p>Yes. We ship worldwide and handle all import duties at checkout — no surprise fees on delivery. US shipments typically arrive in 5–7 working days.</p></div>
        </details>
        <details class="lx-faq-item">
          <summary class="lx-faq-q">
            <span>Are your supplements clinically backed?</span>
            <span class="lx-faq-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></span>
          </summary>
          <div class="lx-faq-a"><p>All our supplements are formulated using ingredients with published clinical evidence and are recommended by fertility specialists in over 40 countries.</p></div>
        </details>
      {% endif %}
    </div>

    {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
      <div class="lx-faq-cta">
        <p class="lx-faq-cta-text">{{ section.settings.cta_text }}</p>
        <a href="{{ section.settings.cta_link }}" class="lx-faq-cta-btn">
          {{ section.settings.cta_btn_text | default: 'Get in touch' }}
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% stylesheet %}
/* =============================================
   lx-faq — FAQ Accordion
   ============================================= */

.lx-faq {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg-soft);
}

.lx-faq-inner {
  max-width: var(--lx-container);
  margin-inline: auto;
  padding-inline: clamp(1.1rem, 4vw, 2rem);
}

/* Head */
.lx-faq-head {
  text-align: center;
  max-width: 640px;
  margin-inline: auto;
  margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
}

.lx-faq-eyebrow {
  display: inline-block;
  font-size: .75rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--lx-blue-ink);
  margin-bottom: .75rem;
}

.lx-faq-heading {
  font-family: var(--lx-display);
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 700;
  color: var(--lx-navy);
  line-height: 1.18;
  margin-bottom: .75rem;
}

.lx-faq-sub {
  font-size: 1.05rem;
  color: var(--lx-muted);
  line-height: 1.6;
}

/* Accordion list */
.lx-faq-list {
  max-width: 780px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* Individual item */
.lx-faq-item {
  border-bottom: 1px solid var(--lx-line);
  background: transparent;
}

.lx-faq-item:first-child {
  border-top: 1px solid var(--lx-line);
}

.lx-faq-item[open] {
  background: #fff;
  border-radius: var(--lx-r-sm);
  border-color: transparent;
  box-shadow: var(--lx-sh-sm);
  margin-block: 4px;
}

.lx-faq-item[open] + .lx-faq-item {
  border-top: 1px solid var(--lx-line);
}

/* Summary / question row */
.lx-faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.15rem 1.25rem;
  cursor: pointer;
  list-style: none;
  font-family: var(--lx-display);
  font-size: 1rem;
  font-weight: 600;
  color: var(--lx-navy);
  line-height: 1.45;
  transition: color var(--lx-dur) var(--lx-ease);
  user-select: none;
}

.lx-faq-q::-webkit-details-marker { display: none; }
.lx-faq-q::marker { display: none; }

.lx-faq-q:hover,
.lx-faq-item[open] .lx-faq-q {
  color: var(--lx-blue);
}

.lx-faq-q:focus-visible {
  outline: 2px solid var(--lx-blue);
  outline-offset: 2px;
  border-radius: var(--lx-r-sm);
}

/* Chevron icon */
.lx-faq-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--lx-blue-050);
  color: var(--lx-blue);
  transition: transform var(--lx-dur) var(--lx-ease), background var(--lx-dur) var(--lx-ease);
}

.lx-faq-icon svg {
  width: 14px;
  height: 14px;
  display: block;
}

.lx-faq-item[open] .lx-faq-icon {
  transform: rotate(180deg);
  background: var(--lx-blue-100);
}

/* Answer panel */
.lx-faq-a {
  padding: 0 1.25rem 1.25rem 1.25rem;
  font-size: .975rem;
  color: var(--lx-ink);
  line-height: 1.7;
}

.lx-faq-a p { margin: 0; }
.lx-faq-a p + p { margin-top: .6rem; }

/* Bottom CTA */
.lx-faq-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: .75rem 1.25rem;
  margin-top: clamp(2rem, 4vw, 3rem);
  padding: 1.5rem 2rem;
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r-lg);
  text-align: center;
}

.lx-faq-cta-text {
  margin: 0;
  font-size: .975rem;
  color: var(--lx-muted);
}

.lx-faq-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  font-family: var(--lx-display);
  font-size: .875rem;
  font-weight: 700;
  color: var(--lx-blue-ink);
  text-decoration: none;
  padding: .55rem 1.25rem;
  border: 2px solid var(--lx-blue);
  border-radius: var(--lx-pill);
  transition: background var(--lx-dur) var(--lx-ease), color var(--lx-dur) var(--lx-ease), transform var(--lx-dur) var(--lx-ease), box-shadow var(--lx-dur) var(--lx-ease);
}

.lx-faq-cta-btn:hover {
  background: var(--lx-blue);
  color: #fff;
  transform: translateY(-2px);
  box-shadow: var(--lx-sh-blue);
}

.lx-faq-cta-btn svg { display: block; }

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .lx-faq-icon { transition: none; }
  .lx-faq-cta-btn { transition: none; }
  .lx-faq-q { transition: none; }
}

/* Responsive */
@media (max-width: 520px) {
  .lx-faq-q { padding: 1rem; font-size: .95rem; }
  .lx-faq-a { padding: 0 1rem 1rem; }
  .lx-faq-cta { flex-direction: column; text-align: center; padding: 1.25rem 1rem; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "text", "id": "sub", "label": "Subtitle (optional)" },
    { "type": "header", "content": "Bottom CTA (optional)" },
    { "type": "text", "id": "cta_text", "label": "Text", "default": "Still have a question?" },
    { "type": "text", "id": "cta_btn_text", "label": "Button label", "default": "Get in touch" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Your answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "How long does UK delivery take?", "answer": "<p>Standard UK delivery arrives in 2–3 working days. Free on orders over £50.</p>" } },
        { "type": "faq", "settings": { "question": "Do you ship to the US?", "answer": "<p>Yes. We ship worldwide and handle all import duties at checkout — no surprise fees on delivery.</p>" } },
        { "type": "faq", "settings": { "question": "Are your supplements clinically backed?", "answer": "<p>All our supplements use ingredients with published clinical evidence and are recommended by fertility specialists in 40+ countries.</p>" } },
        { "type": "faq", "settings": { "question": "What's your returns policy?", "answer": "<p>30-day returns on unopened products. Reach out via Contact and we'll send a prepaid label.</p>" } }
      ]
    }
  ]
}
{% endschema %}
