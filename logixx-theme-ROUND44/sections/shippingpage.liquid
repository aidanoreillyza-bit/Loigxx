{%- comment -%}
  Shipping & Returns page — modern rebuild.
{%- endcomment -%}

<div class="lxs">

  <section class="lxs-hero">
    <div class="container">
      <span class="lxs-eyebrow">{{ section.settings.eyebrow | default: 'Shipping & Returns' }}</span>
      <h1 class="lxs-hero-title">{{ section.settings.heading | default: 'Worldwide delivery, no surprises' }}</h1>
      <p class="lxs-hero-lead">{{ section.settings.subheading | default: 'Fast, tracked shipping to over 40 countries. We handle duties at checkout wherever we can — so what you see is what you pay.' }}</p>
    </div>
  </section>

  {% if section.settings.show_globe %}
  <section class="lxs-globe globe-story" id="globe-story-{{ section.id }}"
           data-accent="{{ section.settings.globe_accent | default: '#00A2ED' }}"
           data-base="{{ section.settings.globe_base | default: '#EAF6FD' }}"
           data-geo="{{ 'world-countries-v1.json' | asset_url }}">
    <div class="globe-story__inner">
      <div class="globe-story__text">
        <span class="globe-story__eyebrow">{{ section.settings.globe_eyebrow | default: 'Our shipping network' }}</span>
        <h2 class="globe-story__heading">{{ section.settings.globe_heading | default: 'From our UK hub to your door.' }}</h2>
        <p class="globe-story__subtext">{{ section.settings.globe_subtext | default: 'Every order ships from our UK facility on tracked carriers, with duties handled at checkout wherever we can — so what you see is what you pay.' }}</p>
        <div class="globe-story__stats">
          <div class="globe-story__stat">
            <span class="globe-story__stat-number">{{ section.settings.globe_stat1_num | default: '40+' }}</span>
            <span class="globe-story__stat-label">{{ section.settings.globe_stat1_label | default: 'Countries shipped to' }}</span>
          </div>
          <div class="globe-story__stat">
            <span class="globe-story__stat-number">{{ section.settings.globe_stat2_num | default: '2–3' }}</span>
            <span class="globe-story__stat-label">{{ section.settings.globe_stat2_label | default: 'Day UK delivery' }}</span>
          </div>
          <div class="globe-story__stat">
            <span class="globe-story__stat-number">{{ section.settings.globe_stat3_num | default: '6' }}</span>
            <span class="globe-story__stat-label">{{ section.settings.globe_stat3_label | default: 'Continents served' }}</span>
          </div>
        </div>
        {% if section.settings.globe_btn_text != blank %}
          <a class="globe-story__cta" href="{{ section.settings.globe_btn_link | default: '#lxs-zones' }}">
            {{ section.settings.globe_btn_text }}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        {% endif %}
      </div>
      <div class="globe-story__visual">
        <div class="globe-story__canvas" id="globe-canvas-{{ section.id }}"></div>
      </div>
    </div>
  </section>
  {% endif %}
    <div class="container">
      <div class="lxs-trust-grid">
        <div class="lxs-trust-item"><i class="ph ph-truck"></i><div><strong>{{ section.settings.fact_1_title | default: 'Free UK over £50' }}</strong><span>{{ section.settings.fact_1_sub | default: '2–3 working days' }}</span></div></div>
        <div class="lxs-trust-item"><i class="ph ph-globe-hemisphere-west"></i><div><strong>{{ section.settings.fact_2_title | default: '40+ countries' }}</strong><span>{{ section.settings.fact_2_sub | default: 'Tracked worldwide' }}</span></div></div>
        <div class="lxs-trust-item"><i class="ph ph-receipt"></i><div><strong>{{ section.settings.fact_3_title | default: 'Duties at checkout' }}</strong><span>{{ section.settings.fact_3_sub | default: 'No surprise fees (DDP)' }}</span></div></div>
        <div class="lxs-trust-item"><i class="ph ph-package"></i><div><strong>{{ section.settings.fact_4_title | default: 'Same-day dispatch' }}</strong><span>{{ section.settings.fact_4_sub | default: 'Order before 2pm GMT' }}</span></div></div>
      </div>
    </div>
  </section>

  <section class="lxs-zones" id="lxs-zones">
    <div class="container">
      <div class="lxs-head">
        <span class="lxs-mini-eyebrow">{{ section.settings.zones_eyebrow | default: 'Where we ship' }}</span>
        <h2>{{ section.settings.zones_heading | default: 'Delivery by region' }}</h2>
      </div>
      <div class="lxs-zones-grid">
        {% for block in section.blocks %}
          {% if block.type == 'zone' %}
            <div class="lxs-zone" {{ block.shopify_attributes }}>
              <div class="lxs-zone-top">
                <span class="lxs-zone-flag">{{ block.settings.code }}</span>
                <h3>{{ block.settings.region }}</h3>
              </div>
              {% if block.settings.countries != blank %}<p class="lxs-zone-countries">{{ block.settings.countries }}</p>{% endif %}
              <ul class="lxs-zone-rows">
                <li><i class="ph ph-clock"></i><span>{{ block.settings.delivery_time }}</span></li>
                <li><i class="ph ph-tag"></i><span>{{ block.settings.cost }}</span></li>
                <li><i class="ph ph-receipt"></i><span>{{ block.settings.duties }}</span></li>
                <li><i class="ph ph-truck"></i><span>{{ block.settings.carrier }}</span></li>
              </ul>
              {% if block.settings.note != blank %}<p class="lxs-zone-note">{{ block.settings.note }}</p>{% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {% if section.settings.show_duties %}
    <section class="lxs-duties">
      <div class="container">
        <div class="lxs-duties-card">
          <div class="lxs-duties-icon"><i class="ph ph-info"></i></div>
          <div class="lxs-duties-text">
            <h2>{{ section.settings.duties_heading | default: 'Import duties & taxes, explained' }}</h2>
            <div class="rte">{{ section.settings.duties_body }}</div>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_returns %}
    <section class="lxs-returns">
      <div class="container">
        <div class="lxs-head">
          <span class="lxs-mini-eyebrow">{{ section.settings.returns_eyebrow | default: 'Returns & refunds' }}</span>
          <h2>{{ section.settings.returns_heading | default: 'Our returns policy' }}</h2>
          {% if section.settings.returns_sub != blank %}<p class="lxs-head-sub">{{ section.settings.returns_sub }}</p>{% endif %}
        </div>
        <div class="lxs-returns-grid">
          <div class="lxs-returns-card"><div class="lxs-returns-icon"><i class="ph ph-clock-countdown"></i></div><strong>14-day window</strong><p>14 days from delivery to request a return, in line with UK consumer law.</p></div>
          <div class="lxs-returns-card"><div class="lxs-returns-icon"><i class="ph ph-seal-check"></i></div><strong>Unopened &amp; sealed</strong><p>For hygiene and safety, we can only accept supplements that are unopened with their seal intact.</p></div>
          <div class="lxs-returns-card"><div class="lxs-returns-icon"><i class="ph ph-arrow-counter-clockwise"></i></div><strong>Fast refunds</strong><p>Once received and inspected, refunds are processed within 14 days.</p></div>
        </div>
        <div class="lxs-returns-detail rte">{{ section.settings.returns_body }}</div>
      </div>
    </section>
  {% endif %}

  {% assign faq_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'faq' %}{% assign faq_count = faq_count | plus: 1 %}{% endif %}{% endfor %}
  {% if faq_count > 0 %}
    <section class="lxs-faq">
      <div class="container">
        <div class="lxs-head">
          <span class="lxs-mini-eyebrow">{{ section.settings.faq_eyebrow | default: 'Common questions' }}</span>
          <h2>{{ section.settings.faq_heading | default: 'Shipping FAQs' }}</h2>
        </div>
        <div class="lxs-faq-list">
          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              <details class="lxs-faq-item" {{ block.shopify_attributes }}>
                <summary>
                  <span>{{ block.settings.question }}</span>
                  <span class="lxs-faq-plus"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
                </summary>
                <div class="lxs-faq-answer rte">{{ block.settings.answer }}</div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_closing %}
    <section class="lxs-closing">
      <div class="container">
        <div class="lxs-closing-card">
          <h2>{{ section.settings.closing_heading | default: 'Still have a question?' }}</h2>
          <p>{{ section.settings.closing_sub | default: 'Our team is happy to help with anything about delivery, duties or returns.' }}</p>
          {% if section.settings.closing_btn_text != blank %}
            <a href="{{ section.settings.closing_btn_link | default: '/pages/contact' }}" class="lxs-closing-btn">
              {{ section.settings.closing_btn_text }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

</div>

<script>
(function(){
  var faqs = document.querySelectorAll('.lxs-faq-item');
  faqs.forEach(function(faq){
    faq.addEventListener('toggle', function(){
      if (faq.open) faqs.forEach(function(o){ if (o !== faq) o.open = false; });
    });
  });
})();
</script>

{% if section.settings.show_globe %}
<script src="{{ 'globe-gl-v1.js' | asset_url }}" defer></script>
<script>
(function () {
  var sectionId = '{{ section.id }}';
  function boot() {
    var section = document.getElementById('globe-story-' + sectionId);
    var mount = document.getElementById('globe-canvas-' + sectionId);
    if (!section || !mount) return;
    if (typeof Globe === 'undefined') { return setTimeout(boot, 120); }
    if (mount.dataset.built === '1') return;
    mount.dataset.built = '1';

    var accent = section.dataset.accent || '#00A2ED';
    var base   = section.dataset.base   || '#EAF6FD';
    var geoUrl = section.dataset.geo;

    var HUB = { name: 'LogixX Fertility (UK Hub)', lat: 55.3781, lng: -3.4360, isHub: true };
    var destinations = [
      { name: 'Vancouver', lat: 49.2827, lng: -123.1207 },
      { name: 'Los Angeles', lat: 34.0522, lng: -118.2437 },
      { name: 'New York', lat: 40.7128, lng: -74.0060 },
      { name: 'Tokyo', lat: 35.6762, lng: 139.6503 },
      { name: 'Sydney', lat: -33.8688, lng: 151.2093 },
      { name: 'Cape Town', lat: -33.9249, lng: 18.4241 },
      { name: 'Rio de Janeiro', lat: -22.9068, lng: -43.1729 },
      { name: 'Dubai', lat: 25.2048, lng: 55.2708 },
      { name: 'Singapore', lat: 1.3521, lng: 103.8198 },
      { name: 'Paris', lat: 48.8566, lng: 2.3522 },
      { name: 'Mumbai', lat: 19.0760, lng: 72.8777 }
    ];
    var arcs = destinations.map(function (d) {
      return { startLat: HUB.lat, startLng: HUB.lng, endLat: d.lat, endLng: d.lng };
    });
    var points = [HUB].concat(destinations);

    function hexToRgba(hex, a) {
      var h = hex.replace('#', '');
      if (h.length === 3) h = h.split('').map(function (c) { return c + c; }).join('');
      var n = parseInt(h, 16);
      return 'rgba(' + ((n >> 16) & 255) + ',' + ((n >> 8) & 255) + ',' + (n & 255) + ',' + a + ')';
    }

    var world = Globe()(mount)
      .backgroundColor('rgba(0,0,0,0)')
      .showGlobe(true)
      .showAtmosphere(true)
      .atmosphereColor(accent)
      .atmosphereAltitude(0.16)
      .pointsData(points)
      .pointLat('lat').pointLng('lng')
      .pointColor(function (d) { return d.isHub ? accent : '#1B3A6B'; })
      .pointRadius(function (d) { return d.isHub ? 0.62 : 0.42; })
      .pointAltitude(0.012)
      .pointsMerge(false)
      .pointLabel(function (d) {
        var dot = d.isHub ? accent : '#1B3A6B';
        var ring = d.isHub ? hexToRgba(accent, 0.18) : 'rgba(27,58,107,0.16)';
        var sub = d.isHub ? '<span style="font-size:11px;font-weight:600;color:#7A8AA0;letter-spacing:0.06em;text-transform:uppercase;margin-top:3px;">UK Hub</span>' : '';
        return '<div style="display:flex;align-items:center;gap:10px;background:#fff;padding:10px 15px;border-radius:9px;border:1px solid #e2e8f0;box-shadow:0 12px 28px -8px rgba(15,23,42,0.22);font-family:-apple-system,BlinkMacSystemFont,sans-serif;white-space:nowrap;">'
          + '<span style="flex:none;width:8px;height:8px;border-radius:50%;background:' + dot + ';box-shadow:0 0 0 4px ' + ring + ';"></span>'
          + '<span style="display:flex;flex-direction:column;line-height:1.15;"><span style="font-size:13.5px;font-weight:600;color:#0f172a;">' + d.name + '</span>' + sub + '</span></div>';
      })
      .arcsData(arcs)
      .arcColor(function () { return [hexToRgba(accent, 0), hexToRgba(accent, 0.6), hexToRgba(accent, 0)]; })
      .arcAltitude(0.45).arcStroke(0.55)
      .arcDashLength(0.4).arcDashGap(0.6)
      .arcDashInitialGap(function () { return Math.random() * 3; })
      .arcDashAnimateTime(4000).arcsTransitionDuration(0)
      .ringsData(points)
      .ringColor(function (d) {
        var peak = d.isHub ? 0.34 : 0.18;
        return function (t) { return hexToRgba(accent, peak * (1 - t)); };
      })
      .ringMaxRadius(function (d) { return d.isHub ? 4 : 2.4; })
      .ringPropagationSpeed(1.2)
      .ringRepeatPeriod(function (d) { return d.isHub ? 1600 : (1800 + Math.random() * 2400); });

    var mat = world.globeMaterial();
    if (mat && mat.color && mat.color.set) { mat.color.set(base); }
    if (mat) { mat.transparent = false; mat.opacity = 1; }

    if (geoUrl) {
      fetch(geoUrl)
        .then(function (r) { if (!r.ok) throw new Error('geojson ' + r.status); return r.json(); })
        .then(function (geo) {
          world.hexPolygonsData(geo.features)
            .hexPolygonResolution(3).hexPolygonMargin(0.35)
            .hexPolygonUseDots(true)
            .hexPolygonColor(function () { return hexToRgba(accent, 0.35); });
        })
        .catch(function (e) { /* hex polygons optional */ });
    }

    var controls = world.controls();
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.3;
    controls.enableZoom = false;
    world.pointOfView({ lat: 30, lng: -10, altitude: 2.3 }, 0);

    function resize() {
      var w = mount.clientWidth || mount.offsetWidth;
      var h = mount.clientHeight || mount.offsetHeight;
      if (w && h) world.width(w).height(h);
    }
    resize();
    if (window.ResizeObserver) new ResizeObserver(resize).observe(mount);
    window.addEventListener('resize', resize);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Shipping Page",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shipping & Returns" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worldwide delivery, no surprises" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Fast, tracked shipping to over 40 countries. We handle duties at checkout wherever we can." },
    { "type": "header", "content": "Interactive globe" },
    { "type": "checkbox", "id": "show_globe", "label": "Show globe section", "default": true },
    { "type": "color", "id": "globe_accent", "label": "Globe accent colour", "default": "#00A2ED" },
    { "type": "color", "id": "globe_base", "label": "Globe sphere colour", "default": "#EAF6FD" },
    { "type": "text", "id": "globe_eyebrow", "label": "Eyebrow", "default": "Our shipping network" },
    { "type": "text", "id": "globe_heading", "label": "Heading", "default": "From our UK hub to your door." },
    { "type": "textarea", "id": "globe_subtext", "label": "Subtext", "default": "Every order ships from our UK facility on tracked carriers, with duties handled at checkout wherever we can — so what you see is what you pay." },
    { "type": "text", "id": "globe_stat1_num", "label": "Stat 1 number", "default": "40+" },
    { "type": "text", "id": "globe_stat1_label", "label": "Stat 1 label", "default": "Countries shipped to" },
    { "type": "text", "id": "globe_stat2_num", "label": "Stat 2 number", "default": "2–3" },
    { "type": "text", "id": "globe_stat2_label", "label": "Stat 2 label", "default": "Day UK delivery" },
    { "type": "text", "id": "globe_stat3_num", "label": "Stat 3 number", "default": "6" },
    { "type": "text", "id": "globe_stat3_label", "label": "Stat 3 label", "default": "Continents served" },
    { "type": "text", "id": "globe_btn_text", "label": "Button label", "default": "See delivery by region" },
    { "type": "text", "id": "globe_btn_link", "label": "Button link", "default": "#lxs-zones" },
    { "type": "header", "content": "Trust strip" },
    { "type": "text", "id": "fact_1_title", "label": "Fact 1 title", "default": "Free UK over £50" },
    { "type": "text", "id": "fact_1_sub", "label": "Fact 1 sub", "default": "2–3 working days" },
    { "type": "text", "id": "fact_2_title", "label": "Fact 2 title", "default": "40+ countries" },
    { "type": "text", "id": "fact_2_sub", "label": "Fact 2 sub", "default": "Tracked worldwide" },
    { "type": "text", "id": "fact_3_title", "label": "Fact 3 title", "default": "Duties at checkout" },
    { "type": "text", "id": "fact_3_sub", "label": "Fact 3 sub", "default": "No surprise fees (DDP)" },
    { "type": "text", "id": "fact_4_title", "label": "Fact 4 title", "default": "Same-day dispatch" },
    { "type": "text", "id": "fact_4_sub", "label": "Fact 4 sub", "default": "Order before 2pm GMT" },
    { "type": "header", "content": "Zones" },
    { "type": "text", "id": "zones_eyebrow", "label": "Eyebrow", "default": "Where we ship" },
    { "type": "text", "id": "zones_heading", "label": "Heading", "default": "Delivery by region" },
    { "type": "header", "content": "Duties explainer" },
    { "type": "checkbox", "id": "show_duties", "label": "Show duties section", "default": true },
    { "type": "text", "id": "duties_heading", "label": "Heading", "default": "Import duties & taxes, explained" },
    { "type": "richtext", "id": "duties_body", "label": "Body", "default": "<p>When ordering from outside the UK, your package may be subject to <strong>import duties, taxes, or VAT</strong> set by your country. These are government fees, not charges from LogixX.</p><p>Wherever possible we calculate and collect these at checkout (DDP), so there are no surprise charges on arrival.</p>" },
    { "type": "header", "content": "Returns & Refunds" },
    { "type": "checkbox", "id": "show_returns", "label": "Show returns section", "default": true },
    { "type": "text", "id": "returns_eyebrow", "label": "Eyebrow", "default": "Returns & refunds" },
    { "type": "text", "id": "returns_heading", "label": "Heading", "default": "Our returns policy" },
    { "type": "text", "id": "returns_sub", "label": "Subtitle" },
    { "type": "richtext", "id": "returns_body", "label": "Returns detail", "default": "<p><strong>How to return an item.</strong> Email us within 14 days of receiving your order, quoting your order number. We'll confirm whether your item qualifies and provide a return address.</p><p><strong>What we can accept.</strong> Because our products are dietary supplements, we can only accept returns of items that are unopened, unused and still sealed in their original packaging. This is a standard hygiene exemption under the UK Consumer Contracts Regulations 2013.</p><p><strong>Return postage.</strong> Unless your item is faulty or incorrect, you are responsible for the cost of returning it. We recommend a tracked service.</p><p><strong>Refunds.</strong> Once received and inspected, approved refunds are issued to your original payment method within 14 days.</p><p><strong>Faulty or incorrect items.</strong> If your order arrives damaged, faulty or incorrect, contact us within 14 days and we'll put it right at no cost to you. This does not affect your rights under the Consumer Rights Act 2015.</p>" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_eyebrow", "label": "Eyebrow", "default": "Common questions" },
    { "type": "text", "id": "faq_heading", "label": "Heading", "default": "Shipping FAQs" },
    { "type": "header", "content": "Closing CTA" },
    { "type": "checkbox", "id": "show_closing", "label": "Show closing CTA", "default": true },
    { "type": "text", "id": "closing_heading", "label": "Heading", "default": "Still have a question?" },
    { "type": "textarea", "id": "closing_sub", "label": "Subtext", "default": "Our team is happy to help with anything about delivery, duties or returns." },
    { "type": "text", "id": "closing_btn_text", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "closing_btn_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "zone",
      "name": "Shipping zone",
      "settings": [
        { "type": "text", "id": "code", "label": "Short code/label", "default": "UK" },
        { "type": "text", "id": "region", "label": "Region", "default": "United Kingdom" },
        { "type": "text", "id": "countries", "label": "Countries" },
        { "type": "text", "id": "delivery_time", "label": "Delivery time", "default": "2–3 working days" },
        { "type": "text", "id": "cost", "label": "Cost", "default": "Free over £50" },
        { "type": "text", "id": "duties", "label": "Duties", "default": "Included" },
        { "type": "text", "id": "carrier", "label": "Carrier", "default": "Royal Mail" },
        { "type": "textarea", "id": "note", "label": "Note" }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    { "name": "Shipping Page" }
  ]
}
{% endschema %}
