{%- comment -%}
  Footer — testhim-style layout. Editable in Customize → Footer.
{%- endcomment -%}

<footer class="footer">
  <div class="container">

    <div class="footer-top">

      {%- comment -%} BRAND + MISSION {%- endcomment -%}
      <div class="footer-brand">
        <a href="/" class="footer-logo-link">
          {% if section.settings.footer_logo != blank %}
            <img src="{{ section.settings.footer_logo | image_url: width: 500 }}" alt="{{ shop.name }}" class="footer-logo-img">
          {% else %}
            <span class="logo-bold">LogixX</span><span class="logo-light">Fertility</span>
          {% endif %}
        </a>
        <p class="footer-mission">{{ section.settings.tagline | default: 'Our mission is to create positive change in the world of fertility by providing guidance, education, science-backed supplements and ongoing support.' }}</p>
      </div>

      {%- comment -%} COLUMN 1 — Explore {%- endcomment -%}
      <div class="footer-col">
        <h3>{{ section.settings.col1_heading | default: 'Explore' }}</h3>
        <ul>
          <li><a href="{{ section.settings.col1_link1_url | default: '/' }}">{{ section.settings.col1_link1_text | default: 'Home' }}</a></li>
          <li><a href="{{ section.settings.col1_link2_url | default: '/pages/about' }}">{{ section.settings.col1_link2_text | default: 'Our story' }}</a></li>
          <li><a href="{{ section.settings.col1_link3_url | default: '/pages/fertility-team' }}">{{ section.settings.col1_link3_text | default: 'The team' }}</a></li>
          <li><a href="{{ section.settings.col1_link4_url | default: '/pages/contact' }}">{{ section.settings.col1_link4_text | default: 'Support' }}</a></li>
          <li><a href="{{ section.settings.col1_link5_url | default: '/collections/all' }}">{{ section.settings.col1_link5_text | default: 'Store' }}</a></li>
          {% if section.settings.col1_link6_text != blank %}<li><a href="{{ section.settings.col1_link6_url }}">{{ section.settings.col1_link6_text }}</a></li>{% endif %}
        </ul>
      </div>

      {%- comment -%} COLUMN 2 — Knowledge Base {%- endcomment -%}
      <div class="footer-col">
        <h3>{{ section.settings.col2_heading | default: 'Knowledge Base' }}</h3>
        <ul>
          <li><a href="{{ section.settings.col2_link1_url | default: '/pages/optimising-sperm-health' }}">{{ section.settings.col2_link1_text | default: 'Sperm DNA Fragmentation' }}</a></li>
          <li><a href="{{ section.settings.col2_link2_url | default: '/pages/punalpin' }}">{{ section.settings.col2_link2_text | default: 'Varicocele' }}</a></li>
          <li><a href="{{ section.settings.col2_link3_url | default: '/pages/fertility-tips' }}">{{ section.settings.col2_link3_text | default: 'Oxidative Stress' }}</a></li>
          {% if section.settings.col2_link4_text != blank %}<li><a href="{{ section.settings.col2_link4_url }}">{{ section.settings.col2_link4_text }}</a></li>{% endif %}
          {% if section.settings.col2_link5_text != blank %}<li><a href="{{ section.settings.col2_link5_url }}">{{ section.settings.col2_link5_text }}</a></li>{% endif %}
        </ul>
      </div>

      {%- comment -%} CTA + SOCIAL {%- endcomment -%}
      <div class="footer-cta">
        <h2>{{ section.settings.cta_heading | default: 'Start your fertility journey' }}</h2>
        <div class="social-links">
          <a href="{{ section.settings.instagram | default: 'https://instagram.com' }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/>
            </svg>
          </a>
          <a href="{{ section.settings.facebook | default: 'https://facebook.com' }}" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M14.5 8.5V6.8c0-.7.5-.9 1-.9h1.6V3.3l-2.3-.1c-2.5 0-3.4 1.6-3.4 3.3v2H9.2v2.7h2.2V21h3.1v-9.8h2.2l.4-2.7h-2.6z"/>
            </svg>
          </a>
          <a href="{{ section.settings.linkedin | default: 'https://linkedin.com' }}" aria-label="LinkedIn" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M6.2 9H3.6v9.4h2.6V9zM4.9 4.6a1.5 1.5 0 100 3 1.5 1.5 0 000-3zM20.4 18.4h-2.6v-4.6c0-1.1 0-2.5-1.5-2.5s-1.8 1.2-1.8 2.4v4.7h-2.6V9h2.5v1.3h.1c.3-.6 1.2-1.3 2.4-1.3 2.6 0 3.1 1.7 3.1 3.9v5.5z"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <div class="footer-bottom">
      <span class="footer-copy">
        {% if section.settings.copyright != blank %}{{ section.settings.copyright }}{% else %}© {{ 'now' | date: '%Y' }} LogixX Pharma Ltd{% endif %}
      </span>
      <nav class="footer-legal">
        <a href="{{ section.settings.legal1_url | default: '/policies/terms-of-service' }}">{{ section.settings.legal1_text | default: 'Terms & Conditions' }}</a>
        <a href="{{ section.settings.legal2_url | default: '/policies/privacy-policy' }}">{{ section.settings.legal2_text | default: 'Privacy Policy' }}</a>
        <a href="{{ section.settings.legal3_url | default: '/policies/refund-policy' }}">{{ section.settings.legal3_text | default: 'Cancellation Policy' }}</a>
      </nav>
    </div>

  </div>
</footer>

{% stylesheet %}
.footer{ background:var(--lx-navy); color:rgba(255,255,255,.7); padding-block:clamp(3rem,6vw,5rem) 2rem; }
.footer-top{ display:grid; grid-template-columns:1.6fr 1fr 1fr 1.4fr; gap:clamp(1.5rem,4vw,3rem); padding-bottom:clamp(2.5rem,5vw,3.5rem); border-bottom:1px solid rgba(255,255,255,.1); }
.footer-logo-link{ display:inline-flex; align-items:baseline; gap:.15rem; text-decoration:none; margin-bottom:1.1rem; font-family:var(--lx-display); font-size:1.5rem; }
.footer-logo-img{ max-height:38px; width:auto; }
.logo-bold{ color:#fff; font-weight:700; }
.logo-light{ color:var(--lx-blue); font-weight:700; }
.footer-mission{ font-size:.95rem; line-height:1.7; max-width:34ch; margin:0; color:rgba(255,255,255,.6); }
.footer-col h3{ color:#fff; font-family:var(--lx-display); font-size:1rem; margin:0 0 1.1rem; }
.footer-col ul{ list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:.7rem; }
.footer-col a{ color:rgba(255,255,255,.66); font-size:.93rem; text-decoration:none; transition:color var(--lx-dur), padding-left var(--lx-dur) var(--lx-ease); }
.footer-col a:hover{ color:#fff; padding-left:4px; }
.footer-cta h2{ color:#fff; font-size:1.4rem; margin:0 0 1.2rem; max-width:14ch; }
.social-links{ display:flex; gap:.6rem; }
.social-links a{ width:42px; height:42px; border-radius:50%; border:1px solid rgba(255,255,255,.18); display:inline-flex; align-items:center; justify-content:center; color:rgba(255,255,255,.8); transition:transform var(--lx-dur) var(--lx-ease), background var(--lx-dur), border-color var(--lx-dur), color var(--lx-dur); }
.social-links svg{ width:20px; height:20px; }
.social-links a:hover{ background:var(--lx-blue); border-color:var(--lx-blue); color:#fff; transform:translateY(-2px); }
.footer-bottom{ display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; padding-top:1.5rem; }
.footer-copy{ font-size:.85rem; color:rgba(255,255,255,.5); }
.footer-legal{ display:flex; gap:1.5rem; flex-wrap:wrap; }
.footer-legal a{ font-size:.85rem; color:rgba(255,255,255,.6); text-decoration:none; transition:color var(--lx-dur); }
.footer-legal a:hover{ color:#fff; }
@media (max-width:860px){ .footer-top{ grid-template-columns:1fr 1fr; } .footer-brand{ grid-column:1 / -1; } }
@media (max-width:520px){ .footer-top{ grid-template-columns:1fr; } .footer-bottom{ flex-direction:column; align-items:flex-start; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "footer_logo", "label": "Footer logo" },
    { "type": "textarea", "id": "tagline", "label": "Mission text", "default": "Our mission is to create positive change in the world of fertility by providing guidance, education, science-backed supplements and ongoing support." },
    { "type": "header", "content": "Column 1" },
    { "type": "text", "id": "col1_heading", "label": "Heading", "default": "Explore" },
    { "type": "text", "id": "col1_link1_text", "label": "Link 1", "default": "Home" },
    { "type": "url", "id": "col1_link1_url", "label": "Link 1 URL" },
    { "type": "text", "id": "col1_link2_text", "label": "Link 2", "default": "Our story" },
    { "type": "url", "id": "col1_link2_url", "label": "Link 2 URL" },
    { "type": "text", "id": "col1_link3_text", "label": "Link 3", "default": "The team" },
    { "type": "url", "id": "col1_link3_url", "label": "Link 3 URL" },
    { "type": "text", "id": "col1_link4_text", "label": "Link 4", "default": "Support" },
    { "type": "url", "id": "col1_link4_url", "label": "Link 4 URL" },
    { "type": "text", "id": "col1_link5_text", "label": "Link 5", "default": "Store" },
    { "type": "url", "id": "col1_link5_url", "label": "Link 5 URL" },
    { "type": "text", "id": "col1_link6_text", "label": "Link 6" },
    { "type": "url", "id": "col1_link6_url", "label": "Link 6 URL" },
    { "type": "header", "content": "Column 2" },
    { "type": "text", "id": "col2_heading", "label": "Heading", "default": "Knowledge Base" },
    { "type": "text", "id": "col2_link1_text", "label": "Link 1", "default": "Sperm DNA Fragmentation" },
    { "type": "url", "id": "col2_link1_url", "label": "Link 1 URL" },
    { "type": "text", "id": "col2_link2_text", "label": "Link 2", "default": "Varicocele" },
    { "type": "url", "id": "col2_link2_url", "label": "Link 2 URL" },
    { "type": "text", "id": "col2_link3_text", "label": "Link 3", "default": "Oxidative Stress" },
    { "type": "url", "id": "col2_link3_url", "label": "Link 3 URL" },
    { "type": "text", "id": "col2_link4_text", "label": "Link 4" },
    { "type": "url", "id": "col2_link4_url", "label": "Link 4 URL" },
    { "type": "text", "id": "col2_link5_text", "label": "Link 5" },
    { "type": "url", "id": "col2_link5_url", "label": "Link 5 URL" },
    { "type": "header", "content": "Call to action + social" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Start your fertility journey" },
    { "type": "url", "id": "account_link", "label": "Account link" },
    { "type": "url", "id": "podcast_link", "label": "Podcast link" },
    { "type": "url", "id": "email_link", "label": "Email link" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "linkedin", "label": "LinkedIn" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright", "label": "Copyright text" },
    { "type": "text", "id": "legal1_text", "label": "Legal link 1", "default": "Terms & Conditions" },
    { "type": "url", "id": "legal1_url", "label": "Legal link 1 URL" },
    { "type": "text", "id": "legal2_text", "label": "Legal link 2", "default": "Privacy Policy" },
    { "type": "url", "id": "legal2_url", "label": "Legal link 2 URL" },
    { "type": "text", "id": "legal3_text", "label": "Legal link 3", "default": "Cancellation Policy" },
