      "type": "vs_row",
      "name": "VS row",
      "settings": [
        { "type": "text", "id": "us", "label": "Us" },
        { "type": "text", "id": "them", "label": "Them" }
      ]
    },
    {
      "type": "specialist",
      "name": "Specialist",
      "settings": [
        { "type": "text", "id": "initials", "label": "Initials" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" }
      ]
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "location", "label": "Location" }
      ]
    },
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (unused)" },
        { "type": "text", "id": "title", "label": "Title" },
