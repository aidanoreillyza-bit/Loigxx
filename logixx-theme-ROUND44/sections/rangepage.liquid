{%- comment -%}
  Range / Comparison page — clean rebuild. Inline SVG icons, neutral tone.
  Blocks: product, compare_row, vs_row, specialist, testimonial, reason, faq.
{%- endcomment -%}

{%- comment -%} ===== Inline SVG icon set ===== {%- endcomment -%}
{%- capture icon_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{%- endcapture -%}
{%- capture icon_dash -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>{%- endcapture -%}
{%- capture icon_arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>{%- endcapture -%}
{%- capture icon_star -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg>{%- endcapture -%}

<div class="rng">

  {%- comment -%} ============ 1. HERO ============ {%- endcomment -%}
  <section class="rng-hero">
    <div class="rng-container">
      <span class="rng-eyebrow">{{ section.settings.hero_eyebrow | default: 'Compare the range' }}</span>
      <h1 class="rng-hero-title">{{ section.settings.hero_heading | default: 'Find your formula' }}</h1>
      <p class="rng-hero-lead">{{ section.settings.hero_sub | default: 'Two clinically-formulated options for male fertility. Compare them side by side and choose what fits your needs.' }}</p>
    </div>
  </section>

  {%- comment -%} ============ 2. PRODUCT CARDS ============ {%- endcomment -%}
  <section class="rng-products">
    <div class="rng-container">
      <div class="rng-products-grid">
        {% for block in section.blocks %}
          {% if block.type == 'product' %}
            <div class="rng-prod-card" {{ block.shopify_attributes }}>
              {% if block.settings.badge != blank %}<span class="rng-prod-badge">{{ block.settings.badge }}</span>{% endif %}
              {% if block.settings.eyebrow != blank %}<span class="rng-prod-eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
              <h3 class="rng-prod-title">{{ block.settings.title }}</h3>
              {% if block.settings.tagline != blank %}<p class="rng-prod-tagline">{{ block.settings.tagline }}</p>{% endif %}

              {% if block.settings.features != blank %}
                <ul class="rng-prod-features">
                  {% assign feats = block.settings.features | newline_to_br | split: '<br />' %}
                  {% for f in feats %}
                    {% assign ff = f | strip %}
                    {% if ff != blank %}<li><span class="rng-feat-check">{{ icon_check }}</span>{{ ff }}</li>{% endif %}
                  {% endfor %}
                </ul>
              {% endif %}

              <div class="rng-prod-price">
                <span class="rng-price">{{ block.settings.price }}</span>
                {% if block.settings.compare_price != blank %}<span class="rng-compare-price">{{ block.settings.compare_price }}</span>{% endif %}
              </div>
              {% if block.settings.subtitle != blank %}<p class="rng-prod-subtitle">{{ block.settings.subtitle }}</p>{% endif %}

              <div class="rng-prod-ctas">
                {% if block.settings.cta_text != blank %}
                  <a href="{{ block.settings.cta_link }}" class="rng-btn rng-btn--primary">{{ block.settings.cta_text }} <span class="rng-btn-arrow">{{ icon_arrow }}</span></a>
                {% endif %}
                {% if block.settings.cta2_text != blank %}
                  <a href="{{ block.settings.cta2_link }}" class="rng-btn rng-btn--ghost">{{ block.settings.cta2_text }}</a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {%- comment -%} ============ 3. COMPARISON TABLE ============ {%- endcomment -%}
  {% assign cr_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'compare_row' %}{% assign cr_count = cr_count | plus: 1 %}{% endif %}{% endfor %}
  {% if cr_count > 0 %}
    <section class="rng-compare">
      <div class="rng-container">
        <div class="rng-head">
          <span class="rng-mini-eyebrow">{{ section.settings.compare_eyebrow | default: 'Side by side' }}</span>
          <h2>{{ section.settings.compare_heading | default: 'How they compare' }}</h2>
        </div>

        <div class="rng-table">
          <div class="rng-table-header">
            <div class="rng-table-cell rng-table-cell--label"></div>
            <div class="rng-table-cell rng-table-col-head">{{ section.settings.col1_name | default: 'Proxeed Plus' }}</div>
            <div class="rng-table-cell rng-table-col-head">{{ section.settings.col2_name | default: 'Proxeed Men' }}</div>
          </div>
          {% for block in section.blocks %}
            {% if block.type == 'compare_row' %}
              <div class="rng-table-row" {{ block.shopify_attributes }}>
                <div class="rng-table-cell rng-table-cell--label">{{ block.settings.label }}</div>
                <div class="rng-table-cell">
                  {% if block.settings.col1_check %}<span class="rng-cell-check">{{ icon_check }}</span>{% endif %}
                  <span class="rng-cell-val">{{ block.settings.col1 }}</span>
                </div>
                <div class="rng-table-cell">
                  {% if block.settings.col2_check %}<span class="rng-cell-check">{{ icon_check }}</span>{% else %}{% if block.settings.col2 == '—' or block.settings.col2 == blank %}<span class="rng-cell-dash">{{ icon_dash }}</span>{% endif %}{% endif %}
                  <span class="rng-cell-val">{{ block.settings.col2 }}</span>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {%- comment -%} ============ 4. VS GENERIC ============ {%- endcomment -%}
  {% assign vs_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'vs_row' %}{% assign vs_count = vs_count | plus: 1 %}{% endif %}{% endfor %}
  {% if vs_count > 0 %}
    <section class="rng-vs">
      <div class="rng-container">
        <div class="rng-head">
          <span class="rng-mini-eyebrow">{{ section.settings.vs_eyebrow | default: 'Why Proxeed' }}</span>
          <h2>{{ section.settings.vs_heading | default: 'Proxeed vs generic supplements' }}</h2>
        </div>
        <div class="rng-vs-cols">
          <div class="rng-vs-head rng-vs-head--us">{{ section.settings.vs_us_label | default: 'Proxeed' }}</div>
          <div class="rng-vs-head rng-vs-head--them">{{ section.settings.vs_them_label | default: 'Generic supplements' }}</div>
        </div>
        {% for block in section.blocks %}
          {% if block.type == 'vs_row' %}
            <div class="rng-vs-row" {{ block.shopify_attributes }}>
              <div class="rng-vs-cell rng-vs-cell--us"><span class="rng-vs-icon rng-vs-icon--yes">{{ icon_check }}</span>{{ block.settings.us }}</div>
              <div class="rng-vs-cell rng-vs-cell--them"><span class="rng-vs-icon rng-vs-icon--no">{{ icon_dash }}</span>{{ block.settings.them }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {%- comment -%} ============ 5. SPECIALISTS ============ {%- endcomment -%}
  {% assign sp_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'specialist' %}{% assign sp_count = sp_count | plus: 1 %}{% endif %}{% endfor %}
  {% if sp_count > 0 %}
    <section class="rng-specialists">
      <div class="rng-container">
        <div class="rng-head">
          <span class="rng-mini-eyebrow">{{ section.settings.sp_eyebrow | default: 'Expert opinion' }}</span>
          <h2>{{ section.settings.sp_heading | default: 'What specialists say' }}</h2>
        </div>
        <div class="rng-sp-grid">
          {% for block in section.blocks %}
            {% if block.type == 'specialist' %}
              <div class="rng-sp-card" {{ block.shopify_attributes }}>
                <p class="rng-sp-quote">"{{ block.settings.quote }}"</p>
                <div class="rng-sp-person">
                  <span class="rng-sp-avatar">{{ block.settings.initials }}</span>
                  <div class="rng-sp-meta"><strong>{{ block.settings.name }}</strong><span>{{ block.settings.role }}</span></div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {%- comment -%} ============ 6. TESTIMONIALS + REASONS ============ {%- endcomment -%}
  {% assign t_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'testimonial' %}{% assign t_count = t_count | plus: 1 %}{% endif %}{% endfor %}
  {% if t_count > 0 %}
    <section class="rng-testimonials">
      <div class="rng-container">
        <div class="rng-head">
          <span class="rng-mini-eyebrow">{{ section.settings.t_eyebrow | default: 'Real stories' }}</span>
          <h2>{{ section.settings.t_heading | default: 'From couples like you' }}</h2>
        </div>
        <div class="rng-t-grid">
          {% for block in section.blocks %}
            {% if block.type == 'testimonial' %}
              <div class="rng-t-card" {{ block.shopify_attributes }}>
                <div class="rng-t-stars">{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}</div>
                <p class="rng-t-quote">"{{ block.settings.quote }}"</p>
                <div class="rng-t-meta"><strong>{{ block.settings.name }}</strong>{% if block.settings.location != blank %}<span>{{ block.settings.location }}</span>{% endif %}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% assign r_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'reason' %}{% assign r_count = r_count | plus: 1 %}{% endif %}{% endfor %}
  {% if r_count > 0 %}
    <section class="rng-reasons">
      <div class="rng-container">
        <div class="rng-head">
          <span class="rng-mini-eyebrow">{{ section.settings.r_eyebrow | default: 'Why choose us' }}</span>
          <h2>{{ section.settings.r_heading | default: 'Trusted worldwide' }}</h2>
        </div>
        <div class="rng-reasons-grid">
          {% for block in section.blocks %}
            {% if block.type == 'reason' %}
              <div class="rng-reason" {{ block.shopify_attributes }}>
                <div class="rng-reason-icon">{{ icon_check }}</div>
                <strong>{{ block.settings.title }}</strong>
                <p>{{ block.settings.description }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {%- comment -%} ============ 7. FAQ + CTA ============ {%- endcomment -%}
  {% assign fq_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'faq' %}{% assign fq_count = fq_count | plus: 1 %}{% endif %}{% endfor %}
  {% if fq_count > 0 %}
    <section class="rng-faq">
      <div class="rng-container">
        <div class="rng-head">
          <span class="rng-mini-eyebrow">{{ section.settings.fq_eyebrow | default: 'Questions' }}</span>
          <h2>{{ section.settings.fq_heading | default: 'Frequently asked' }}</h2>
        </div>
        <div class="rng-faq-list">
          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              <details class="rng-faq-item" {{ block.shopify_attributes }}>
                <summary><span>{{ block.settings.question }}</span><span class="rng-faq-plus">{{ icon_arrow }}</span></summary>
                <div class="rng-faq-answer rte">{{ block.settings.answer }}</div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <section class="rng-cta">
    <div class="rng-container">
      <div class="rng-cta-card">
        <h2>{{ section.settings.cta_heading | default: 'Ready to start?' }}</h2>
        <p>{{ section.settings.cta_sub | default: 'Begin your fertility journey with a clinically-formulated supplement trusted by specialists worldwide.' }}</p>
        <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="rng-btn rng-btn--light">{{ section.settings.cta_btn | default: 'Shop the range' }} <span class="rng-btn-arrow">{{ icon_arrow }}</span></a>
      </div>
    </div>
  </section>

</div>

<script>
(function(){
  var faqs = document.querySelectorAll('.rng-faq-item');
  faqs.forEach(function(f){
    f.addEventListener('toggle', function(){
      if (f.open) faqs.forEach(function(o){ if (o !== f) o.open = false; });
    });
  });
})();
</script>

{% stylesheet %}
.rng{ font-family:var(--lx-body); }
.rng-container{ max-width:1200px; margin-inline:auto; padding-inline:clamp(1.1rem,4vw,2rem); }
.rng-hero{ padding-block:clamp(4rem,8vw,6.5rem); background:var(--lx-bg-soft); border-bottom:1px solid var(--lx-line); text-align:center; }
.rng-eyebrow{ display:block; text-transform:uppercase; letter-spacing:.14em; font-size:.78rem; font-weight:700; color:var(--lx-blue-ink); margin-bottom:.9rem; }
.rng-hero-title{ font-family:var(--lx-display); font-size:clamp(2rem,5vw,3.5rem); color:var(--lx-navy); margin:0 0 1rem; }
.rng-hero-lead{ color:var(--lx-muted); font-size:1.05rem; max-width:52ch; margin-inline:auto; line-height:1.7; }
.rng-head{ text-align:center; max-width:560px; margin:0 auto 3rem; }
.rng-mini-eyebrow{ display:block; text-transform:uppercase; letter-spacing:.14em; font-size:.78rem; font-weight:700; color:var(--lx-blue-ink); margin-bottom:.6rem; }
.rng-head h2{ margin:.4rem 0 0; font-size:clamp(1.5rem,3.5vw,2.1rem); color:var(--lx-navy); }
.rng-products{ padding-block:clamp(3.5rem,7vw,6rem); background:#fff; }
.rng-products-grid{ display:grid; grid-template-columns:1fr 1fr; gap:1.75rem; }
.rng-prod-card{ position:relative; background:#fff; border:1.5px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:2.5rem 2rem; display:flex; flex-direction:column; gap:.5rem; box-shadow:var(--lx-sh); transition:box-shadow var(--lx-dur), transform var(--lx-dur), border-color var(--lx-dur); }
.rng-prod-card:hover{ transform:translateY(-4px); box-shadow:var(--lx-sh-lg); }
.rng-prod-card:first-child{ border-color:var(--lx-blue); }
.rng-prod-badge{ position:absolute; top:-12px; left:50%; transform:translateX(-50%); background:var(--lx-blue); color:#fff; font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; padding:.3rem 1rem; border-radius:var(--lx-pill); white-space:nowrap; }
.rng-prod-eyebrow{ display:block; text-transform:uppercase; letter-spacing:.12em; font-size:.75rem; font-weight:700; color:var(--lx-blue-ink); margin-bottom:.25rem; }
.rng-prod-title{ font-family:var(--lx-display); font-size:clamp(1.4rem,3vw,2rem); color:var(--lx-navy); margin:0 0 .4rem; }
.rng-prod-tagline{ font-size:.92rem; color:var(--lx-muted); margin:0 0 1rem; line-height:1.55; }
.rng-prod-features{ list-style:none; padding:0; margin:0 0 1.5rem; display:flex; flex-direction:column; gap:.55rem; }
.rng-prod-features li{ display:flex; align-items:flex-start; gap:.6rem; font-size:.9rem; color:var(--lx-ink); line-height:1.45; }
.rng-feat-check{ width:18px; height:18px; flex:none; color:var(--lx-blue); display:flex; margin-top:1px; }
.rng-feat-check svg{ width:18px; height:18px; }
.rng-prod-price{ display:flex; align-items:baseline; gap:.75rem; margin-top:auto; padding-top:1rem; border-top:1px solid var(--lx-line); }
.rng-price{ font-family:var(--lx-display); font-size:1.6rem; color:var(--lx-navy); }
.rng-compare-price{ font-size:.95rem; color:var(--lx-faint); text-decoration:line-through; }
.rng-prod-subtitle{ font-size:.8rem; color:var(--lx-muted); margin:0; }
.rng-prod-ctas{ display:flex; gap:.75rem; flex-wrap:wrap; margin-top:1.25rem; }
.rng-btn{ display:inline-flex; align-items:center; gap:.5rem; padding:.75rem 1.5rem; border-radius:var(--lx-pill); font-weight:700; font-size:.9rem; text-decoration:none; transition:background var(--lx-dur), transform var(--lx-dur), color var(--lx-dur), border-color var(--lx-dur); }
.rng-btn--primary{ background:var(--lx-blue); color:#fff; }
.rng-btn--primary:hover{ background:var(--lx-blue-700); transform:translateY(-2px); }
.rng-btn--ghost{ background:transparent; color:var(--lx-blue-ink); border:1.5px solid var(--lx-blue); }
.rng-btn--ghost:hover{ background:var(--lx-blue-050); }
.rng-btn-arrow{ display:flex; }
.rng-btn-arrow svg{ width:14px; height:14px; }
.rng-compare{ padding-block:clamp(3rem,6vw,5rem); background:var(--lx-bg-soft); border-top:1px solid var(--lx-line); }
.rng-table{ border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); overflow:hidden; background:#fff; }
.rng-table-header,.rng-table-row{ display:grid; grid-template-columns:1fr 1fr 1fr; }
.rng-table-header{ background:var(--lx-navy); }
.rng-table-cell{ padding:.9rem 1.25rem; border-right:1px solid var(--lx-line); font-size:.9rem; color:var(--lx-muted); }
.rng-table-header .rng-table-cell{ color:#fff; border-color:rgba(255,255,255,.1); }
.rng-table-col-head{ font-weight:700; font-size:.88rem; text-transform:uppercase; letter-spacing:.08em; }
.rng-table-cell--label{ font-weight:600; color:var(--lx-navy); }
.rng-table-row:nth-child(even){ background:var(--lx-bg-soft); }
.rng-table-row:not(:last-child){ border-bottom:1px solid var(--lx-line); }
.rng-cell-check{ color:var(--lx-blue); display:inline-flex; width:18px; height:18px; vertical-align:middle; margin-right:.35rem; }
.rng-cell-check svg,.rng-cell-dash svg{ width:16px; height:16px; }
.rng-cell-dash{ color:var(--lx-faint); display:inline-flex; width:18px; height:18px; vertical-align:middle; margin-right:.35rem; }
.rng-cell-val{ vertical-align:middle; font-size:.88rem; }
.rng-vs{ padding-block:clamp(3rem,6vw,5rem); background:#fff; }
.rng-vs-cols{ display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1rem; }
.rng-vs-head{ padding:.6rem 1.25rem; border-radius:var(--lx-r) var(--lx-r) 0 0; font-weight:700; font-size:.85rem; text-align:center; }
.rng-vs-head--us{ background:var(--lx-blue); color:#fff; }
.rng-vs-head--them{ background:var(--lx-bg-soft); color:var(--lx-muted); border:1px solid var(--lx-line); }
.rng-vs-row{ display:grid; grid-template-columns:1fr 1fr; gap:1rem; padding:.15rem 0; }
.rng-vs-cell{ padding:.8rem 1.25rem; font-size:.9rem; display:flex; align-items:flex-start; gap:.6rem; line-height:1.5; }
.rng-vs-cell--us{ background:var(--lx-blue-050); border:1px solid var(--lx-blue-100); border-radius:var(--lx-r); color:var(--lx-ink); }
.rng-vs-cell--them{ background:var(--lx-bg-soft); border:1px solid var(--lx-line); border-radius:var(--lx-r); color:var(--lx-muted); }
.rng-vs-icon{ width:18px; height:18px; flex:none; display:flex; margin-top:2px; }
.rng-vs-icon svg{ width:16px; height:16px; }
.rng-vs-icon--yes{ color:var(--lx-blue); }
.rng-vs-icon--no{ color:var(--lx-faint); }
.rng-specialists{ padding-block:clamp(3rem,6vw,5rem); background:var(--lx-bg-soft); border-top:1px solid var(--lx-line); }
.rng-sp-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:1.25rem; }
.rng-sp-card{ background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:1.75rem; }
.rng-sp-quote{ color:var(--lx-ink); font-size:.95rem; line-height:1.65; margin:0 0 1.5rem; font-style:italic; }
.rng-sp-person{ display:flex; align-items:center; gap:.85rem; }
.rng-sp-avatar{ width:44px; height:44px; background:var(--lx-blue-050); border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:var(--lx-display); font-weight:700; font-size:.9rem; color:var(--lx-blue-ink); flex:none; }
.rng-sp-meta strong{ display:block; font-size:.9rem; color:var(--lx-navy); }
.rng-sp-meta span{ font-size:.8rem; color:var(--lx-muted); }
.rng-testimonials{ padding-block:clamp(3rem,6vw,5rem); background:#fff; }
.rng-t-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:1.25rem; }
.rng-t-card{ background:var(--lx-bg-soft); border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:1.75rem; }
.rng-t-stars{ display:flex; gap:.2rem; color:var(--lx-star); margin-bottom:.85rem; }
.rng-t-stars svg{ width:16px; height:16px; }
.rng-t-quote{ color:var(--lx-ink); font-size:.92rem; line-height:1.65; margin:0 0 1.25rem; }
.rng-t-meta strong{ display:block; font-size:.88rem; color:var(--lx-navy); }
.rng-t-meta span{ font-size:.8rem; color:var(--lx-muted); }
.rng-reasons{ padding-block:clamp(3rem,6vw,5rem); background:var(--lx-bg-soft); border-top:1px solid var(--lx-line); }
.rng-reasons-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:1.25rem; }
.rng-reason{ background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:1.5rem; }
.rng-reason-icon{ width:36px; height:36px; background:var(--lx-blue-050); border-radius:10px; display:flex; align-items:center; justify-content:center; color:var(--lx-blue); margin-bottom:.9rem; }
.rng-reason-icon svg{ width:18px; height:18px; }
.rng-reason strong{ display:block; font-size:.95rem; color:var(--lx-navy); margin-bottom:.4rem; }
.rng-reason p{ font-size:.85rem; color:var(--lx-muted); margin:0; line-height:1.55; }
@media(max-width:860px){ .rng-products-grid{ grid-template-columns:1fr; } .rng-table-header,.rng-table-row{ grid-template-columns:1fr 1fr 1fr; } }
@media(max-width:520px){ .rng-table-header,.rng-table-row{ grid-template-columns:1fr 1fr; } .rng-table-header .rng-table-cell:last-child,.rng-table-row .rng-table-cell:last-child{ display:none; } .rng-vs-cols,.rng-vs-row{ grid-template-columns:1fr; gap:.5rem; } }
{% endstylesheet %}

{% schema %}
{
