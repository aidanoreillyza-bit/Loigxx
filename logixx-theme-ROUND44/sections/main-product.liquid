<section class="lx-product">
  <div class="container">

    <!-- Product header (mobile only — title on top) -->
    <div class="lx-product-mobile-head">
      <h1>{{ product.title }}</h1>
      {% if product.description != blank %}
        <p>{{ product.description | strip_html | truncatewords: 20 }}</p>
      {% endif %}
    </div>

    <div class="lx-product-grid">

      <!-- ============= IMAGE GALLERY ============= -->
      <div class="lx-product-gallery">
        <div class="lx-gallery-stage" id="lx-gallery-{{ section.id }}">
          {% if product.images.size > 0 %}
            {% for image in product.images %}
              <div class="lx-gallery-slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
                <img src="{{ image | image_url: width: 1400 }}" alt="{{ image.alt | default: product.title }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              </div>
            {% endfor %}
          {% else %}
            <div class="lx-gallery-slide is-active">
              <div class="lx-gallery-placeholder"><i class="ph ph-image"></i></div>
            </div>
          {% endif %}

          {% if product.images.size > 1 %}
            <button type="button" class="lx-gallery-arrow lx-gallery-arrow--prev" aria-label="Previous image">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" class="lx-gallery-arrow lx-gallery-arrow--next" aria-label="Next image">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"/></svg>
            </button>

            <div class="lx-gallery-dots">
              {% for image in product.images %}
                <button type="button" class="lx-gallery-dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}"></button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      <!-- ============= FEATURE HEX TILES ============= -->
      {% if section.blocks.size > 0 %}
        {% assign feature_count = 0 %}
        {% for block in section.blocks %}{% if block.type == 'feature' %}{% assign feature_count = feature_count | plus: 1 %}{% endif %}{% endfor %}
        {% if feature_count > 0 %}
          <div class="lx-product-features">
            {% for block in section.blocks %}
              {% if block.type == 'feature' %}
                <div class="lx-feature-tile" {{ block.shopify_attributes }}>
                  <div class="lx-feature-icon">
                    <i class="{{ block.settings.icon | default: 'ph ph-shield-check' }}"></i>
                  </div>
                  <div class="lx-feature-text">
                    <strong>{{ block.settings.title }}</strong>
                    {% if block.settings.subtitle != blank %}<span>{{ block.settings.subtitle }}</span>{% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}

      <!-- ============= DETAILS PANEL ============= -->
      <div class="lx-product-details">

        <!-- Title (desktop) -->
        <div class="lx-product-head">
          {% if product.vendor != blank %}<span class="lx-product-vendor">{{ product.vendor }}</span>{% endif %}
          <h1>{{ product.title }}</h1>
          {% if product.description != blank %}
            <p class="lx-product-tagline">{{ product.description | strip_html | truncatewords: 25 }}</p>
          {% endif %}
        </div>

        <!-- Tag pills -->
        {% assign tag_count = 0 %}
        {% for block in section.blocks %}{% if block.type == 'tag' %}{% assign tag_count = tag_count | plus: 1 %}{% endif %}{% endfor %}
        {% if tag_count > 0 %}
          <div class="lx-product-tags">
            {% for block in section.blocks %}
              {% if block.type == 'tag' %}
                <span class="lx-pill" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <!-- ADD TO CART FORM -->
        {%- form 'product', product, id: 'lx-product-form', class: 'lx-product-form' -%}
          <input type="hidden" name="return_to" value="/cart">

          <!-- Variant selector (rich radios with images) -->
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="lx-variant-group" data-option="option{{ forloop.index }}">
                <label class="lx-variant-label">{{ option.name }}</label>
                <div class="lx-variant-options">
                  {%- for value in option.values -%}
                    {%- assign is_selected = false -%}
                    {%- if option.selected_value == value -%}{%- assign is_selected = true -%}{%- endif -%}
                    <label class="lx-variant-option{% if is_selected %} is-selected{% endif %}">
                      <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if is_selected %}checked{% endif %}>
                      {%- if forloop.index <= 4 and product.images[forloop.index0] -%}
                        <span class="lx-variant-thumb">
                          <img src="{{ product.images[forloop.index0] | image_url: width: 80 }}" alt="{{ value }}">
                        </span>
                      {%- endif -%}
                      <span class="lx-variant-text">{{ value }}</span>
                      <span class="lx-variant-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <!-- Variant ID hidden input -->
          <select name="id" class="lx-variant-select" hidden>
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} data-price="{{ variant.price | money }}" data-compare="{{ variant.compare_at_price | money }}" data-available="{{ variant.available }}">{{ variant.title }}</option>
            {%- endfor -%}
          </select>

          <!-- Price block -->
          <div class="lx-product-price-block">
            <div class="lx-product-price">
              <span class="lx-price-current">{{ product.selected_or_first_available_variant.price | money }}</span>
              {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
                <span class="lx-price-compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
                {% assign discount = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | times: 100.0 | divided_by: product.selected_or_first_available_variant.compare_at_price | round %}
                <span class="lx-price-save">Save {{ discount }}%</span>
              {% endif %}
            </div>
          </div>

          <!-- Quantity -->
          <div class="lx-quantity">
            <label>Quantity</label>
            <div class="lx-qty-control">
              <button type="button" class="lx-qty-btn" data-action="decrement" aria-label="Decrease quantity"><svg width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
              <input type="number" name="quantity" value="1" min="1" class="lx-qty-input" aria-label="Quantity">
              <button type="button" class="lx-qty-btn" data-action="increment" aria-label="Increase quantity"><svg width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
            </div>
          </div>

          <!-- Add to cart -->
          <button type="submit" name="add" class="lx-add-btn" {% unless product.available %}disabled{% endunless %}>
            <span class="lx-add-btn-text">{% if product.available %}Add to basket{% else %}Sold out{% endif %}</span>
            {% if product.available %}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            {% endif %}
          </button>

          {% if section.settings.show_secondary_btn %}
            <button type="button" class="lx-add-btn lx-add-btn--secondary" onclick="window.location.href='{{ section.settings.secondary_btn_link }}'">
              {{ section.settings.secondary_btn_text }}
            </button>
            {% if section.settings.secondary_btn_sub != blank %}
              <p class="lx-secondary-sub">{{ section.settings.secondary_btn_sub }}</p>
            {% endif %}
          {% endif %}

        {%- endform -%}

        {% if section.settings.show_trust %}
          <div class="lx-product-trust">
            <div class="lx-trust-sig"><i class="ph ph-lock-simple"></i><span>{{ section.settings.trust_1 | default: 'Secure checkout' }}</span></div>
            <div class="lx-trust-sig"><i class="ph ph-truck"></i><span>{{ section.settings.trust_2 | default: 'Same-day dispatch before 2pm' }}</span></div>
            <div class="lx-trust-sig"><i class="ph ph-shield-check"></i><span>{{ section.settings.trust_3 | default: '14-day returns on sealed items' }}</span></div>
          </div>
        {% endif %}

        <!-- Delivery info rows -->
        {% assign info_count = 0 %}
        {% for block in section.blocks %}{% if block.type == 'info_row' %}{% assign info_count = info_count | plus: 1 %}{% endif %}{% endfor %}
        {% if info_count > 0 %}
          <div class="lx-product-info-rows">
            {% for block in section.blocks %}
              {% if block.type == 'info_row' %}
                <div class="lx-info-row" {{ block.shopify_attributes }}>
                  <div class="lx-info-icon"><i class="{{ block.settings.icon | default: 'ph ph-truck' }}"></i></div>
                  <div class="lx-info-text">
                    <strong>{{ block.settings.title }}</strong>
                    {% if block.settings.subtitle != blank %}<span>{{ block.settings.subtitle }}</span>{% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

      </div>
    </div>

  </div>
</section>

{%- comment -%} ===== RELATED PRODUCTS (cross-sell) ===== {%- endcomment -%}
{% if section.settings.show_related %}
  <section class="lx-related" data-product-id="{{ product.id }}" data-limit="{{ section.settings.related_count | default: 4 }}">
    <div class="container">
      <div class="lx-related-head">
        <span class="lx-related-eyebrow">{{ section.settings.related_eyebrow | default: 'You may also like' }}</span>
        <h2>{{ section.settings.related_heading | default: 'Complete your routine' }}</h2>
      </div>
      <div class="lx-related-grid" id="lx-related-grid-{{ section.id }}">
        {%- comment -%} Populated by Shopify product recommendations API {%- endcomment -%}
      </div>
    </div>
  </section>
{% endif %}
<div class="lx-sticky-atc" id="lx-sticky-atc" aria-hidden="true">
  <div class="lx-sticky-atc-info">
    <span class="lx-sticky-atc-title">{{ product.title }}</span>
    <span class="lx-sticky-atc-price">{{ product.price | money }}</span>
  </div>
  <button type="button" class="lx-sticky-atc-btn" id="lx-sticky-atc-btn" {% unless product.available %}disabled{% endunless %}>
    {% if product.available %}Add to basket{% else %}Sold out{% endif %}
  </button>
</div>

<script>
(function(){
  // Gallery
  var gallery = document.getElementById('lx-gallery-{{ section.id }}');
  if (gallery) {
    var slides = gallery.querySelectorAll('.lx-gallery-slide');
    var dots = gallery.querySelectorAll('.lx-gallery-dot');
    var prev = gallery.querySelector('.lx-gallery-arrow--prev');
    var next = gallery.querySelector('.lx-gallery-arrow--next');
    var current = 0;
    var autoTimer = null;
    var autoMs = {{ section.settings.gallery_autoplay_seconds | default: 4 | times: 1000 }};
    var autoplay = {{ section.settings.gallery_autoplay | default: true }};
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function show(idx){
      current = (idx + slides.length) % slides.length;
      slides.forEach(function(s, i){ s.classList.toggle('is-active', i === current); });
      dots.forEach(function(d, i){ d.classList.toggle('is-active', i === current); });
    }
    function startAuto(){
      if (!autoplay || reduce || slides.length < 2) return;
      stopAuto();
      autoTimer = setInterval(function(){ show(current + 1); }, autoMs);
    }
    function stopAuto(){ if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } }
    function userShow(idx){ show(idx); startAuto(); } // reset timer after manual nav

    if (prev) prev.addEventListener('click', function(){ userShow(current - 1); });
    if (next) next.addEventListener('click', function(){ userShow(current + 1); });
    dots.forEach(function(d, i){ d.addEventListener('click', function(){ userShow(i); }); });

    // Pause on hover (desktop)
    gallery.addEventListener('mouseenter', stopAuto);
    gallery.addEventListener('mouseleave', startAuto);

    // Touch swipe
    var startX = null;
    gallery.addEventListener('touchstart', function(e){ startX = e.touches[0].clientX; stopAuto(); }, { passive: true });
    gallery.addEventListener('touchend', function(e){
      if (startX === null) return;
      var diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) show(current + (diff > 0 ? 1 : -1));
      startX = null;
      startAuto();
    }, { passive: true });

    startAuto();
  }

  // Variant radios — visual selection
  document.querySelectorAll('.lx-variant-option input').forEach(function(input){
    input.addEventListener('change', function(){
      var group = input.closest('.lx-variant-options');
      group.querySelectorAll('.lx-variant-option').forEach(function(o){ o.classList.remove('is-selected'); });
      input.closest('.lx-variant-option').classList.add('is-selected');
      updateVariant();
    });
  });

  // Update selected variant from option radios
  function updateVariant(){
    var form = document.getElementById('lx-product-form');
    if (!form) return;
    var selectedOptions = [];
    form.querySelectorAll('.lx-variant-group').forEach(function(group){
      var checked = group.querySelector('input:checked');
      if (checked) selectedOptions.push(checked.value);
    });
    var select = form.querySelector('.lx-variant-select');
    var matched = null;
    Array.from(select.options).forEach(function(opt){
      var titleParts = opt.text.split(' / ');
      var match = selectedOptions.every(function(v, i){ return titleParts[i] && titleParts[i].trim() === v.trim(); });
      if (match) matched = opt;
    });
    if (matched) {
      select.value = matched.value;
      var priceEl = document.querySelector('.lx-price-current');
      var compareEl = document.querySelector('.lx-price-compare');
      if (priceEl) priceEl.textContent = matched.dataset.price;
      if (compareEl) {
        if (matched.dataset.compare && matched.dataset.compare !== matched.dataset.price && matched.dataset.compare !== '') {
          compareEl.textContent = matched.dataset.compare;
          compareEl.style.display = '';
        } else {
          compareEl.style.display = 'none';
        }
      }
    }
  }

  // Quantity controls
  document.querySelectorAll('.lx-qty-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var input = btn.parentElement.querySelector('input');
      var v = parseInt(input.value, 10) || 1;
      if (btn.dataset.action === 'increment') input.value = v + 1;
      else input.value = Math.max(1, v - 1);
    });
  });

  // ---- AJAX Add to Cart ----
  function lxAddToCart(formEl, btnEl) {
    if (!formEl || !btnEl) return;
    var originalText = btnEl.textContent.trim();
    btnEl.disabled = true;
    btnEl.textContent = 'Adding…';

    var data = new FormData(formEl);
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      body: data
    })
    .then(function(r) { return r.json(); })
    .then(function(item) {
      btnEl.textContent = '✓ Added';
      lxShowToast(item.product_title || 'Item added to basket');
      // Update cart badge count
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          var badge = document.querySelector('.cart-badge');
          if (badge) {
            badge.textContent = cart.item_count;
            badge.style.display = cart.item_count > 0 ? '' : 'none';
          }
        });
      setTimeout(function() {
        btnEl.disabled = false;
        btnEl.textContent = originalText;
      }, 2000);
    })
    .catch(function() {
      // Fallback to full page submit if AJAX fails
      btnEl.disabled = false;
      btnEl.textContent = originalText;
      formEl.submit();
    });
  }

  // Toast notification
  function lxShowToast(msg) {
    var existing = document.getElementById('lx-cart-toast');
    if (existing) existing.remove();
    var toast = document.createElement('div');
    toast.id = 'lx-cart-toast';
    toast.setAttribute('role', 'status');
    toast.setAttribute('aria-live', 'polite');
    toast.innerHTML = '<i class="ph ph-shopping-bag"></i><span>' + msg + '</span>' +
      '<a href="/cart" class="lx-toast-link">View basket →</a>';
    document.body.appendChild(toast);
    requestAnimationFrame(function() { toast.classList.add('is-visible'); });
    setTimeout(function() {
      toast.classList.remove('is-visible');
      setTimeout(function() { toast.remove(); }, 400);
    }, 3500);
  }

  // Wire up main ATC button
  var mainForm = document.getElementById('lx-product-form');
  var mainAddBtn = mainForm ? mainForm.querySelector('.lx-add-btn') : null;
  if (mainForm && mainAddBtn) {
    mainForm.addEventListener('submit', function(e) {
      e.preventDefault();
      lxAddToCart(mainForm, mainAddBtn);
    });
  }

  // Sticky mobile add-to-cart
  var stickyBar = document.getElementById('lx-sticky-atc');
  var stickyBtn = document.getElementById('lx-sticky-atc-btn');
  var mainBtn = mainAddBtn;
  var form = mainForm;

  if (stickyBtn && form) {
    stickyBtn.addEventListener('click', function(){
      lxAddToCart(form, stickyBtn);
    });
  }
  if (stickyBar && mainBtn && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        // Show sticky bar only when the main button is scrolled out of view
        if (e.isIntersecting) stickyBar.classList.remove('is-visible');
        else stickyBar.classList.add('is-visible');
      });
    }, { threshold: 0 });
    io.observe(mainBtn);
  }

  // Related products (Shopify recommendations API)
  var relatedSection = document.querySelector('.lx-related');
  if (relatedSection) {
    var pid = relatedSection.dataset.productId;
    var limit = relatedSection.dataset.limit || 4;
    var grid = relatedSection.querySelector('.lx-related-grid');
    fetch('/recommendations/products.json?product_id=' + pid + '&limit=' + limit + '&intent=related')
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (!data.products || !data.products.length) { relatedSection.style.display = 'none'; return; }
        var html = '';
        data.products.forEach(function(p){
          var img = p.featured_image ? '<img src="' + p.featured_image + '" alt="' + p.title + '" loading="lazy">' : '<span class="lx-related-ph"><i class="ph ph-cube"></i></span>';
          var price = '£' + (p.price / 100).toFixed(2);
          html += '<a href="' + p.url + '" class="lx-related-card">' +
                    '<div class="lx-related-img">' + img + '</div>' +
                    '<div class="lx-related-info"><strong>' + p.title + '</strong><span>' + price + '</span></div>' +
                  '</a>';
        });
        grid.innerHTML = html;
      })
      .catch(function(){ relatedSection.style.display = 'none'; });
  }
})();
</script>

{% stylesheet %}
/* ================================================================
   MAIN-PRODUCT — scoped to .lx-product and related wrappers
   All design tokens are globally defined. Do not redefine :root.
   ================================================================ */

/* ---- Section wrapper ---- */
.lx-product {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg);
}

/* ---- Mobile title (hidden on desktop) ---- */
.lx-product-mobile-head {
  display: none;
}

/* ---- Two-column layout: gallery | details ---- */
.lx-product-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  grid-template-rows: auto auto;
  column-gap: clamp(2rem, 5vw, 4rem);
  row-gap: 2rem;
  align-items: start;
}

/* ================================================================
   IMAGE GALLERY
   ================================================================ */
.lx-product-gallery {
  grid-column: 1;
  grid-row: 1 / 3;
  position: sticky;
  top: 7rem;
}

.lx-gallery-stage {
  position: relative;
  background: var(--lx-bg-alt);
  border-radius: var(--lx-r-lg);
  border: 1px solid var(--lx-line);
  overflow: hidden;
  aspect-ratio: 1 / 1;
}

.lx-gallery-slide {
  display: none;
  position: absolute;
  inset: 0;
}
.lx-gallery-slide.is-active {
  display: flex;
  align-items: center;
  justify-content: center;
}
.lx-gallery-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.lx-gallery-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: var(--lx-faint);
  font-size: 3.5rem;
}

/* Arrows */
.lx-gallery-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--lx-line);
  border-radius: 50%;
  width: 2.25rem;
  height: 2.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--lx-navy);
  transition: background var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease),
              transform var(--lx-dur) var(--lx-ease);
  z-index: 2;
}
.lx-gallery-arrow:hover {
  background: #fff;
  box-shadow: var(--lx-sh);
  transform: translateY(calc(-50% - 2px));
}
.lx-gallery-arrow--prev { left: 0.75rem; }
.lx-gallery-arrow--next { right: 0.75rem; }

/* Dots */
.lx-gallery-dots {
  position: absolute;
  bottom: 0.75rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6px;
  z-index: 2;
}
.lx-gallery-dot {
  width: 7px;
  height: 7px;
  border-radius: var(--lx-pill);
  background: rgba(255,255,255,0.55);
  border: 1.5px solid rgba(255,255,255,0.8);
  cursor: pointer;
  transition: background var(--lx-dur) var(--lx-ease),
              transform var(--lx-dur) var(--lx-ease);
}
.lx-gallery-dot.is-active {
  background: var(--lx-blue);
  border-color: var(--lx-blue);
  transform: scale(1.25);
}

/* ================================================================
   FEATURE HEX TILES
   ================================================================ */
.lx-product-features {
  grid-column: 2;
  grid-row: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.lx-feature-tile {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  background: var(--lx-blue-050);
  border: 1px solid var(--lx-blue-100);
  border-radius: var(--lx-r);
  padding: 0.55rem 0.85rem;
  flex: 1 1 auto;
  min-width: 10rem;
  transition: box-shadow var(--lx-dur) var(--lx-ease);
}
.lx-feature-tile:hover {
  box-shadow: var(--lx-sh-blue);
}

.lx-feature-icon {
  width: 2.25rem;
  height: 2.25rem;
  min-width: 2.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--lx-blue-100);
  border-radius: 12px;
  color: var(--lx-blue-ink);
  font-size: 1.1rem;
}

.lx-feature-text {
  display: flex;
  flex-direction: column;
  gap: 1px;
}
.lx-feature-text strong {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--lx-navy);
  line-height: 1.25;
}
.lx-feature-text span {
  font-size: 0.72rem;
  color: var(--lx-muted);
  line-height: 1.25;
}

/* ================================================================
   PRODUCT DETAILS PANEL
   ================================================================ */
.lx-product-details {
  grid-column: 2;
  grid-row: 2;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

/* Vendor + title area */
.lx-product-head {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.lx-product-vendor {
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--lx-blue-ink);
}
.lx-product-head h1 {
  font-family: var(--lx-display);
  color: var(--lx-navy);
  font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  line-height: 1.15;
  margin: 0;
}
.lx-product-tagline {
  color: var(--lx-muted);
  font-size: 0.95rem;
  line-height: 1.6;
  margin: 0;
}

/* Tag pills */
.lx-product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}
.lx-pill {
  display: inline-flex;
  align-items: center;
  padding: 0.28rem 0.75rem;
  background: var(--lx-blue-050);
  border: 1px solid var(--lx-blue-100);
  border-radius: var(--lx-pill);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--lx-blue-ink);
  letter-spacing: 0.04em;
  white-space: nowrap;
}

/* ================================================================
   PRODUCT FORM
   ================================================================ */
.lx-product-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

/* Variant group */
.lx-variant-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.lx-variant-label {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--lx-ink);
}
.lx-variant-options {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.lx-variant-option {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.5rem 0.9rem;
  background: var(--lx-bg-alt);
  border: 1.5px solid var(--lx-line);
  border-radius: var(--lx-r-sm);
  cursor: pointer;
  transition: border-color var(--lx-dur) var(--lx-ease),
              background var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease);
}
.lx-variant-option input[type="radio"] {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}
.lx-variant-option:hover {
  border-color: var(--lx-blue);
  background: var(--lx-blue-050);
}
.lx-variant-option.is-selected {
  border-color: var(--lx-blue);
  background: var(--lx-blue-050);
  box-shadow: 0 0 0 3px var(--lx-blue-100);
}
.lx-variant-thumb {
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 6px;
  overflow: hidden;
  flex-shrink: 0;
}
.lx-variant-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.lx-variant-text {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--lx-ink);
}
.lx-variant-check {
  display: none;
  color: var(--lx-blue);
  margin-left: auto;
}
.lx-variant-option.is-selected .lx-variant-check {
  display: flex;
}

/* Price block */
.lx-product-price-block {
  padding: 1rem 1.15rem;
  background: var(--lx-bg-soft);
  border-radius: var(--lx-r);
  border: 1px solid var(--lx-line);
}
.lx-product-price {
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
  flex-wrap: wrap;
}
.lx-price-current {
  font-family: var(--lx-display);
  font-size: clamp(1.6rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--lx-navy);
  line-height: 1;
}
.lx-price-compare {
  font-size: 1rem;
  color: var(--lx-faint);
  text-decoration: line-through;
}
.lx-price-save {
  display: inline-flex;
  align-items: center;
  padding: 0.2rem 0.55rem;
  background: var(--lx-green);
  color: #fff;
  border-radius: var(--lx-pill);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

/* Quantity */
.lx-quantity {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.lx-quantity label {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--lx-ink);
}
.lx-qty-control {
  display: inline-flex;
  align-items: stretch;
  border: 1.5px solid var(--lx-line-strong);
  border-radius: var(--lx-r-sm);
  overflow: hidden;
  width: fit-content;
}
.lx-qty-btn {
  background: var(--lx-bg-alt);
  border: none;
  width: 2.5rem;
  height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--lx-navy);
  transition: background var(--lx-dur) var(--lx-ease);
}
.lx-qty-btn:hover {
  background: var(--lx-blue-050);
  color: var(--lx-blue);
}
.lx-qty-input {
  width: 3rem;
  text-align: center;
  border: none;
  border-left: 1px solid var(--lx-line);
  border-right: 1px solid var(--lx-line);
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--lx-navy);
  background: #fff;
  -moz-appearance: textfield;
}
.lx-qty-input::-webkit-outer-spin-button,
.lx-qty-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
}
.lx-qty-input:focus-visible {
  outline: 2px solid var(--lx-blue);
  outline-offset: -2px;
}

/* Add to cart button */
.lx-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  width: 100%;
  padding: 0.95rem 1.75rem;
  background: var(--lx-blue);
  color: #fff;
  font-family: var(--lx-display);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  border: none;
  border-radius: var(--lx-pill);
  cursor: pointer;
  box-shadow: var(--lx-sh-blue);
  transition: background var(--lx-dur) var(--lx-ease),
              transform var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease);
}
.lx-add-btn:hover:not(:disabled) {
  background: var(--lx-blue-600);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0, 151, 212, 0.38);
}
.lx-add-btn:active:not(:disabled) {
  transform: translateY(0);
  box-shadow: var(--lx-sh-blue);
}
.lx-add-btn:disabled {
  background: var(--lx-faint);
  cursor: not-allowed;
  box-shadow: none;
}
.lx-add-btn--secondary {
  background: transparent;
  color: var(--lx-blue-ink);
  border: 1.5px solid var(--lx-blue);
  box-shadow: none;
}
.lx-add-btn--secondary:hover:not(:disabled) {
  background: var(--lx-blue-050);
  box-shadow: none;
}
.lx-secondary-sub {
  font-size: 0.78rem;
  color: var(--lx-muted);
  text-align: center;
  margin: -0.5rem 0 0;
}

/* Trust signals */
.lx-product-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;
  padding-top: 0.5rem;
  border-top: 1px solid var(--lx-line);
}
.lx-trust-sig {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.78rem;
  color: var(--lx-muted);
}
.lx-trust-sig i {
  color: var(--lx-green);
  font-size: 1rem;
}

/* Info rows */
.lx-product-info-rows {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r);
  overflow: hidden;
}
.lx-info-row {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 0.75rem 1rem;
  background: var(--lx-bg-soft);
  border-bottom: 1px solid var(--lx-line);
}
.lx-info-row:last-child {
  border-bottom: none;
}
.lx-info-icon {
  width: 2rem;
  height: 2rem;
  min-width: 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--lx-blue-050);
  border-radius: 10px;
  color: var(--lx-blue-ink);
  font-size: 1rem;
}
.lx-info-text {
  display: flex;
  flex-direction: column;
  gap: 1px;
}
.lx-info-text strong {
  font-size: 0.83rem;
  font-weight: 600;
  color: var(--lx-navy);
}
.lx-info-text span {
  font-size: 0.75rem;
  color: var(--lx-muted);
}

/* ================================================================
   RELATED PRODUCTS
   ================================================================ */
.lx-related {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg-soft);
}

.lx-related-head {
  text-align: center;
  margin-bottom: 2.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}
.lx-related-eyebrow {
  display: block;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--lx-blue-ink);
}
.lx-related-head h2 {
  font-family: var(--lx-display);
  color: var(--lx-navy);
  font-size: clamp(1.5rem, 3vw, 2rem);
  margin: 0;
}

.lx-related-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
}

.lx-related-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r-lg);
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: transform var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease),
              border-color var(--lx-dur) var(--lx-ease);
}
.lx-related-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--lx-sh-lg);
  border-color: transparent;
}
.lx-related-img {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--lx-bg-alt);
}
.lx-related-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.lx-related-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: var(--lx-faint);
  font-size: 2.5rem;
}
.lx-related-info {
  padding: 0.9rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.lx-related-info strong {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--lx-navy);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.lx-related-info span {
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--lx-blue-ink);
}

/* ================================================================
   STICKY MOBILE ADD-TO-CART BAR
   ================================================================ */
.lx-sticky-atc {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(8px);
  border-top: 1px solid var(--lx-line);
  padding: 0.75rem clamp(1rem, 4vw, 2rem);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  z-index: 900;
  transform: translateY(100%);
  transition: transform var(--lx-dur) var(--lx-ease),
              opacity var(--lx-dur) var(--lx-ease);
  opacity: 0;
  pointer-events: none;
}
.lx-sticky-atc.is-visible {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}
.lx-sticky-atc-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: hidden;
}
.lx-sticky-atc-title {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--lx-navy);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.lx-sticky-atc-price {
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--lx-blue-ink);
}
.lx-sticky-atc-btn {
  flex-shrink: 0;
  padding: 0.7rem 1.5rem;
  background: var(--lx-blue);
  color: #fff;
  font-family: var(--lx-display);
  font-size: 0.9rem;
  font-weight: 700;
  border: none;
  border-radius: var(--lx-pill);
  cursor: pointer;
  box-shadow: var(--lx-sh-blue);
  transition: background var(--lx-dur) var(--lx-ease);
}
.lx-sticky-atc-btn:hover:not(:disabled) {
  background: var(--lx-blue-600);
}
.lx-sticky-atc-btn:disabled {
  background: var(--lx-faint);
  cursor: not-allowed;
  box-shadow: none;
}

/* ================================================================
   CART TOAST NOTIFICATION
   ================================================================ */
#lx-cart-toast {
  position: fixed;
  bottom: 5rem;
  left: 50%;
  transform: translateX(-50%) translateY(1rem);
  background: var(--lx-navy);
  color: #fff;
  padding: 0.85rem 1.25rem;
  border-radius: var(--lx-r);
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-size: 0.88rem;
  font-weight: 500;
  box-shadow: var(--lx-sh-lg);
  z-index: 1100;
  opacity: 0;
  transition: opacity 0.3s var(--lx-ease), transform 0.3s var(--lx-ease);
  white-space: nowrap;
}
#lx-cart-toast.is-visible {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
#lx-cart-toast i {
  font-size: 1.1rem;
  color: var(--lx-blue);
}
.lx-toast-link {
  color: var(--lx-blue);
  text-decoration: none;
  font-weight: 600;
  margin-left: 0.25rem;
}
.lx-toast-link:hover {
  text-decoration: underline;
}

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 860px) {
  .lx-product-grid {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
  }
  .lx-product-gallery {
    grid-column: 1;
    grid-row: 1;
    position: static;
  }
  .lx-product-features {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .lx-product-details {
    grid-column: 1;
    grid-row: 3;
  }
  .lx-related-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .lx-product-mobile-head {
    display: none;
  }
  .lx-product-head {
    display: flex;
  }
}

@media (max-width: 520px) {
  .lx-product-mobile-head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .lx-product-mobile-head h1 {
    font-size: 1.6rem;
    margin: 0;
  }
  .lx-product-mobile-head p {
    color: var(--lx-muted);
    font-size: 0.9rem;
    margin: 0;
  }
  .lx-product-head {
    display: none;
  }
  .lx-product-features {
    grid-template-columns: repeat(2, 1fr);
  }
  .lx-related-grid {
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .lx-gallery-stage {
    border-radius: var(--lx-r);
  }
  #lx-cart-toast {
    left: 1rem;
    right: 1rem;
    transform: translateX(0) translateY(1rem);
    white-space: normal;
  }
  #lx-cart-toast.is-visible {
    transform: translateX(0) translateY(0);
  }
}

/* ================================================================
   REDUCED MOTION
   ================================================================ */
@media (prefers-reduced-motion: reduce) {
  .lx-gallery-arrow,
  .lx-gallery-dot,
  .lx-variant-option,
  .lx-add-btn,
  .lx-related-card,
  .lx-sticky-atc,
  #lx-cart-toast {
    transition: none;
    transform: none;
    animation: none;
  }
  .lx-sticky-atc.is-visible {
    transform: none;
  }
  #lx-cart-toast.is-visible {
    transform: none;
  }
}
{% endstylesheet %}

