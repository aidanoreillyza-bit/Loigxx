<section class="shop-page">
  <div class="container">

    <!-- Centered header -->
    <header class="shop-head">
      <h1>{{ section.settings.heading | default: collection.title }}</h1>
      <p>{{ section.settings.subheading | default: collection.description }}</p>
    </header>

    <!-- Body: sidebar + grid -->
    <div class="shop-body">

      <!-- Filter sidebar -->
      <aside class="shop-sidebar">
        <h3 class="shop-sidebar-title">Filters</h3>

        <div class="shop-search">
          <form action="/search" method="get" role="search">
            <input type="search" name="q" placeholder="Search" value="{{ search.terms }}">
            <button type="submit" aria-label="Search"><i class="ph ph-magnifying-glass"></i></button>
          </form>
        </div>

        <a href="{{ collection.url }}" class="shop-reset">Reset filters</a>

        <details class="shop-filter-group" open>
          <summary>
            <span>Categories</span>
            <i class="ph ph-caret-down"></i>
          </summary>
          <ul class="shop-filter-list">
            <li><a href="/collections/all" {% if collection.handle == 'all' %}class="is-active"{% endif %}>All products</a></li>
            <li><a href="/collections/male-fertility" {% if collection.handle == 'male-fertility' %}class="is-active"{% endif %}>Male fertility</a></li>
            <li><a href="/collections/female-fertility" {% if collection.handle == 'female-fertility' %}class="is-active"{% endif %}>Female fertility</a></li>
            <li><a href="/collections/wellness" {% if collection.handle == 'wellness' %}class="is-active"{% endif %}>Wellness</a></li>
            <li><a href="/collections/diagnostics" {% if collection.handle == 'diagnostics' %}class="is-active"{% endif %}>Diagnostics</a></li>
          </ul>
        </details>

        <details class="shop-filter-group" open>
          <summary>
            <span>Brands</span>
            <i class="ph ph-caret-down"></i>
          </summary>
          <ul class="shop-filter-list">
            <li><a href="/collections/proxeed">Proxeed</a></li>
            <li><a href="/collections/punalpin">Punalpin</a></li>
            <li><a href="/collections/lenshooke">LensHooke</a></li>
            <li><a href="/collections/mioxsys">MiOXSYS</a></li>
          </ul>
        </details>
      </aside>

      <!-- Product grid -->
      <div class="shop-grid">
        {% paginate collection.products by 12 %}

          {% if collection.products.size == 0 %}
            <div class="shop-empty">
              <i class="ph ph-package"></i>
              <h3>No products yet</h3>
              <p>Add products to this collection in Shopify Admin to see them here.</p>
            </div>
          {% else %}
            <div class="product-grid product-grid--3col">
              {% for product in collection.products %}
                <a href="{{ product.url }}" class="product-card">
                  <div class="product-image">
                    {% if product.featured_image %}
                      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    {% endif %}
                    {% if product.compare_at_price > product.price %}
                      <span class="product-badge">Sale</span>
                    {% endif %}
                  </div>
                  <div class="product-info">
                    {% if product.vendor %}
                      <div class="product-cat">{{ product.vendor }}</div>
                    {% endif %}
                    <h3 class="product-title">{{ product.title }}</h3>
                    <div class="product-price">
                      {{ product.price | money }}
                      {% if product.compare_at_price > product.price %}
                        <span class="compare">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                  </div>
                </a>
              {% endfor %}
            </div>

            {% if paginate.pages > 1 %}
              <nav class="shop-pagination">
                {% if paginate.previous %}<a href="{{ paginate.previous.url }}" class="shop-page-btn">← Previous</a>{% endif %}
                {% for part in paginate.parts %}
                  {% if part.is_link %}
                    <a href="{{ part.url }}" class="shop-page-btn">{{ part.title }}</a>
                  {% else %}
                    <span class="shop-page-btn is-current">{{ part.title }}</span>
                  {% endif %}
                {% endfor %}
                {% if paginate.next %}<a href="{{ paginate.next.url }}" class="shop-page-btn">Next →</a>{% endif %}
              </nav>
            {% endif %}
          {% endif %}

        {% endpaginate %}
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
/* ================================================================
   MAIN-COLLECTION — scoped to .shop-page and children
   Design tokens are globally defined. Do not redefine :root.
   ================================================================ */

/* ---- Section wrapper ---- */
.shop-page {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg);
}

/* ---- Page header ---- */
.shop-head {
  text-align: center;
  margin-bottom: clamp(2rem, 4vw, 3rem);
  max-width: 640px;
  margin-inline: auto;
  margin-bottom: clamp(2rem, 4vw, 3rem);
}
.shop-head h1 {
  font-family: var(--lx-display);
  color: var(--lx-navy);
  font-size: clamp(1.8rem, 4vw, 2.75rem);
  line-height: 1.12;
  margin: 0 0 0.6rem;
}
.shop-head p {
  color: var(--lx-muted);
  font-size: 1rem;
  line-height: 1.65;
  margin: 0;
}

/* ---- Body: sidebar + grid ---- */
.shop-body {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: clamp(1.5rem, 3vw, 2.5rem);
  align-items: start;
}

/* ================================================================
   FILTER SIDEBAR
   ================================================================ */
.shop-sidebar {
  position: sticky;
  top: 7rem;
  background: var(--lx-bg-soft);
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r-lg);
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.shop-sidebar-title {
  font-family: var(--lx-display);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--lx-navy);
  letter-spacing: 0.03em;
  margin: 0;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--lx-line);
}

/* Sidebar search */
.shop-search form {
  position: relative;
  display: flex;
  align-items: center;
}
.shop-search input[type="search"] {
  width: 100%;
  padding: 0.55rem 2.5rem 0.55rem 0.85rem;
  border: 1.5px solid var(--lx-line-strong);
  border-radius: var(--lx-r-sm);
  font-size: 0.85rem;
  color: var(--lx-ink);
  background: #fff;
  transition: border-color var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease);
}
.shop-search input[type="search"]:focus-visible {
  outline: none;
  border-color: var(--lx-blue);
  box-shadow: 0 0 0 3px var(--lx-blue-100);
}
.shop-search button {
  position: absolute;
  right: 0.5rem;
  background: none;
  border: none;
  color: var(--lx-muted);
  cursor: pointer;
  font-size: 1rem;
  padding: 0.2rem;
  display: flex;
  align-items: center;
}
.shop-search button:hover {
  color: var(--lx-blue);
}

/* Reset link */
.shop-reset {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--lx-blue-ink);
  text-decoration: none;
  letter-spacing: 0.04em;
  transition: color var(--lx-dur) var(--lx-ease);
}
.shop-reset:hover {
  color: var(--lx-blue-700);
  text-decoration: underline;
}

/* Filter group (details/summary) */
.shop-filter-group {
  border-top: 1px solid var(--lx-line);
  padding-top: 0.75rem;
}
.shop-filter-group summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  list-style: none;
  font-size: 0.83rem;
  font-weight: 600;
  color: var(--lx-navy);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  user-select: none;
  padding-bottom: 0.5rem;
}
.shop-filter-group summary::-webkit-details-marker { display: none; }
.shop-filter-group summary i {
  font-size: 0.85rem;
  color: var(--lx-muted);
  transition: transform var(--lx-dur) var(--lx-ease);
}
.shop-filter-group[open] summary i {
  transform: rotate(180deg);
}
.shop-filter-group summary:hover {
  color: var(--lx-blue-ink);
}

.shop-filter-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}
.shop-filter-list li a {
  display: block;
  padding: 0.38rem 0.6rem;
  border-radius: var(--lx-r-sm);
  font-size: 0.87rem;
  color: var(--lx-ink);
  text-decoration: none;
  transition: background var(--lx-dur) var(--lx-ease),
              color var(--lx-dur) var(--lx-ease);
}
.shop-filter-list li a:hover {
  background: var(--lx-blue-050);
  color: var(--lx-blue-ink);
}
.shop-filter-list li a.is-active {
  background: var(--lx-blue-100);
  color: var(--lx-blue-ink);
  font-weight: 600;
}

/* ================================================================
   PRODUCT GRID AREA
   ================================================================ */
.shop-grid {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

/* Empty state */
.shop-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: clamp(3rem, 6vw, 5rem) 1rem;
  text-align: center;
  gap: 1rem;
  background: var(--lx-bg-soft);
  border: 1px dashed var(--lx-line-strong);
  border-radius: var(--lx-r-lg);
}
.shop-empty i {
  font-size: 3rem;
  color: var(--lx-faint);
}
.shop-empty h3 {
  font-family: var(--lx-display);
  color: var(--lx-navy);
  font-size: 1.35rem;
  margin: 0;
}
.shop-empty p {
  color: var(--lx-muted);
  font-size: 0.95rem;
  margin: 0;
  max-width: 380px;
}

/* ================================================================
   PAGINATION
   ================================================================ */
.shop-pagination {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.4rem;
  margin-top: 1rem;
}
.shop-page-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.25rem;
  height: 2.25rem;
  padding: 0 0.65rem;
  border: 1.5px solid var(--lx-line);
  border-radius: var(--lx-r-sm);
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--lx-ink);
  text-decoration: none;
  background: #fff;
  transition: border-color var(--lx-dur) var(--lx-ease),
              background var(--lx-dur) var(--lx-ease),
              color var(--lx-dur) var(--lx-ease);
}
.shop-page-btn:hover {
  border-color: var(--lx-blue);
  background: var(--lx-blue-050);
  color: var(--lx-blue-ink);
}
.shop-page-btn.is-current {
  border-color: var(--lx-blue);
  background: var(--lx-blue);
  color: #fff;
  font-weight: 700;
  pointer-events: none;
}

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 860px) {
  .shop-body {
    grid-template-columns: 1fr;
  }
  .shop-sidebar {
    position: static;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1rem;
  }
  .shop-sidebar-title {
    width: 100%;
    padding-bottom: 0;
    border-bottom: none;
    border-bottom: 1px solid var(--lx-line);
    padding-bottom: 0.5rem;
    margin-bottom: 0;
  }
  .shop-search {
    flex: 1 1 180px;
  }
  .shop-filter-group {
    flex: 1 1 160px;
    border-top: none;
    padding-top: 0;
    border: 1px solid var(--lx-line);
    border-radius: var(--lx-r-sm);
    padding: 0.5rem 0.75rem;
  }
}

@media (max-width: 520px) {
  .shop-sidebar {
    flex-direction: column;
  }
  .shop-filter-group {
    flex: none;
    width: 100%;
  }
  .shop-pagination {
    justify-content: center;
  }
}

/* ================================================================
   REDUCED MOTION
   ================================================================ */
@media (prefers-reduced-motion: reduce) {
  .shop-filter-list li a,
  .shop-page-btn,
  .shop-reset,
  .shop-search input[type="search"],
  .shop-filter-group summary i {
    transition: none;
  }
  .shop-filter-group[open] summary i {
    transform: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "text",     "id": "heading",    "label": "Heading override (optional)" },
    { "type": "textarea", "id": "subheading", "label": "Subheading override (optional)" }
  ]
}
{% endschema %}
