    {"type": "text", "id": "stat_1_num", "label": "Stat 1 number", "default": "1 in 6"},
    {"type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Couples"},
    {"type": "text", "id": "stat_2_num", "label": "Stat 2 number", "default": "50%"},
    {"type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Male factor"},
    {"type": "text", "id": "stat_3_num", "label": "Stat 3 number", "default": "30%"},
    {"type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "Solely male"},
    {"type": "text", "id": "stat_4_num", "label": "Stat 4 number", "default": "74 days"},
