    {"type": "text", "id": "close2_title", "label": "Card 2 title", "default": "Start a protocol"},
    {"type": "textarea", "id": "close2_sub", "label": "Card 2 sub", "default": "Begin an evidence-based supplement protocol designed for male fertility."},
    {"type": "text", "id": "close2_btn", "label": "Card 2 button", "default": "Discover Proxeed Plus"},
    {"type": "text", "id": "close2_link", "label": "Card 2 link", "default": "/pages/proxeed-plus"}
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
        {"type": "text", "id": "heading", "label": "Heading"},
        {"type": "richtext", "id": "body", "label": "Body"},
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "text", "id": "link_text", "label": "Link text"},
        {"type": "text", "id": "link_url", "label": "Link URL"},
        {"type": "text", "id": "stat_value", "label": "Stat value"},
