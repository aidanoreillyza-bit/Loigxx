    {"type": "header", "content": "Closing CTAs"},
    {"type": "checkbox", "id": "show_closing", "label": "Show closing CTAs", "default": true},
    {"type": "text", "id": "close1_title", "label": "Card 1 title", "default": "Get tested"},
    {"type": "textarea", "id": "close1_sub", "label": "Card 1 sub", "default": "Use clinic-grade diagnostics to assess sperm count, motility and oxidative stress."},
    {"type": "text", "id": "close1_btn", "label": "Card 1 button", "default": "Explore diagnostics"},
