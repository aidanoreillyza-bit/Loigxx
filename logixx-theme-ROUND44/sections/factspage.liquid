<section class="lx-facts" id="lx-facts-{{ section.id }}">

  <!-- Reading progress bar -->
  <div class="lx-reading-progress" id="lx-reading-{{ section.id }}"></div>

  <!-- Animated sperm swimmers (background, low opacity) -->
  <div class="lx-facts-swimmers" aria-hidden="true">
    {% for i in (1..40) %}
      <svg class="lx-swimmer lx-swimmer--{{ forloop.index | modulo: 4 | plus: 1 }}" viewBox="0 0 60 12">
        <ellipse cx="6" cy="6" rx="5" ry="4" fill="#2b5a8a"/>
        <line x1="11" y1="6" x2="58" y2="6" stroke="#2b5a8a" stroke-width="0.8" opacity="0.6"/>
      </svg>
    {% endfor %}
  </div>

  <!-- HERO -->
  <div class="lx-facts-hero">
    <div class="container">
      <div class="lx-facts-hero-grid">
        <div class="lx-facts-hero-text">
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          <h1>{{ section.settings.heading }}</h1>
          <p class="lx-facts-lead">{{ section.settings.subheading }}</p>
        </div>
        <div class="lx-facts-hero-visual">
          <div class="lx-facts-hero-image">
            {% if section.settings.hero_image != blank %}
              <img src="{{ section.settings.hero_image | image_url: width: 1200 }}" alt="{{ section.settings.heading }}">
            {% else %}
              <div class="lx-facts-hero-placeholder">
                <i class="ph ph-image"></i>
                <span>Add hero image</span>
              </div>
            {% endif %}
          </div>
          {% if section.settings.show_float %}
            <div class="lx-facts-float-card">
              <div class="lx-facts-float-icon"><i class="ph ph-shield-check"></i></div>
              <div>
                <strong>{{ section.settings.float_title }}</strong>
                <span>{{ section.settings.float_sub }}</span>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- ANIMATED STATS -->
  {% if section.settings.show_stats %}
    <div class="lx-facts-stats">
      <div class="container">
        <div class="lx-facts-stats-grid">
          <div class="lx-facts-stat" data-target="{{ section.settings.stat_1_num | strip }}">
            <strong>{{ section.settings.stat_1_num }}</strong>
            <span>{{ section.settings.stat_1_label }}</span>
          </div>
          <div class="lx-facts-stat" data-target="{{ section.settings.stat_2_num | strip }}">
            <strong>{{ section.settings.stat_2_num }}</strong>
            <span>{{ section.settings.stat_2_label }}</span>
          </div>
          <div class="lx-facts-stat" data-target="{{ section.settings.stat_3_num | strip }}">
            <strong>{{ section.settings.stat_3_num }}</strong>
            <span>{{ section.settings.stat_3_label }}</span>
          </div>
          <div class="lx-facts-stat" data-target="{{ section.settings.stat_4_num | strip }}">
            <strong>{{ section.settings.stat_4_num }}</strong>
            <span>{{ section.settings.stat_4_label }}</span>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- FACT BLOCKS -->
  <div class="lx-facts-list">
    <div class="container">
      {% assign idx = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'fact' %}
          <article class="lx-fact{% cycle '', ' lx-fact--alt' %}" {{ block.shopify_attributes }}>
            <div class="lx-fact-text">
              {% if block.settings.eyebrow != blank %}<span class="lx-fact-eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
              <h2>{{ block.settings.heading }}</h2>
              <div class="lx-fact-body rte">{{ block.settings.body }}</div>
              {% if block.settings.link_text != blank %}
                <a href="{{ block.settings.link_url }}" class="lx-fact-link">{{ block.settings.link_text }} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
              {% endif %}
            </div>
            <div class="lx-fact-visual">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.heading }}">
              {% else %}
                <div class="lx-fact-placeholder"><i class="ph ph-image"></i><span>Add image</span></div>
              {% endif %}
              {% if block.settings.stat_value != blank %}
                <div class="lx-fact-badge"><strong>{{ block.settings.stat_value }}</strong><span>{{ block.settings.stat_caption }}</span></div>
              {% endif %}
            </div>
          </article>
          {% assign idx = idx | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- 74-DAY SPERMATOGENESIS TIMELINE -->
  {% if section.settings.show_cycle %}
    <div class="lx-cycle">
      <div class="container">
        <div class="lx-cycle-head">
          <span class="eyebrow">{{ section.settings.cycle_eyebrow }}</span>
          <h2>{{ section.settings.cycle_heading }}</h2>
          <p>{{ section.settings.cycle_sub }}</p>
        </div>

        <div class="lx-cycle-track">
          <div class="lx-cycle-line"></div>
          <div class="lx-cycle-line-fill" id="lx-cycle-fill-{{ section.id }}"></div>

          <div class="lx-cycle-stops">
            <div class="lx-cycle-stop">
              <div class="lx-cycle-dot"><span>1</span></div>
              <div class="lx-cycle-stop-text">
                <strong>Day 1</strong>
                <span>Spermatogonia divide</span>
              </div>
            </div>
            <div class="lx-cycle-stop">
              <div class="lx-cycle-dot"><span>16</span></div>
              <div class="lx-cycle-stop-text">
                <strong>Day 16</strong>
                <span>Primary spermatocytes form</span>
              </div>
            </div>
            <div class="lx-cycle-stop">
              <div class="lx-cycle-dot"><span>30</span></div>
              <div class="lx-cycle-stop-text">
                <strong>Day 30</strong>
                <span>Meiosis &amp; DNA finalised</span>
              </div>
            </div>
            <div class="lx-cycle-stop">
              <div class="lx-cycle-dot"><span>50</span></div>
              <div class="lx-cycle-stop-text">
                <strong>Day 50</strong>
                <span>Tail formation &amp; maturation</span>
              </div>
            </div>
            <div class="lx-cycle-stop is-final">
              <div class="lx-cycle-dot"><span>74</span></div>
              <div class="lx-cycle-stop-text">
                <strong>Day 74</strong>
                <span>Mature sperm released</span>
              </div>
            </div>
          </div>
        </div>

        <div class="lx-cycle-note">
          <i class="ph ph-info"></i>
          <p>{{ section.settings.cycle_note }}</p>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- CAUSES GRID -->
  {% assign cause_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'cause' %}{% assign cause_count = cause_count | plus: 1 %}{% endif %}{% endfor %}
  {% if cause_count > 0 %}
    <div class="lx-facts-causes">
      <div class="container">
        <div class="lx-facts-causes-head">
          <span class="eyebrow">{{ section.settings.causes_eyebrow }}</span>
          <h2>{{ section.settings.causes_heading }}</h2>
          <p>{{ section.settings.causes_sub }}</p>
        </div>
        <div class="lx-facts-causes-grid">
          {% for block in section.blocks %}
            {% if block.type == 'cause' %}
              <div class="lx-cause-card" {{ block.shopify_attributes }}>
                <div class="lx-cause-icon"><i class="{{ block.settings.icon }}"></i></div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.description }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- TWO-CARD CLOSING CTA -->
  {% if section.settings.show_closing %}
    <div class="lx-facts-closing">
      <div class="container">
        <div class="lx-facts-closing-grid">
          <div class="lx-closing-card lx-closing-card--diagnostic">
            <div class="lx-closing-icon"><i class="ph ph-microscope"></i></div>
            <h3>{{ section.settings.close1_title }}</h3>
            <p>{{ section.settings.close1_sub }}</p>
            <a href="{{ section.settings.close1_link }}" class="btn btn-primary">{{ section.settings.close1_btn }} →</a>
          </div>
          <div class="lx-closing-card lx-closing-card--protocol">
            <div class="lx-closing-icon"><i class="ph ph-pill"></i></div>
            <h3>{{ section.settings.close2_title }}</h3>
            <p>{{ section.settings.close2_sub }}</p>
            <a href="{{ section.settings.close2_link }}" class="btn btn-ghost">{{ section.settings.close2_btn }} →</a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</section>

<script>
(function(){
  var section = document.getElementById('lx-facts-{{ section.id }}');
  if (!section) return;

  // Reading progress bar
  var progressBar = document.getElementById('lx-reading-{{ section.id }}');
  function updateProgress(){
    var rect = section.getBoundingClientRect();
    var height = rect.height - window.innerHeight;
    var scrolled = -rect.top;
    var pct = Math.max(0, Math.min(100, (scrolled / height) * 100));
    if (progressBar) progressBar.style.width = pct + '%';
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // Animated counters for stats
  var stats = section.querySelectorAll('.lx-facts-stat');
  if ('IntersectionObserver' in window && stats.length) {
    var seen = new WeakSet();
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting && !seen.has(e.target)) {
          seen.add(e.target);
          animateStat(e.target);
        }
      });
    }, { threshold: 0.4 });
    stats.forEach(function(s){ io.observe(s); });
  }

  function animateStat(el){
    var strong = el.querySelector('strong');
    if (!strong) return;
    var raw = strong.textContent.trim();

    // Extract numeric portion (handles "1 in 6", "50%", "12+ months", "6-12")
    var match = raw.match(/(\d+)/);
    if (!match) return;
    var target = parseInt(match[1], 10);
    var prefix = raw.substring(0, raw.indexOf(match[0]));
    var suffix = raw.substring(raw.indexOf(match[0]) + match[0].length);

    var duration = 1400;
    var start = performance.now();
    function tick(now){
      var t = Math.min(1, (now - start) / duration);
      var eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
      var current = Math.floor(eased * target);
      strong.textContent = prefix + current + suffix;
      if (t < 1) requestAnimationFrame(tick);
      else strong.textContent = raw;
    }
    requestAnimationFrame(tick);
  }

  // Cycle line fill animation
  var cycleFill = document.getElementById('lx-cycle-fill-{{ section.id }}');
  var cycleTrack = section.querySelector('.lx-cycle-track');
  if (cycleFill && cycleTrack) {
    var cycleIO = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) {
          cycleFill.style.width = '100%';
        }
      });
    }, { threshold: 0.3 });
    cycleIO.observe(cycleTrack);
  }
})();
</script>

{% schema %}
{
  "name": "Facts Page",
  "settings": [
    {"type": "header", "content": "Hero"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Male Infertility"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Male infertility facts you need to know"},
    {"type": "textarea", "id": "subheading", "label": "Subheading", "default": "Infertility affects 1 in 6 couples. Understanding the facts is the first step toward finding the right path forward."},
    {"type": "image_picker", "id": "hero_image", "label": "Hero image"},
