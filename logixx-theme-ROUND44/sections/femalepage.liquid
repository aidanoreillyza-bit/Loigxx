    { "type": "text", "id": "type_1_title", "label": "Type 1 title", "default": "Primary infertility" },
    { "type": "textarea", "id": "type_1_desc", "label": "Type 1 description", "default": "When someone who has never conceived a child has difficulty conceiving." },
    { "type": "text", "id": "type_2_title", "label": "Type 2 title", "default": "Secondary infertility" },
