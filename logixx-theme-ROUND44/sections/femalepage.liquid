    {
      "type": "cause",
      "name": "Cause",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "ph ph-circle" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    },
    {
      "type": "risk",
      "name": "Risk factor",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "ph ph-warning" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    },
    {
      "type": "treatment",
      "name": "Treatment option",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "ph ph-stethoscope" },
