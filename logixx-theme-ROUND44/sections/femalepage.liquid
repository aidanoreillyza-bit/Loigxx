<section class="lx-fem" id="lx-fem-{{ section.id }}">

  <!-- Floating female symbol decorations -->
  <div class="lx-fem-symbols" aria-hidden="true">
    {% for i in (1..12) %}
      <span class="lx-fem-symbol lx-fem-symbol--{{ forloop.index | modulo: 4 | plus: 1 }}">♀</span>
    {% endfor %}
  </div>

  <!-- Reading progress bar -->
  <div class="lx-fem-progress" id="lx-fem-progress-{{ section.id }}"></div>

  <!-- HERO -->
  <div class="lx-fem-hero">
    <div class="container">
      <div class="lx-fem-hero-inner">
        <div class="lx-fem-hero-eyebrow">
          <i class="ph ph-gender-female"></i>
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          <i class="ph ph-gender-female"></i>
        </div>
        <h1>{{ section.settings.heading }}</h1>
        <div class="lx-fem-hero-lead rte">{{ section.settings.lead }}</div>

        {% if section.settings.show_keystat %}
          <div class="lx-fem-keystat">
            <div class="lx-fem-keystat-num">{{ section.settings.keystat_num }}</div>
            <div class="lx-fem-keystat-text">
              <strong>{{ section.settings.keystat_title }}</strong>
              <span>{{ section.settings.keystat_sub }}</span>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- ANIMATED COUNTERS -->
  {% if section.settings.show_counters %}
    <div class="lx-fem-counters">
      <div class="container">
        <div class="lx-fem-counters-grid">
          <div class="lx-fem-counter lx-fem-counter--accent" data-target="30000000">
            <strong class="lx-fem-counter-num" data-target="30000000">0</strong>
            <span class="lx-fem-counter-unit">+</span>
            <p>women globally affected</p>
          </div>
          <div class="lx-fem-counter" data-target="84">
            <strong class="lx-fem-counter-num" data-target="84">0</strong>
            <span class="lx-fem-counter-unit">%</span>
            <p>conceive within 1 year of trying</p>
          </div>
          <div class="lx-fem-counter lx-fem-counter--accent" data-target="1">
            <strong class="lx-fem-counter-num" data-target="1">0</strong>
            <span class="lx-fem-counter-unit">in 7</span>
            <p>couples have trouble conceiving</p>
          </div>
          <div class="lx-fem-counter" data-target="20">
            <strong class="lx-fem-counter-num" data-target="20">0</strong>
            <span class="lx-fem-counter-unit">–70%</span>
            <p>of cases linked to female factor</p>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- TWO TYPES OF INFERTILITY -->
  {% if section.settings.show_types %}
    <div class="lx-fem-types">
      <div class="container">
        <div class="lx-fem-section-head">
          <span class="lx-fem-mini-eyebrow">{{ section.settings.types_eyebrow }}</span>
          <h2>{{ section.settings.types_heading }}</h2>
          <p>{{ section.settings.types_sub }}</p>
        </div>
        <div class="lx-fem-types-grid">
          <div class="lx-fem-type">
            <div class="lx-fem-type-icon"><i class="ph ph-number-circle-one"></i></div>
            <h3>{{ section.settings.type_1_title }}</h3>
            <p>{{ section.settings.type_1_desc }}</p>
          </div>
          <div class="lx-fem-type">
            <div class="lx-fem-type-icon lx-fem-type-icon--accent"><i class="ph ph-number-circle-two"></i></div>
            <h3>{{ section.settings.type_2_title }}</h3>
            <p>{{ section.settings.type_2_desc }}</p>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- CAUSES (fact blocks) -->
  {% assign fact_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'fact' %}{% assign fact_count = fact_count | plus: 1 %}{% endif %}{% endfor %}
  {% if fact_count > 0 %}
    <div class="lx-fem-facts">
      <div class="container">
        <div class="lx-fem-section-head">
          <span class="lx-fem-mini-eyebrow">{{ section.settings.facts_eyebrow }}</span>
          <h2>{{ section.settings.facts_heading }}</h2>
        </div>
        {% for block in section.blocks %}
          {% if block.type == 'fact' %}
            <article class="lx-fem-fact{% cycle '', ' lx-fem-fact--alt' %}" {{ block.shopify_attributes }}>
              <div class="lx-fem-fact-text">
                <span class="lx-fem-fact-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <h3>{{ block.settings.title }}</h3>
                <div class="lx-fem-fact-body rte">{{ block.settings.body }}</div>
              </div>
              <div class="lx-fem-fact-visual">
                <div class="lx-fem-fact-stat">
                  <strong>{{ block.settings.stat_num }}</strong>
                  <span>{{ block.settings.stat_label }}</span>
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <!-- COMMON CAUSES GRID -->
  {% assign cause_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'cause' %}{% assign cause_count = cause_count | plus: 1 %}{% endif %}{% endfor %}
  {% if cause_count > 0 %}
    <div class="lx-fem-causes">
      <div class="container">
        <div class="lx-fem-section-head">
          <span class="lx-fem-mini-eyebrow">{{ section.settings.causes_eyebrow }}</span>
          <h2>{{ section.settings.causes_heading }}</h2>
          <p>{{ section.settings.causes_sub }}</p>
        </div>
        <div class="lx-fem-causes-grid">
          {% for block in section.blocks %}
            {% if block.type == 'cause' %}
              <div class="lx-fem-cause" {{ block.shopify_attributes }}>
                <div class="lx-fem-cause-icon"><i class="{{ block.settings.icon }}"></i></div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.description }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- RISK FACTORS -->
  {% if section.settings.show_risks %}
    <div class="lx-fem-risks">
      <div class="container">
        <div class="lx-fem-section-head">
          <span class="lx-fem-mini-eyebrow">{{ section.settings.risks_eyebrow }}</span>
          <h2>{{ section.settings.risks_heading }}</h2>
          <p>{{ section.settings.risks_sub }}</p>
        </div>
        <div class="lx-fem-risks-grid">
          {% for block in section.blocks %}
            {% if block.type == 'risk' %}
              <div class="lx-fem-risk" {{ block.shopify_attributes }}>
                <div class="lx-fem-risk-icon"><i class="{{ block.settings.icon }}"></i></div>
                <strong>{{ block.settings.title }}</strong>
                <span>{{ block.settings.description }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- TREATMENT OPTIONS -->
  {% if section.settings.show_treatments %}
    <div class="lx-fem-treatments">
      <div class="container">
        <div class="lx-fem-section-head">
          <span class="lx-fem-mini-eyebrow">{{ section.settings.treatments_eyebrow }}</span>
          <h2>{{ section.settings.treatments_heading }}</h2>
          <p>{{ section.settings.treatments_sub }}</p>
        </div>
        <div class="lx-fem-treatments-grid">
          {% for block in section.blocks %}
            {% if block.type == 'treatment' %}
              <div class="lx-fem-treatment" {{ block.shopify_attributes }}>
                <div class="lx-fem-treatment-icon"><i class="{{ block.settings.icon }}"></i></div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.description }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- WHEN TO GET HELP CALLOUT -->
  {% if section.settings.show_help %}
    <div class="lx-fem-help">
      <div class="container">
        <div class="lx-fem-help-card">
          <div class="lx-fem-help-icon"><i class="ph ph-heart-straight"></i></div>
          <div class="lx-fem-help-content">
            <span class="lx-fem-mini-eyebrow">{{ section.settings.help_eyebrow }}</span>
            <h2>{{ section.settings.help_heading }}</h2>
            <div class="rte">{{ section.settings.help_body }}</div>
            <div class="lx-fem-help-points">
              <div class="lx-fem-help-point">
                <i class="ph ph-clock"></i>
                <strong>After 12 months</strong>
                <span>of trying without success</span>
              </div>
              <div class="lx-fem-help-point">
                <i class="ph ph-calendar-blank"></i>
                <strong>Age 36+</strong>
                <span>see your GP sooner</span>
              </div>
              <div class="lx-fem-help-point">
                <i class="ph ph-warning-circle"></i>
                <strong>Known issues</strong>
                <span>don't wait — speak to a specialist</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- CLOSING CTA -->
  {% if section.settings.show_closing %}
    <div class="lx-fem-closing">
      <div class="container">
        <div class="lx-fem-closing-card">
          {% if section.settings.closing_heading != blank %}<h2>{{ section.settings.closing_heading }}</h2>{% endif %}
          <p>{{ section.settings.closing_sub }}</p>
          <div class="lx-fem-closing-actions">
            <a href="{{ section.settings.closing_btn1_link }}" class="btn btn-primary">{{ section.settings.closing_btn1_text }}</a>
            <a href="{{ section.settings.closing_btn2_link }}" class="btn btn-ghost">{{ section.settings.closing_btn2_text }}</a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</section>

<script>
(function(){
  var section = document.getElementById('lx-fem-{{ section.id }}');
  if (!section) return;

  // Reading progress bar
  var bar = document.getElementById('lx-fem-progress-{{ section.id }}');
  if (bar) {
    window.addEventListener('scroll', function(){
      var rect = section.getBoundingClientRect();
      var winH = window.innerHeight;
      var total = section.offsetHeight - winH;
      var scrolled = Math.max(0, -rect.top);
      var pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
      bar.style.width = pct + '%';
    }, { passive: true });
  }

  // Counter animation
  function animateCount(el, target, duration) {
    var start = 0;
    var startTime = null;
    function step(timestamp) {
      if (!startTime) startTime = timestamp;
      var progress = Math.min((timestamp - startTime) / duration, 1);
      var val = Math.floor(progress * target);
      el.textContent = target >= 1000000 ? (val / 1000000).toFixed(0) + 'M' :
                       target >= 1000 ? (val / 1000).toFixed(0) + 'k' : val;
      if (progress < 1) requestAnimationFrame(step);
      else el.textContent = target >= 1000000 ? (target / 1000000) + 'M' :
                            target >= 1000 ? (target / 1000) + 'k' : target;
    }
    requestAnimationFrame(step);
  }
  if ('IntersectionObserver' in window) {
    var counters = section.querySelectorAll('.lx-fem-counter-num');
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) {
          var target = parseInt(e.target.dataset.target, 10);
          animateCount(e.target, target, 1500);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.4 });
    counters.forEach(function(c){ io.observe(c); });
  }
})();
</script>

{% stylesheet %}
/* ============================================================
   FEMALE PAGE — femalepage.liquid
   Root wrapper: .lx-fem
   All rules scoped to avoid global collisions.
   Pink accent (var(--lx-pink)) used for female category.
   ============================================================ */

/* ---- Floating female symbols ---- */
.lx-fem {
  position: relative;
  overflow: hidden;
}

.lx-fem-symbols {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.lx-fem-symbol {
  position: absolute;
  font-size: clamp(1.2rem, 2.5vw, 2rem);
  color: var(--lx-pink);
  opacity: 0.04;
  animation: lx-fem-float 18s ease-in-out infinite;
  user-select: none;
  line-height: 1;
}

.lx-fem-symbol--1 { top: 8%;  left: 7%;  animation-delay: 0s;   animation-duration: 20s; }
.lx-fem-symbol--2 { top: 18%; left: 82%; animation-delay: 2.5s; animation-duration: 17s; }
.lx-fem-symbol--3 { top: 35%; left: 15%; animation-delay: 5s;   animation-duration: 22s; }
.lx-fem-symbol--4 { top: 55%; left: 90%; animation-delay: 1.5s; animation-duration: 19s; }
.lx-fem-symbol:nth-child(5)  { top: 70%; left: 4%;  animation-delay: 3s;   animation-duration: 21s; }
.lx-fem-symbol:nth-child(6)  { top: 82%; left: 75%; animation-delay: 6s;   animation-duration: 18s; }
.lx-fem-symbol:nth-child(7)  { top: 12%; left: 45%; animation-delay: 4s;   animation-duration: 23s; }
.lx-fem-symbol:nth-child(8)  { top: 47%; left: 55%; animation-delay: 7s;   animation-duration: 16s; }
.lx-fem-symbol:nth-child(9)  { top: 90%; left: 30%; animation-delay: 0.5s; animation-duration: 25s; }
.lx-fem-symbol:nth-child(10) { top: 60%; left: 65%; animation-delay: 8s;   animation-duration: 20s; }
.lx-fem-symbol:nth-child(11) { top: 25%; left: 28%; animation-delay: 3.5s; animation-duration: 19s; }
.lx-fem-symbol:nth-child(12) { top: 78%; left: 48%; animation-delay: 9s;   animation-duration: 22s; }

@keyframes lx-fem-float {
  0%, 100% { transform: translateY(0) scale(1); }
  50%       { transform: translateY(-18px) scale(1.05); }
}

/* ---- Reading progress bar ---- */
.lx-fem-progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 3px;
  width: 0%;
  background: linear-gradient(90deg, var(--lx-pink), var(--lx-blue));
  z-index: 999;
  border-radius: 0 2px 2px 0;
  transition: width .1s linear;
}

/* ---- Section content above decorations ---- */
.lx-fem > *:not(.lx-fem-symbols):not(.lx-fem-progress) {
  position: relative;
  z-index: 1;
}

/* ---- Shared inner layout ---- */
.lx-fem-section-head {
  text-align: center;
  max-width: 640px;
  margin-inline: auto;
  margin-bottom: clamp(2.5rem, 4vw, 4rem);
  display: flex;
  flex-direction: column;
  gap: .7rem;
}

.lx-fem-section-head h2 {
  font-size: clamp(1.5rem, 2.6vw, 2.1rem);
  color: var(--lx-navy);
  margin: 0;
}

.lx-fem-section-head p {
  color: var(--lx-muted);
  font-size: 1rem;
  margin: 0;
}

/* Mini eyebrow — pink accent for female page */
.lx-fem-mini-eyebrow {
  display: inline-block;
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--lx-pink);
}

/* ---- HERO ---- */
.lx-fem-hero {
  padding-block: clamp(4.5rem, 9vw, 8.5rem) clamp(3rem, 6vw, 5.5rem);
  background: var(--lx-bg);
  text-align: center;
}

.lx-fem-hero-inner {
  max-width: 760px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.35rem;
}

.lx-fem-hero-eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .6rem;
  color: var(--lx-pink);
}

.lx-fem-hero-eyebrow .eyebrow {
  color: var(--lx-pink);
  letter-spacing: .14em;
}

.lx-fem-hero-eyebrow i {
  font-size: 1.15rem;
  opacity: .7;
}

.lx-fem-hero h1 {
  margin: 0;
  font-size: clamp(2rem, 4.5vw, 3.25rem);
  color: var(--lx-navy);
  line-height: 1.18;
  max-width: 680px;
}

.lx-fem-hero-lead {
  font-size: clamp(1.03rem, 1.6vw, 1.15rem);
  color: var(--lx-muted);
  line-height: 1.7;
  max-width: 600px;
  margin: 0;
}

/* Key stat banner */
.lx-fem-keystat {
  display: flex;
  align-items: center;
  gap: 1.1rem;
  background: linear-gradient(135deg, #fbeff6 0%, #fef4fb 100%);
  border: 1px solid rgba(200, 69, 138, .18);
  border-radius: var(--lx-r-lg);
  padding: 1.1rem 1.8rem;
  margin-top: .5rem;
}

.lx-fem-keystat-num {
  font-family: var(--lx-display);
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 800;
  color: var(--lx-pink);
  letter-spacing: -.03em;
  line-height: 1;
  white-space: nowrap;
}

.lx-fem-keystat-text {
  display: flex;
  flex-direction: column;
  gap: .2rem;
  text-align: left;
}

.lx-fem-keystat-text strong {
  font-size: .95rem;
  font-weight: 700;
  color: var(--lx-navy);
  line-height: 1.3;
}

.lx-fem-keystat-text span {
  font-size: .82rem;
  color: var(--lx-muted);
}

/* ---- COUNTERS ---- */
.lx-fem-counters {
  padding-block: clamp(2.5rem, 5vw, 4rem);
  background: var(--lx-navy);
}

.lx-fem-counters-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: rgba(255,255,255,.1);
  border-radius: var(--lx-r);
  overflow: hidden;
}

.lx-fem-counter {
  background: var(--lx-navy);
  padding: clamp(1.5rem, 3vw, 2.25rem) 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: .2rem;
  text-align: center;
}

.lx-fem-counter--accent {
  background: #0a253a;
}

.lx-fem-counter-num {
  font-family: var(--lx-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  color: #fff;
  letter-spacing: -.03em;
  line-height: 1;
}

.lx-fem-counter--accent .lx-fem-counter-num {
  color: var(--lx-pink);
}

.lx-fem-counter-unit {
  font-family: var(--lx-display);
  font-size: clamp(1rem, 1.8vw, 1.35rem);
  font-weight: 700;
  color: rgba(255,255,255,.5);
  line-height: 1;
}

.lx-fem-counter--accent .lx-fem-counter-unit {
  color: rgba(200, 69, 138, .6);
}

.lx-fem-counter p {
  font-size: .78rem;
  color: rgba(255,255,255,.5);
  letter-spacing: .04em;
  text-transform: uppercase;
  margin: .25rem 0 0;
}

/* ---- TYPES OF INFERTILITY ---- */
.lx-fem-types {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg-soft);
}

.lx-fem-types-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(1.5rem, 3vw, 2.5rem);
}

.lx-fem-type {
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r-lg);
  padding: clamp(1.75rem, 3vw, 2.75rem);
  display: flex;
  flex-direction: column;
  gap: 1rem;
  transition: transform var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease),
              border-color var(--lx-dur) var(--lx-ease);
}

.lx-fem-type:hover {
  transform: translateY(-4px);
  box-shadow: var(--lx-sh-lg);
  border-color: transparent;
}

.lx-fem-type-icon {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: var(--lx-blue-050);
  color: var(--lx-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.6rem;
  flex-shrink: 0;
}

.lx-fem-type-icon--accent {
  background: #fbeff6;
  color: var(--lx-pink);
}

.lx-fem-type h3 {
  font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  color: var(--lx-navy);
  margin: 0;
}

.lx-fem-type p {
  color: var(--lx-muted);
  font-size: .95rem;
  line-height: 1.65;
  margin: 0;
}

/* ---- FACTS (alternating) ---- */
.lx-fem-facts {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg);
}

.lx-fem-fact {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: clamp(2rem, 4vw, 4rem);
  align-items: center;
  padding-block: clamp(2rem, 4vw, 3.5rem);
  border-bottom: 1px solid var(--lx-line);
}

.lx-fem-fact:last-child {
  border-bottom: none;
}

.lx-fem-fact--alt {
  grid-template-columns: 1fr 2fr;
}

.lx-fem-fact--alt .lx-fem-fact-visual {
  order: -1;
}

.lx-fem-fact-text {
  display: flex;
  flex-direction: column;
  gap: .75rem;
}

.lx-fem-fact-num {
  font-family: var(--lx-display);
  font-size: 3rem;
  font-weight: 900;
  color: var(--lx-line-strong);
  line-height: 1;
  letter-spacing: -.04em;
}

.lx-fem-fact-text h3 {
  font-size: clamp(1.15rem, 1.8vw, 1.4rem);
  color: var(--lx-navy);
  margin: 0;
  line-height: 1.3;
}

.lx-fem-fact-body {
  color: var(--lx-muted);
  font-size: .97rem;
  line-height: 1.7;
}

.lx-fem-fact-visual {
  display: flex;
  align-items: center;
  justify-content: center;
}

.lx-fem-fact-stat {
  background: linear-gradient(135deg, #fbeff6 0%, #fef4fb 100%);
  border: 1px solid rgba(200, 69, 138, .15);
  border-radius: var(--lx-r-lg);
  padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.25rem);
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: .4rem;
  width: 100%;
}

.lx-fem-fact-stat strong {
  display: block;
  font-family: var(--lx-display);
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  font-weight: 800;
  color: var(--lx-pink);
  letter-spacing: -.03em;
  line-height: 1.1;
}

.lx-fem-fact-stat span {
  font-size: .82rem;
  color: var(--lx-muted);
  letter-spacing: .04em;
  text-transform: uppercase;
}

/* ---- CAUSES GRID ---- */
.lx-fem-causes {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg-soft);
}

.lx-fem-causes-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: clamp(1rem, 2vw, 1.5rem);
}

.lx-fem-cause {
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r);
  padding: clamp(1.25rem, 2.5vw, 1.75rem);
  display: flex;
  flex-direction: column;
  gap: .7rem;
  transition: transform var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease),
              border-color var(--lx-dur) var(--lx-ease);
}

.lx-fem-cause:hover {
  transform: translateY(-3px);
  box-shadow: var(--lx-sh);
  border-color: rgba(200, 69, 138, .2);
}

.lx-fem-cause-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: #fbeff6;
  color: var(--lx-pink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.35rem;
  flex-shrink: 0;
}

.lx-fem-cause h3 {
  font-size: .97rem;
  font-weight: 700;
  color: var(--lx-navy);
  margin: 0;
}

.lx-fem-cause p {
  font-size: .87rem;
  color: var(--lx-muted);
  line-height: 1.6;
  margin: 0;
}

/* ---- RISK FACTORS ---- */
.lx-fem-risks {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg);
}

.lx-fem-risks-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: clamp(1rem, 2vw, 1.5rem);
}

.lx-fem-risk {
  background: var(--lx-bg-alt);
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r);
  padding: clamp(1rem, 2vw, 1.5rem);
  display: flex;
  flex-direction: column;
  gap: .5rem;
  transition: border-color var(--lx-dur) var(--lx-ease),
              background var(--lx-dur) var(--lx-ease);
}

.lx-fem-risk:hover {
  border-color: rgba(200, 69, 138, .25);
  background: #fbeff6;
}

.lx-fem-risk-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: rgba(200, 69, 138, .1);
  color: var(--lx-pink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.15rem;
}

.lx-fem-risk strong {
  font-size: .9rem;
  font-weight: 700;
  color: var(--lx-navy);
}

.lx-fem-risk span {
  font-size: .82rem;
  color: var(--lx-muted);
  line-height: 1.5;
}

/* ---- TREATMENTS ---- */
.lx-fem-treatments {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg-soft);
}

.lx-fem-treatments-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: clamp(1.25rem, 2.5vw, 2rem);
}

.lx-fem-treatment {
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r-lg);
  padding: clamp(1.5rem, 3vw, 2.25rem);
  display: flex;
  flex-direction: column;
  gap: .85rem;
  transition: transform var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease),
              border-color var(--lx-dur) var(--lx-ease);
}

.lx-fem-treatment:hover {
  transform: translateY(-4px);
  box-shadow: var(--lx-sh-lg);
  border-color: transparent;
}

.lx-fem-treatment-icon {
  width: 46px;
  height: 46px;
  border-radius: 13px;
  background: var(--lx-blue-050);
  color: var(--lx-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.45rem;
}

.lx-fem-treatment h3 {
  font-size: 1rem;
  font-weight: 700;
  color: var(--lx-navy);
  margin: 0;
}

.lx-fem-treatment p {
  font-size: .88rem;
  color: var(--lx-muted);
  line-height: 1.6;
  margin: 0;
}

/* ---- WHEN TO GET HELP callout ---- */
.lx-fem-help {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg);
}

.lx-fem-help-card {
  background: linear-gradient(135deg, #fbeff6 0%, #fef4fb 100%);
  border: 1px solid rgba(200, 69, 138, .18);
  border-radius: var(--lx-r-lg);
  padding: clamp(2rem, 4vw, 3.5rem);
  display: grid;
  grid-template-columns: auto 1fr;
  gap: clamp(1.5rem, 3vw, 2.5rem);
  align-items: start;
}

.lx-fem-help-icon {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  background: var(--lx-pink);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
  flex-shrink: 0;
}

.lx-fem-help-content {
  display: flex;
  flex-direction: column;
  gap: .85rem;
}

.lx-fem-help-content h2 {
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  color: var(--lx-navy);
  margin: 0;
}

.lx-fem-help-content .rte {
  color: var(--lx-ink);
  font-size: .97rem;
  line-height: 1.7;
}

.lx-fem-help-points {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: .5rem;
}

.lx-fem-help-point {
  display: flex;
  align-items: flex-start;
  gap: .6rem;
  background: rgba(255,255,255,.7);
  border: 1px solid rgba(200, 69, 138, .15);
  border-radius: var(--lx-r-sm);
  padding: .75rem 1rem;
  flex: 1;
  min-width: 170px;
}

.lx-fem-help-point i {
  color: var(--lx-pink);
  font-size: 1.2rem;
  flex-shrink: 0;
  margin-top: .1rem;
}

.lx-fem-help-point strong {
  display: block;
  font-size: .88rem;
  font-weight: 700;
  color: var(--lx-navy);
}

.lx-fem-help-point span {
  display: block;
  font-size: .8rem;
  color: var(--lx-muted);
  margin-top: .15rem;
}

/* ---- CLOSING CTA ---- */
.lx-fem-closing {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg-soft);
}

.lx-fem-closing-card {
  background: var(--lx-navy);
  border-radius: var(--lx-r-lg);
  padding: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 5vw, 4rem);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  box-shadow: var(--lx-sh-blue);
}

.lx-fem-closing-card h2 {
  color: #fff;
  font-size: clamp(1.5rem, 3vw, 2.25rem);
  margin: 0;
}

.lx-fem-closing-card p {
  color: rgba(255,255,255,.7);
  font-size: 1.05rem;
  margin: 0;
  max-width: 520px;
}

.lx-fem-closing-actions {
  display: flex;
  flex-wrap: wrap;
  gap: .75rem;
  justify-content: center;
  margin-top: .5rem;
}

/* Ghost button on dark card */
.lx-fem-closing-card .btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  padding: .65rem 1.4rem;
  border-radius: var(--lx-pill);
  border: 1.5px solid rgba(255,255,255,.3);
  color: rgba(255,255,255,.85);
  font-size: .92rem;
  font-weight: 600;
  background: transparent;
  text-decoration: none;
  transition: border-color var(--lx-dur) var(--lx-ease),
              background var(--lx-dur) var(--lx-ease),
              color var(--lx-dur) var(--lx-ease);
}
.lx-fem-closing-card .btn-ghost:hover {
  border-color: rgba(255,255,255,.7);
  background: rgba(255,255,255,.1);
  color: #fff;
}

/* ---- Responsive ---- */
@media (max-width: 860px) {
  .lx-fem-counters-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .lx-fem-types-grid {
    grid-template-columns: 1fr;
  }
  .lx-fem-fact,
  .lx-fem-fact--alt {
    grid-template-columns: 1fr;
  }
  .lx-fem-fact--alt .lx-fem-fact-visual {
    order: 0;
  }
  .lx-fem-help-card {
    grid-template-columns: 1fr;
  }
  .lx-fem-help-icon {
    width: 48px;
    height: 48px;
    font-size: 1.5rem;
  }
}

@media (max-width: 520px) {
  .lx-fem-counters-grid {
    grid-template-columns: 1fr 1fr;
  }
  .lx-fem-keystat {
    flex-direction: column;
    text-align: center;
  }
  .lx-fem-keystat-text {
    text-align: center;
  }
  .lx-fem-causes-grid,
  .lx-fem-risks-grid,
  .lx-fem-treatments-grid {
    grid-template-columns: 1fr;
  }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .lx-fem-symbol {
    animation: none;
  }
  .lx-fem-type,
  .lx-fem-cause,
  .lx-fem-treatment {
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Female Page",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Female fertility facts" },
