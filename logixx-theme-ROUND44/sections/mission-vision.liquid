{%- comment -%}
  Mission / Vision — reusable alternating split section.
  Use "Image side" setting to flip layout. Drop in twice for an alternating pair.
{%- endcomment -%}

<section class="lx-mv lx-mv--img-{{ section.settings.image_side | default: 'right' }}"
         style="background: {{ section.settings.bg_color | default: '#FFFFFF' }};">
  <div class="lx-mv-inner">

    <div class="lx-mv-text">
      {% if section.settings.eyebrow != blank %}
        <p class="lx-mv-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="lx-mv-heading">{{ section.settings.heading | default: 'Our mission' }}</h2>
      {% if section.settings.body != blank %}
        <div class="lx-mv-body">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
        <a href="{{ section.settings.cta_link }}" class="lx-mv-cta">
          {{ section.settings.cta_text }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      {% endif %}
    </div>

    <div class="lx-mv-media">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading }}" loading="lazy">
      {% else %}
        <div class="lx-mv-placeholder"><i class="ph ph-image"></i></div>
      {% endif %}
    </div>

  </div>
</section>

{% stylesheet %}
.lx-mv{ padding-block:clamp(3.5rem,7vw,6.5rem); }
.lx-mv-inner{ max-width:var(--lx-container); margin-inline:auto; padding-inline:clamp(1.1rem,4vw,2rem); display:grid; grid-template-columns:1fr 1fr; gap:clamp(2.5rem,6vw,5rem); align-items:center; }
.lx-mv--img-left .lx-mv-media{ order:-1; }
.lx-mv-eyebrow{ display:inline-block; text-transform:uppercase; letter-spacing:.14em; font-size:.78rem; font-weight:700; color:var(--lx-blue-ink); margin-bottom:1rem; }
.lx-mv-heading{ font-family:var(--lx-display); color:var(--lx-navy); font-size:clamp(1.6rem,4vw,2.4rem); margin:0 0 1.1rem; }
.lx-mv-body{ color:var(--lx-muted); line-height:1.75; }
.lx-mv-body p{ margin:0 0 1rem; }
.lx-mv-cta{ display:inline-flex; align-items:center; gap:.5rem; margin-top:1.5rem; color:var(--lx-blue-ink); font-weight:600; text-decoration:none; font-size:.95rem; transition:gap var(--lx-dur) var(--lx-ease); }
.lx-mv-cta svg{ width:16px; height:16px; flex:none; transition:transform var(--lx-dur) var(--lx-ease); }
.lx-mv-cta:hover{ gap:.75rem; }
.lx-mv-cta:hover svg{ transform:translateX(4px); }
.lx-mv-media img{ width:100%; border-radius:var(--lx-r-lg); box-shadow:var(--lx-sh-lg); display:block; aspect-ratio:4/3; object-fit:cover; }
.lx-mv-placeholder{ aspect-ratio:4/3; background:var(--lx-bg-soft); border-radius:var(--lx-r-lg); display:flex; align-items:center; justify-content:center; color:var(--lx-faint); font-size:3rem; }
@media(max-width:860px){ .lx-mv-inner{ grid-template-columns:1fr; } .lx-mv--img-left .lx-mv-media{ order:unset; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Mission / Vision",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "default": "right",
      "options": [
        { "value": "right", "label": "Image right, text left" },
        { "value": "left", "label": "Image left, text right" }
      ]
    },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#FFFFFF" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our mission" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Science at the heart of every family" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>We exist to give every couple the best possible chance of a healthy pregnancy — through clinically backed supplements, clear guidance and genuine support at every step.</p>" },
    { "type": "header", "content": "Button (optional)" },
    { "type": "text", "id": "cta_text", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [
    { "name": "Mission / Vision" }
  ]
}
{% endschema %}
