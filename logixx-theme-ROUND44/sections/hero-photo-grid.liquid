{%- comment -%}
  Hero — testhim-style split: text + CTAs left, photo grid right.
{%- endcomment -%}

<section class="hero-th">
  <div class="hero-th-arc" data-parallax="0.2" aria-hidden="true"></div>
  <div class="hero-th-inner">

    {%- comment -%} ---- LEFT: Content ---- {%- endcomment -%}
    <div class="hero-th-content">
      {% if section.settings.eyebrow != blank %}
        <span class="hero-th-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h1 class="hero-th-heading">
        {{ section.settings.heading_pre | default: 'Shaping the future of' }}
        <span class="hero-th-heading-accent">{{ section.settings.heading_accent | default: 'fertility' }}</span>
      </h1>
      {% if section.settings.subheading != blank %}
        <p class="hero-th-sub">{{ section.settings.subheading }}</p>
      {% endif %}
      <div class="hero-th-actions">
        {% if section.settings.btn1_link != blank and section.settings.btn1_text != blank %}
          <a href="{{ section.settings.btn1_link }}" class="hero-th-btn hero-th-btn--primary">
            <span>{{ section.settings.btn1_text }}</span>
            <span class="hero-th-btn-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </a>
        {% endif %}
        {% if section.settings.btn2_link != blank and section.settings.btn2_text != blank %}
          <a href="{{ section.settings.btn2_link }}" class="hero-th-btn hero-th-btn--secondary">
            <span>{{ section.settings.btn2_text }}</span>
            <span class="hero-th-btn-arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </a>
        {% endif %}
      </div>
    </div>

    {%- comment -%} ---- RIGHT: Photo grid ---- {%- endcomment -%}
    <div class="hero-th-photos" aria-hidden="true">
      {%- comment -%} Collect all non-blank photos into odd (left) / even (right) groups {%- endcomment -%}
      <div class="hero-th-col hero-th-col--up">
        {%- for i in (1..12) -%}
          {%- assign img_key = 'photo_' | append: i -%}
          {%- assign img = section.settings[img_key] -%}
          {%- assign rem = i | modulo: 2 -%}
          {%- if img != blank and rem == 1 -%}
            <div class="hero-th-photo"><img src="{{ img | image_url: width: 600 }}" alt="" loading="lazy"></div>
          {%- endif -%}
        {%- endfor -%}
        {%- comment -%} Duplicate for seamless scroll {%- endcomment -%}
        {%- for i in (1..12) -%}
          {%- assign img_key = 'photo_' | append: i -%}
          {%- assign img = section.settings[img_key] -%}
          {%- assign rem = i | modulo: 2 -%}
          {%- if img != blank and rem == 1 -%}
            <div class="hero-th-photo"><img src="{{ img | image_url: width: 600 }}" alt="" loading="lazy"></div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="hero-th-col hero-th-col--down">
        {%- for i in (1..12) -%}
          {%- assign img_key = 'photo_' | append: i -%}
          {%- assign img = section.settings[img_key] -%}
          {%- assign rem = i | modulo: 2 -%}
          {%- if img != blank and rem == 0 -%}
            <div class="hero-th-photo"><img src="{{ img | image_url: width: 600 }}" alt="" loading="lazy"></div>
          {%- endif -%}
        {%- endfor -%}
        {%- for i in (1..12) -%}
          {%- assign img_key = 'photo_' | append: i -%}
          {%- assign img = section.settings[img_key] -%}
          {%- assign rem = i | modulo: 2 -%}
          {%- if img != blank and rem == 0 -%}
            <div class="hero-th-photo"><img src="{{ img | image_url: width: 600 }}" alt="" loading="lazy"></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
/* ============================================================
   hero-photo-grid / hero-th  — scoped to .hero-th
   All rules are scoped under .hero-th to prevent collisions
   with .hero (owned by hero.liquid) and global foundation.
   ============================================================ */

/* --- Section shell --- */
.hero-th {
  position: relative;
  background: var(--lx-bg);
  overflow: hidden;
  min-height: 100dvh;
  display: flex;
  align-items: center;
}

/* Decorative arc background blob */
.hero-th-arc {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(ellipse 70% 80% at 100% 50%, var(--lx-blue-050) 0%, transparent 70%);
  z-index: 0;
}

/* --- Two-column inner layout --- */
.hero-th-inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: clamp(2.5rem, 5vw, 5rem);
  max-width: var(--lx-container);
  margin-inline: auto;
  padding-inline: clamp(1.1rem, 4vw, 2rem);
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  width: 100%;
}

/* --- Left: Content --- */
.hero-th-content {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.hero-th-eyebrow {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--lx-blue-ink);
}

.hero-th-heading {
  font-family: var(--lx-display);
  font-size: clamp(2.4rem, 5.5vw, 4rem);
  font-weight: 800;
  line-height: 1.1;
  color: var(--lx-navy);
  margin: 0;
}

.hero-th-heading-accent {
  color: var(--lx-blue);
}

.hero-th-sub {
  font-size: clamp(1rem, 1.6vw, 1.125rem);
  color: var(--lx-muted);
  line-height: 1.7;
  max-width: 50ch;
  margin: 0;
}

/* --- CTA buttons --- */
.hero-th-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 0.5rem;
}

.hero-th-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.85rem 1.75rem;
  border-radius: var(--lx-pill);
  font-family: var(--lx-body);
  font-size: 0.9375rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: transform var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease);
}

.hero-th-btn--primary {
  background: var(--lx-blue);
  color: #fff;
  box-shadow: var(--lx-sh-blue);
}

.hero-th-btn--primary:hover,
.hero-th-btn--primary:focus-visible {
  background: var(--lx-blue-600);
  transform: translateY(-3px);
  box-shadow: var(--lx-sh-lg);
}

.hero-th-btn--secondary {
  background: transparent;
  color: var(--lx-ink);
  border: 2px solid var(--lx-line-strong);
}

.hero-th-btn--secondary:hover,
.hero-th-btn--secondary:focus-visible {
  border-color: var(--lx-blue);
  color: var(--lx-blue);
  transform: translateY(-3px);
}

.hero-th-btn-arrow {
  display: inline-flex;
  align-items: center;
  transition: transform var(--lx-dur) var(--lx-ease);
}

.hero-th-btn:hover .hero-th-btn-arrow {
  transform: translateX(3px);
}

/* --- Right: Photo grid --- */
.hero-th-photos {
  display: flex;
  gap: 0.75rem;
  height: clamp(480px, 70dvh, 760px);
  overflow: hidden;
  border-radius: var(--lx-r-lg);
}

.hero-th-col {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex: 1 1 0;
  overflow: hidden;
}

/* Left col scrolls up */
.hero-th-col--up {
  animation: hero-th-scroll-up 28s linear infinite;
}

/* Right col scrolls down */
.hero-th-col--down {
  animation: hero-th-scroll-down 32s linear infinite;
}

/* Pause on hover over the photo area */
.hero-th-photos:hover .hero-th-col--up,
.hero-th-photos:hover .hero-th-col--down {
  animation-play-state: paused;
}

@keyframes hero-th-scroll-up {
  from { transform: translateY(0); }
  to   { transform: translateY(-50%); }
}

@keyframes hero-th-scroll-down {
  from { transform: translateY(-50%); }
  to   { transform: translateY(0); }
}

.hero-th-photo {
  border-radius: var(--lx-r);
  overflow: hidden;
  flex-shrink: 0;
  aspect-ratio: 3 / 4;
}

.hero-th-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.6s var(--lx-ease);
}

.hero-th-photo:hover img {
  transform: scale(1.04);
}

/* --- Responsive --- */
@media (max-width: 860px) {
  .hero-th-inner {
    grid-template-columns: 1fr;
  }
  .hero-th-photos {
    height: clamp(280px, 45vw, 420px);
    order: -1;
  }
}

@media (max-width: 520px) {
  .hero-th-photos {
    height: 260px;
    gap: 0.5rem;
  }
  .hero-th-col {
    gap: 0.5rem;
  }
  .hero-th-actions {
    flex-direction: column;
    align-items: flex-start;
  }
  .hero-th-btn {
    width: 100%;
    justify-content: center;
  }
}

/* Reduced-motion: disable scroll animation */
@media (prefers-reduced-motion: reduce) {
  .hero-th-col--up,
  .hero-th-col--down {
    animation: none;
    transform: translateY(0);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — testhim style",
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "heading_pre", "label": "Heading (main part)", "default": "Shaping the future of" },
    { "type": "text", "id": "heading_accent", "label": "Heading (accent — light blue)", "default": "fertility" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Our mission is to create positive change in the world of fertility by providing science-backed supplements, education and ongoing support for couples." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn1_text", "label": "Primary button label", "default": "Shop the range" },
    { "type": "url", "id": "btn1_link", "label": "Primary button link" },
    { "type": "text", "id": "btn2_text", "label": "Secondary button label", "default": "Our story" },
    { "type": "url", "id": "btn2_link", "label": "Secondary button link" },
    { "type": "header", "content": "Photo grid" },
    { "type": "paragraph", "content": "Upload 4–12 lifestyle photos. Portrait (3:4) works best. They auto-split across two scrolling columns (left scrolls up, right scrolls down). Add at least 4 so both columns move." },
    { "type": "image_picker", "id": "photo_1", "label": "Photo 1" },
