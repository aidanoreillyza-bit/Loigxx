<article class="lx-article">

  <!-- HERO -->
  <div class="lx-article-hero">
    <div class="container">
      <a href="{{ blog.url }}" class="lx-article-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to news
      </a>

      <div class="lx-article-hero-inner">
        {% if article.tags.size > 0 %}
          <div class="lx-article-tags">
            {% for tag in article.tags limit: 3 %}
              <span class="lx-article-tag">{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}

        <h1>{{ article.title }}</h1>

        <div class="lx-article-meta">
          <span><i class="ph ph-calendar"></i> {{ article.published_at | date: '%B %-d, %Y' }}</span>
          {% if article.author != blank %}
            <span><i class="ph ph-user"></i> {{ article.author }}</span>
          {% endif %}
          <span><i class="ph ph-clock"></i> {{ article.content | strip_html | split: ' ' | size | divided_by: 200 }} min read</span>
        </div>
      </div>
    </div>
  </div>

  <!-- FEATURED IMAGE -->
  {% if article.image %}
    <div class="lx-article-image">
      <div class="container">
        <img src="{{ article.image | image_url: width: 1600 }}" alt="{{ article.title }}">
      </div>
    </div>
  {% endif %}

  <!-- CONTENT -->
  <div class="lx-article-content">
    <div class="container">
      <div class="lx-article-body rte">
        {{ article.content }}
      </div>

      <!-- Share row -->
      <div class="lx-article-share">
        <span class="lx-article-share-label">Share this article</span>
        <div class="lx-article-share-buttons">
          <a href="https://twitter.com/intent/tweet?text={{ article.title | url_encode }}&url={{ shop.url }}{{ article.url }}" target="_blank" rel="noopener" aria-label="Share on Twitter"><i class="ph ph-x-logo"></i></a>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shop.url }}{{ article.url }}" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><i class="ph ph-linkedin-logo"></i></a>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}" target="_blank" rel="noopener" aria-label="Share on Facebook"><i class="ph ph-facebook-logo"></i></a>
          <a href="mailto:?subject={{ article.title | url_encode }}&body={{ shop.url }}{{ article.url }}" aria-label="Share via email"><i class="ph ph-envelope"></i></a>
        </div>
      </div>
    </div>
  </div>

  <!-- RELATED / OTHER ARTICLES -->
  {% if blog.articles.size > 1 %}
    <div class="lx-article-related">
      <div class="container">
        <div class="lx-article-related-head">
          <span class="eyebrow">{{ section.settings.related_eyebrow }}</span>
          <h2>{{ section.settings.related_heading }}</h2>
        </div>
        <div class="lx-article-related-grid">
          {% assign count = 0 %}
          {% for related in blog.articles %}
            {% if related.id != article.id and count < 3 %}
              <a href="{{ related.url }}" class="lx-blog-card">
                <div class="lx-blog-card-media">
                  {% if related.image %}
                    <img src="{{ related.image | image_url: width: 800 }}" alt="{{ related.title }}">
                  {% else %}
                    <div class="lx-blog-placeholder"><i class="ph ph-newspaper"></i></div>
                  {% endif %}
                </div>
                <div class="lx-blog-card-body">
                  {% if related.tags.size > 0 %}
                    <div class="lx-blog-tags">
                      {% for tag in related.tags limit: 1 %}
                        <span class="lx-blog-tag">{{ tag }}</span>
                      {% endfor %}
                    </div>
                  {% endif %}
                  <h3>{{ related.title }}</h3>
                  <p>{{ related.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
                  <div class="lx-blog-card-meta">
                    <span><i class="ph ph-calendar"></i> {{ related.published_at | date: '%b %-d, %Y' }}</span>
                  </div>
                </div>
              </a>
              {% assign count = count | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- CLOSING CTA -->
  {% if section.settings.show_closing %}
    <div class="lx-blog-closing">
      <div class="container">
        <div class="lx-blog-closing-card">
          {% if section.settings.closing_heading != blank %}<h2>{{ section.settings.closing_heading }}</h2>{% endif %}
          <p>{{ section.settings.closing_sub }}</p>
          <div class="lx-blog-closing-actions">
            <a href="{{ section.settings.closing_btn1_link }}" class="btn btn-primary">{{ section.settings.closing_btn1_text }}</a>
            <a href="{{ section.settings.closing_btn2_link }}" class="btn btn-ghost">{{ section.settings.closing_btn2_text }}</a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</article>

{% stylesheet %}
.lx-article{ font-family:var(--lx-body); }
.lx-article-hero{ padding-block:clamp(3rem,6vw,5rem); background:var(--lx-bg-soft); border-bottom:1px solid var(--lx-line); }
.lx-article-back{ display:inline-flex; align-items:center; gap:.45rem; font-size:.85rem; font-weight:600; color:var(--lx-blue-ink); text-decoration:none; margin-bottom:2rem; transition:gap var(--lx-dur); }
.lx-article-back:hover{ gap:.7rem; }
.lx-article-hero-inner{ max-width:760px; }
.lx-article-tags{ display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:1.1rem; }
.lx-article-tag{ background:var(--lx-blue-050); color:var(--lx-blue-ink); padding:.25rem .75rem; border-radius:var(--lx-pill); font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; }
.lx-article-hero h1{ margin:0 0 1.1rem; font-size:clamp(1.6rem,4vw,2.5rem); color:var(--lx-navy); }
.lx-article-meta{ display:flex; flex-wrap:wrap; gap:.75rem 1.5rem; font-size:.85rem; color:var(--lx-muted); }
.lx-article-meta i{ margin-right:.3rem; }
.lx-article-image{ padding-block:2.5rem 0; }
.lx-article-image img{ width:100%; border-radius:var(--lx-r-lg); box-shadow:var(--lx-sh-lg); display:block; max-height:520px; object-fit:cover; }
.lx-article-content{ padding-block:3rem 4rem; }
.lx-article-body.rte{ max-width:760px; font-size:1.05rem; line-height:1.8; color:var(--lx-ink); }
.lx-article-body.rte p{ margin-bottom:1.2rem; }
.lx-article-body.rte h2,.lx-article-body.rte h3{ color:var(--lx-navy); margin-top:2rem; }
.lx-article-body.rte a{ color:var(--lx-blue-ink); }
.lx-article-body.rte ul,.lx-article-body.rte ol{ padding-left:1.4rem; margin-bottom:1.2rem; }
.lx-article-body.rte li{ margin-bottom:.5rem; }
.lx-article-share{ display:flex; align-items:center; gap:1rem; flex-wrap:wrap; margin-top:3rem; padding-top:1.5rem; border-top:1px solid var(--lx-line); max-width:760px; }
.lx-article-share-label{ font-size:.85rem; font-weight:600; color:var(--lx-muted); }
.lx-article-share-buttons{ display:flex; gap:.5rem; }
.lx-article-share-buttons a{ width:38px; height:38px; border-radius:50%; background:var(--lx-bg-soft); border:1px solid var(--lx-line); display:flex; align-items:center; justify-content:center; color:var(--lx-muted); font-size:1.1rem; text-decoration:none; transition:background var(--lx-dur), color var(--lx-dur), border-color var(--lx-dur); }
.lx-article-share-buttons a:hover{ background:var(--lx-blue); color:#fff; border-color:var(--lx-blue); }
.lx-article-related{ padding-block:clamp(3rem,6vw,5rem); background:var(--lx-bg-soft); border-top:1px solid var(--lx-line); }
.lx-article-related-head{ margin-bottom:2rem; }
.lx-article-related-head .eyebrow{ margin-bottom:.5rem; }
.lx-article-related-head h2{ margin:0; font-size:clamp(1.3rem,3vw,1.8rem); }
.lx-article-related-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }
.lx-blog-card{ display:flex; flex-direction:column; background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); overflow:hidden; text-decoration:none; color:inherit; transition:transform var(--lx-dur) var(--lx-ease), box-shadow var(--lx-dur) var(--lx-ease), border-color var(--lx-dur); }
.lx-blog-card:hover{ transform:translateY(-4px); box-shadow:var(--lx-sh-lg); border-color:transparent; }
.lx-blog-card-media{ aspect-ratio:16/9; overflow:hidden; background:var(--lx-bg-soft); }
.lx-blog-card-media img{ width:100%; height:100%; object-fit:cover; }
.lx-blog-placeholder{ width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:2rem; color:var(--lx-faint); }
.lx-blog-card-body{ padding:1.25rem; flex:1; display:flex; flex-direction:column; }
.lx-blog-tags{ display:flex; flex-wrap:wrap; gap:.4rem; margin-bottom:.75rem; }
.lx-blog-tag{ background:var(--lx-blue-050); color:var(--lx-blue-ink); font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; padding:.2rem .6rem; border-radius:var(--lx-pill); }
.lx-blog-card-body h3{ margin:0 0 .6rem; font-size:1.05rem; color:var(--lx-navy); }
.lx-blog-card-body p{ font-size:.9rem; color:var(--lx-muted); margin:0 0 auto; padding-bottom:.75rem; line-height:1.6; }
.lx-blog-card-meta{ display:flex; gap:1rem; font-size:.8rem; color:var(--lx-faint); margin-top:.75rem; }
.lx-blog-closing{ padding-block:clamp(3rem,5vw,4.5rem); background:var(--lx-navy); }
.lx-blog-closing-card{ text-align:center; }
.lx-blog-closing-card h2{ color:#fff; margin:0 0 .75rem; font-size:clamp(1.4rem,3vw,2rem); }
.lx-blog-closing-card p{ color:rgba(255,255,255,.7); max-width:44ch; margin:0 auto 2rem; line-height:1.65; }
.lx-blog-closing-actions{ display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; }
.btn-ghost{ background:transparent; color:#fff; border:1.5px solid rgba(255,255,255,.4); border-radius:var(--lx-pill); padding:.75rem 1.75rem; font-weight:700; font-family:var(--lx-body); font-size:.95rem; cursor:pointer; text-decoration:none; transition:background var(--lx-dur), border-color var(--lx-dur); }
.btn-ghost:hover{ background:rgba(255,255,255,.1); border-color:rgba(255,255,255,.7); }
@media(max-width:860px){ .lx-article-related-grid{ grid-template-columns:1fr 1fr; } }
@media(max-width:520px){ .lx-article-related-grid{ grid-template-columns:1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Article Main",
  "settings": [
    { "type": "header", "content": "Related articles" },
    { "type": "text", "id": "related_eyebrow", "label": "Eyebrow", "default": "More news" },
    { "type": "text", "id": "related_heading", "label": "Heading", "default": "Continue reading" },

    { "type": "header", "content": "Closing CTA" },
    { "type": "checkbox", "id": "show_closing", "label": "Show closing CTA", "default": true },
    { "type": "text", "id": "closing_heading", "label": "Heading", "default": "Looking for support?" },
    { "type": "textarea", "id": "closing_sub", "label": "Sub-text", "default": "Speak with one of our fertility specialists, or browse our range of clinically-proven products." },
    { "type": "text", "id": "closing_btn1_text", "label": "Primary button", "default": "Speak to a specialist" },
    { "type": "text", "id": "closing_btn1_link", "label": "Primary button link", "default": "/pages/contact" },
    { "type": "text", "id": "closing_btn2_text", "label": "Secondary button", "default": "Browse products" },
    { "type": "text", "id": "closing_btn2_link", "label": "Secondary button link", "default": "/pages/shop" }
  ]
}
{% endschema %}
