<section class="products-section">
  <div class="container">

    <div class="section-header">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {% if section.settings.lead != blank %}
          <p class="section-lead">{{ section.settings.lead }}</p>
        {% endif %}
      </div>
      <a href="/collections/all" class="view-all-link">View all <i class="ph ph-arrow-right"></i></a>
    </div>

    <div class="product-grid">

      <a href="/products/proxeed-plus" class="product-card">
        <div class="product-image">
          <span class="product-badge">Bestseller</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div class="product-info">
          <div class="product-cat">Male fertility</div>
          <h3 class="product-title">Proxeed Plus</h3>
          <div class="product-rating">
            <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
            <span>311k+ sold</span>
          </div>
          <div class="product-price">£34.99 <span class="compare">£44.99</span></div>
          <span class="btn btn-primary btn-block">View product</span>
        </div>
      </a>

      <a href="/products/proxeed-men" class="product-card">
        <div class="product-image">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div class="product-info">
          <div class="product-cat">Male fertility</div>
          <h3 class="product-title">Proxeed Men</h3>
          <div class="product-rating">
            <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
            <span>89 reviews</span>
          </div>
          <div class="product-price">£39.99</div>
          <span class="btn btn-primary btn-block">View product</span>
        </div>
      </a>

      <a href="/products/proxeed-women" class="product-card">
        <div class="product-image" style="background:#FFF5F8">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D53F8C" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div class="product-info">
          <div class="product-cat" style="color:#D53F8C">Female fertility</div>
          <h3 class="product-title">Proxeed Women</h3>
          <div class="product-rating">
            <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star-half"></i>
            <span>56 reviews</span>
          </div>
          <div class="product-price">£32.99 <span class="compare">£39.99</span></div>
          <span class="btn btn-primary btn-block">View product</span>
        </div>
      </a>

      <a href="/products/punalpin" class="product-card">
        <div class="product-image" style="background:#FFFCE8">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D69E2E" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div class="product-info">
          <div class="product-cat" style="color:#D69E2E">Wellness</div>
          <h3 class="product-title">Punalpin</h3>
          <div class="product-rating">
            <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
            <span>210 reviews</span>
          </div>
          <div class="product-price">£29.99</div>
          <span class="btn btn-primary btn-block">View product</span>
        </div>
      </a>

    </div>
  </div>
</section>
{% stylesheet %}
.products-section{ padding-block:clamp(3.5rem,7vw,6.5rem); }
.product-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:clamp(1rem,2vw,1.5rem); }
.product-card{ display:flex; flex-direction:column; background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); overflow:hidden; text-decoration:none; transition:transform var(--lx-dur) var(--lx-ease), box-shadow var(--lx-dur) var(--lx-ease), border-color var(--lx-dur); }
.product-card:hover{ transform:translateY(-5px); box-shadow:var(--lx-sh-lg); border-color:transparent; }
.product-image{ position:relative; aspect-ratio:1/1; display:flex; align-items:center; justify-content:center; background:var(--lx-blue-050); padding:2rem; }
.product-image svg{ width:46%; height:46%; transition:transform .35s var(--lx-ease); }
.product-card:hover .product-image svg{ transform:scale(1.06); }
.product-badge{ position:absolute; top:.85rem; left:.85rem; background:var(--lx-navy); color:#fff; font-size:.7rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; padding:.34rem .6rem; border-radius:7px; }
.product-info{ display:flex; flex-direction:column; flex:1; padding:1.25rem 1.35rem 1.45rem; }
.product-cat{ font-size:.78rem; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--lx-blue-ink); margin-bottom:.4rem; }
.product-title{ font-family:var(--lx-display); font-size:1.2rem; color:var(--lx-navy); margin:0 0 .55rem; }
.product-rating{ display:flex; align-items:center; gap:.1rem; color:var(--lx-star); font-size:.9rem; margin-bottom:.7rem; }
.product-rating span{ color:var(--lx-muted); margin-left:.4rem; font-size:.8rem; }
.product-price{ font-family:var(--lx-display); font-size:1.3rem; font-weight:700; color:var(--lx-navy); margin-bottom:1rem; }
.product-price .compare{ font-family:var(--lx-body); font-size:.9rem; font-weight:500; color:var(--lx-faint); text-decoration:line-through; margin-left:.4rem; }
.product-info .btn{ margin-top:auto; }
@media (max-width:1024px){ .product-grid{ grid-template-columns:repeat(2,1fr); } }
@media (max-width:520px){ .product-grid{ grid-template-columns:1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "textarea", "id": "lead", "label": "Description (optional)", "default": "Clinically proven fertility supplements trusted by hundreds of thousands of couples worldwide." }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
