<section class="team-page">
  <div class="container">

    <header class="team-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
    </header>

    {% comment %} Leadership grid {% endcomment %}
    {% assign has_leaders = false %}
    {% for block in section.blocks %}{% if block.type == 'leader' %}{% assign has_leaders = true %}{% endif %}{% endfor %}

    {% if has_leaders %}
      <div class="team-section-label">
        <h2>{{ section.settings.leadership_heading }}</h2>
        <p>{{ section.settings.leadership_sub }}</p>
      </div>

      <div class="leader-grid">
        {% for block in section.blocks %}
          {% if block.type == 'leader' %}
            <article class="leader-card" {{ block.shopify_attributes }}>
              <div class="leader-photo">
                {% if block.settings.photo != blank %}
                  <img src="{{ block.settings.photo | image_url: width: 800 }}" alt="{{ block.settings.name }}">
                {% else %}
                  <div class="leader-photo-placeholder"><i class="ph ph-user-circle"></i><span>Add photo</span></div>
                {% endif %}
              </div>
              <div class="leader-body">
                <span class="leader-role">{{ block.settings.role }}</span>
                <h3 class="leader-name">{{ block.settings.name }}</h3>
                {% if block.settings.qualifications != blank %}
                  <p class="leader-quals">{{ block.settings.qualifications }}</p>
                {% endif %}
                <div class="leader-bio">{{ block.settings.bio }}</div>
                <div class="leader-contact">
                  {% if block.settings.email != blank %}
                    <button type="button" class="leader-contact-row" data-copy="{{ block.settings.email }}" title="Click to copy">
                      <span class="leader-contact-icon"><i class="ph ph-envelope-simple"></i></span>
                      <span class="leader-contact-text">{{ block.settings.email }}</span>
                      <span class="leader-contact-action">
                        <i class="ph ph-copy copy-default"></i>
                        <i class="ph ph-check copy-done"></i>
                      </span>
                    </button>
                  {% endif %}
                  {% if block.settings.phone != blank %}
                    <button type="button" class="leader-contact-row" data-copy="{{ block.settings.phone }}" title="Click to copy">
                      <span class="leader-contact-icon"><i class="ph ph-phone"></i></span>
                      <span class="leader-contact-text">{{ block.settings.phone }}</span>
                      <span class="leader-contact-action">
                        <i class="ph ph-copy copy-default"></i>
                        <i class="ph ph-check copy-done"></i>
                      </span>
                    </button>
                  {% endif %}
                  {% if block.settings.linkedin != blank %}
                    <a href="{{ block.settings.linkedin }}" target="_blank" rel="noopener" class="leader-contact-row leader-contact-row--link">
                      <span class="leader-contact-icon"><i class="ph ph-linkedin-logo"></i></span>
                      <span class="leader-contact-text">View LinkedIn profile</span>
                      <span class="leader-contact-action"><i class="ph ph-arrow-up-right"></i></span>
                    </a>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% comment %} Operations grid {% endcomment %}
    {% assign has_members = false %}
    {% for block in section.blocks %}{% if block.type == 'member' %}{% assign has_members = true %}{% endif %}{% endfor %}

    {% if has_members %}
      <div class="team-section-label team-section-label--mt">
        <h2>{{ section.settings.team_heading }}</h2>
        <p>{{ section.settings.team_sub }}</p>
      </div>

      <div class="member-grid">
        {% for block in section.blocks %}
          {% if block.type == 'member' %}
            <div class="member-card" {{ block.shopify_attributes }}>
              {% if block.settings.photo != blank %}
                <div class="member-photo"><img src="{{ block.settings.photo | image_url: width: 600 }}" alt="{{ block.settings.name }}"></div>
              {% else %}
                <div class="member-avatar">{{ block.settings.initials }}</div>
              {% endif %}
              <h4 class="member-name">{{ block.settings.name }}</h4>
              <span class="member-role">{{ block.settings.role }}</span>
              <div class="member-contact">
                {% if block.settings.email != blank %}
                  <button type="button" class="member-contact-link" data-copy="{{ block.settings.email }}" title="Click to copy">
                    <i class="ph ph-envelope-simple"></i>
                    <span>{{ block.settings.email }}</span>
                    <i class="ph ph-copy copy-default member-copy-icon"></i>
                    <i class="ph ph-check copy-done member-copy-icon"></i>
                  </button>
                {% endif %}
                {% if block.settings.phone != blank %}
                  <button type="button" class="member-contact-link" data-copy="{{ block.settings.phone }}" title="Click to copy">
                    <i class="ph ph-phone"></i>
                    <span>{{ block.settings.phone }}</span>
                    <i class="ph ph-copy copy-default member-copy-icon"></i>
                    <i class="ph ph-check copy-done member-copy-icon"></i>
                  </button>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<script>
(function(){
  document.querySelectorAll('[data-copy]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var text = btn.dataset.copy;
      if (!text) return;
      navigator.clipboard.writeText(text).then(function(){
        btn.classList.add('is-copied');
        setTimeout(function(){ btn.classList.remove('is-copied'); }, 1800);
      }).catch(function(){
        // Fallback for old browsers
        var ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta);
        btn.classList.add('is-copied');
        setTimeout(function(){ btn.classList.remove('is-copied'); }, 1800);
      });
    });
  });
})();
</script>

