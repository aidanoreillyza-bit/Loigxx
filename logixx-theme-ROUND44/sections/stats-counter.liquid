{%- comment -%}
  Stats counter — 3 big numbers that animate on scroll into view.
{%- endcomment -%}

<section class="lx-stats" id="lx-stats-{{ section.id }}">
  <div class="lx-stats-inner">
    {% if section.settings.eyebrow != blank %}
      <p class="lx-stats-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="lx-stats-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="lx-stats-grid">
      {% for i in (1..3) %}
        {%- assign num_key = 'stat' | append: i | append: '_number' -%}
        {%- assign suffix_key = 'stat' | append: i | append: '_suffix' -%}
        {%- assign label_key = 'stat' | append: i | append: '_label' -%}
        {%- assign sub_key = 'stat' | append: i | append: '_sub' -%}
        {%- assign num = section.settings[num_key] -%}
        {%- assign suffix = section.settings[suffix_key] -%}
        {%- assign label = section.settings[label_key] -%}
        {%- assign sub = section.settings[sub_key] -%}

        {% if num != blank %}
          <div class="lx-stat">
            <div class="lx-stat-number">
              <span class="lx-stat-value" data-target="{{ num }}">0</span>{% if suffix != blank %}<span class="lx-stat-suffix">{{ suffix }}</span>{% endif %}
            </div>
            {% if label != blank %}<p class="lx-stat-label">{{ label }}</p>{% endif %}
            {% if sub != blank %}<p class="lx-stat-sub">{{ sub }}</p>{% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
(function(){
  var section = document.getElementById('lx-stats-{{ section.id }}');
  if (!section) return;

  var counters = section.querySelectorAll('.lx-stat-value');
  var animated = false;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function animateNumber(el) {
    var target = parseFloat(el.dataset.target);
    if (isNaN(target)) { el.textContent = el.dataset.target; return; }
    var duration = 1800;
    var startTime = null;
    // Format with commas if integer >= 1000
    function format(n) {
      if (Number.isInteger(target) && target >= 1000) {
        return Math.round(n).toLocaleString();
      }
      if (!Number.isInteger(target)) {
        return n.toFixed(1);
      }
      return Math.round(n).toString();
    }
    function step(ts) {
      if (!startTime) startTime = ts;
      var progress = Math.min((ts - startTime) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = format(target * eased);
      if (progress < 1) requestAnimationFrame(step);
      else el.textContent = format(target);
    }
    requestAnimationFrame(step);
  }

  function run() {
    if (animated) return;
    animated = true;
    if (reduce) {
      counters.forEach(function(c){ c.textContent = c.dataset.target; });
    } else {
      counters.forEach(animateNumber);
    }
  }

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting) { run(); io.disconnect(); } });
    }, { threshold: 0.3 });
    io.observe(section);
  } else {
    run();
  }
})();
</script>

{% stylesheet %}
.lx-stats{ padding-block:clamp(3rem,6vw,5.5rem); background:linear-gradient(135deg,var(--lx-navy) 0%, #093850 55%, var(--lx-blue-700) 145%); color:#fff; position:relative; overflow:hidden; }
.lx-stats::before{ content:""; position:absolute; inset:0; background:radial-gradient(60% 120% at 82% 0%, rgba(0,151,212,.35), transparent 60%); pointer-events:none; }
.lx-stats-inner{ position:relative; max-width:var(--lx-container); margin-inline:auto; padding-inline:clamp(1.1rem,4vw,2rem); text-align:center; }
.lx-stats-eyebrow{ font-weight:600; font-size:.78rem; letter-spacing:.14em; text-transform:uppercase; color:var(--lx-blue-100); margin:0 0 .6rem; }
.lx-stats-heading{ color:#fff; margin:0 0 clamp(2rem,4vw,3rem); }
.lx-stats-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(1.5rem,3vw,2.5rem); }
.lx-stat{ position:relative; }
.lx-stat + .lx-stat::before{ content:""; position:absolute; left:calc(-1 * clamp(.75rem,1.5vw,1.25rem)); top:10%; bottom:10%; width:1px; background:rgba(255,255,255,.14); }
.lx-stat-number{ font-family:var(--lx-display); font-weight:700; font-size:clamp(2.6rem,5vw,4rem); line-height:1; letter-spacing:-.02em; display:inline-flex; align-items:baseline; }
.lx-stat-suffix{ color:var(--lx-blue-100); margin-left:.05em; }
.lx-stat-label{ font-family:var(--lx-display); font-size:1.05rem; margin:.7rem 0 .2rem; color:#fff; }
.lx-stat-sub{ font-size:.85rem; color:rgba(255,255,255,.6); margin:0; }
@media (max-width:680px){ .lx-stats-grid{ grid-template-columns:1fr; gap:2rem; } .lx-stat + .lx-stat::before{ display:none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Stats counter",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)", "default": "The big picture" },
    { "type": "text", "id": "heading", "label": "Heading (optional)", "default": "Fertility by the numbers" },
    { "type": "header", "content": "Stat 1" },
    { "type": "text", "id": "stat1_number", "label": "Number", "info": "Enter just the number (e.g. 77000, 50, 4.9). Suffix below adds k / % / + etc.", "default": "311733" },
    { "type": "text", "id": "stat1_suffix", "label": "Suffix", "default": "+" },
    { "type": "text", "id": "stat1_label", "label": "Label", "default": "Couples helped" },
    { "type": "text", "id": "stat1_sub", "label": "Subtext", "default": "Across 40+ countries" },
    { "type": "header", "content": "Stat 2" },
    { "type": "text", "id": "stat2_number", "label": "Number", "default": "50" },
    { "type": "text", "id": "stat2_suffix", "label": "Suffix", "default": "%" },
    { "type": "text", "id": "stat2_label", "label": "Label", "default": "Sperm count drop" },
    { "type": "text", "id": "stat2_sub", "label": "Subtext", "default": "In the last 50 years" },
    { "type": "header", "content": "Stat 3" },
    { "type": "text", "id": "stat3_number", "label": "Number", "default": "4.9" },
    { "type": "text", "id": "stat3_suffix", "label": "Suffix", "default": "/5" },
    { "type": "text", "id": "stat3_label", "label": "Label", "default": "Customer rating" },
    { "type": "text", "id": "stat3_sub", "label": "Subtext", "default": "From 2,400+ reviews" }
  ],
  "presets": [{ "name": "Stats counter" }]
}
{% endschema %}
