<section class="lx-blog">

  <!-- HERO -->
  <div class="lx-blog-hero">
    <div class="container">
      <div class="lx-blog-hero-inner">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h1>{{ blog.title | default: section.settings.heading }}</h1>
        <p class="lx-blog-lead">{{ section.settings.subheading }}</p>
      </div>
    </div>
  </div>

  <!-- ARTICLES GRID -->
  <div class="lx-blog-list">
    <div class="container">

      {% if blog.articles.size > 0 %}

        <!-- Featured first article (large) -->
        {% assign featured = blog.articles.first %}
        <a href="{{ featured.url }}" class="lx-blog-featured">
          <div class="lx-blog-featured-media">
            {% if featured.image %}
              <img src="{{ featured.image | image_url: width: 1400 }}" alt="{{ featured.title }}">
            {% else %}
              <div class="lx-blog-placeholder lx-blog-placeholder--lg">
                <i class="ph ph-newspaper"></i>
              </div>
            {% endif %}
            <span class="lx-blog-featured-badge">Latest</span>
          </div>
          <div class="lx-blog-featured-body">
            {% if featured.tags.size > 0 %}
              <div class="lx-blog-tags">
                {% for tag in featured.tags limit: 2 %}
                  <span class="lx-blog-tag">{{ tag }}</span>
                {% endfor %}
              </div>
            {% endif %}
            <h2>{{ featured.title }}</h2>
            <p>{{ featured.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
            <div class="lx-blog-meta">
              <span class="lx-blog-date"><i class="ph ph-calendar"></i> {{ featured.published_at | date: '%B %-d, %Y' }}</span>
              {% if featured.author != blank %}
                <span class="lx-blog-author"><i class="ph ph-user"></i> {{ featured.author }}</span>
              {% endif %}
              <span class="lx-blog-readmore">Read article <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
            </div>
          </div>
        </a>

        <!-- Grid of remaining articles -->
        {% if blog.articles.size > 1 %}
          <div class="lx-blog-grid">
            {% for article in blog.articles offset: 1 %}
              <a href="{{ article.url }}" class="lx-blog-card">
                <div class="lx-blog-card-media">
                  {% if article.image %}
                    <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title }}">
                  {% else %}
                    <div class="lx-blog-placeholder">
                      <i class="ph ph-newspaper"></i>
                    </div>
                  {% endif %}
                </div>
                <div class="lx-blog-card-body">
                  {% if article.tags.size > 0 %}
                    <div class="lx-blog-tags">
                      {% for tag in article.tags limit: 1 %}
                        <span class="lx-blog-tag">{{ tag }}</span>
                      {% endfor %}
                    </div>
                  {% endif %}
                  <h3>{{ article.title }}</h3>
                  <p>{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
                  <div class="lx-blog-card-meta">
                    <span><i class="ph ph-calendar"></i> {{ article.published_at | date: '%b %-d, %Y' }}</span>
                  </div>
                </div>
              </a>
            {% endfor %}
          </div>
        {% endif %}

      {% else %}
        <!-- Empty state -->
        <div class="lx-blog-empty">
          <div class="lx-blog-empty-icon"><i class="ph ph-newspaper-clipping"></i></div>
          <h2>No articles yet</h2>
          <p>Check back soon for the latest news, partnerships, and company updates from LogixX Fertility.</p>
        </div>
      {% endif %}

    </div>
  </div>

  <!-- CLOSING CTA -->
  {% if section.settings.show_closing %}
    <div class="lx-blog-closing">
      <div class="container">
        <div class="lx-blog-closing-card">
          {% if section.settings.closing_heading != blank %}<h2>{{ section.settings.closing_heading }}</h2>{% endif %}
          <p>{{ section.settings.closing_sub }}</p>
          <div class="lx-blog-closing-actions">
            <a href="{{ section.settings.closing_btn1_link }}" class="btn btn-primary">{{ section.settings.closing_btn1_text }}</a>
            <a href="{{ section.settings.closing_btn2_link }}" class="btn btn-ghost">{{ section.settings.closing_btn2_text }}</a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</section>

{% stylesheet %}
.lx-blog{ font-family:var(--lx-body); }
.lx-blog-hero{ padding-block:clamp(3.5rem,7vw,6rem); background:var(--lx-bg-soft); border-bottom:1px solid var(--lx-line); text-align:center; }
.lx-blog-hero-inner{ max-width:640px; margin-inline:auto; }
.lx-blog-hero-inner h1{ margin:.75rem 0 0; font-size:clamp(2rem,5vw,3.2rem); }
.lx-blog-lead{ color:var(--lx-muted); font-size:1.1rem; margin-top:.75rem; line-height:1.65; }
.lx-blog-list{ padding-block:clamp(3rem,6vw,5rem); }
.lx-blog-featured{ display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,5vw,3.5rem); align-items:center; margin-bottom:3rem; padding-bottom:3rem; border-bottom:1px solid var(--lx-line); text-decoration:none; color:inherit; }
.lx-blog-featured-media{ border-radius:var(--lx-r-lg); overflow:hidden; aspect-ratio:16/10; position:relative; background:var(--lx-bg-soft); box-shadow:var(--lx-sh-lg); }
.lx-blog-featured-media img{ width:100%; height:100%; object-fit:cover; transition:transform .5s var(--lx-ease); }
.lx-blog-featured:hover .lx-blog-featured-media img{ transform:scale(1.04); }
.lx-blog-featured-badge{ position:absolute; top:1rem; left:1rem; background:var(--lx-blue); color:#fff; font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; padding:.3rem .8rem; border-radius:var(--lx-pill); }
.lx-blog-placeholder--lg{ min-height:300px; display:flex; align-items:center; justify-content:center; font-size:3rem; color:var(--lx-faint); }
.lx-blog-featured-body h2{ font-size:clamp(1.4rem,3vw,2rem); color:var(--lx-navy); margin:.75rem 0 .9rem; }
.lx-blog-featured-body p{ color:var(--lx-muted); line-height:1.7; margin-bottom:1.25rem; }
.lx-blog-meta{ display:flex; flex-wrap:wrap; align-items:center; gap:.6rem 1.25rem; font-size:.85rem; color:var(--lx-faint); }
.lx-blog-meta i{ margin-right:.3rem; }
.lx-blog-readmore{ color:var(--lx-blue-ink); font-weight:600; display:inline-flex; align-items:center; gap:.4rem; }
.lx-blog-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }
.lx-blog-card{ display:flex; flex-direction:column; background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); overflow:hidden; text-decoration:none; color:inherit; transition:transform var(--lx-dur) var(--lx-ease), box-shadow var(--lx-dur), border-color var(--lx-dur); }
.lx-blog-card:hover{ transform:translateY(-4px); box-shadow:var(--lx-sh-lg); border-color:transparent; }
.lx-blog-card-media{ aspect-ratio:16/9; overflow:hidden; background:var(--lx-bg-soft); }
.lx-blog-card-media img{ width:100%; height:100%; object-fit:cover; transition:transform .4s var(--lx-ease); }
.lx-blog-card:hover .lx-blog-card-media img{ transform:scale(1.05); }
.lx-blog-placeholder{ width:100%; height:100%; min-height:160px; display:flex; align-items:center; justify-content:center; font-size:2rem; color:var(--lx-faint); }
.lx-blog-card-body{ padding:1.25rem; flex:1; display:flex; flex-direction:column; }
.lx-blog-tags{ display:flex; flex-wrap:wrap; gap:.4rem; margin-bottom:.75rem; }
.lx-blog-tag{ background:var(--lx-blue-050); color:var(--lx-blue-ink); font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; padding:.2rem .6rem; border-radius:var(--lx-pill); }
.lx-blog-card-body h3{ margin:0 0 .5rem; font-size:1rem; color:var(--lx-navy); line-height:1.45; }
.lx-blog-card-body p{ font-size:.88rem; color:var(--lx-muted); flex:1; margin-bottom:0; line-height:1.6; }
.lx-blog-card-meta{ display:flex; justify-content:space-between; align-items:center; gap:.75rem; font-size:.8rem; color:var(--lx-faint); margin-top:1rem; padding-top:.75rem; border-top:1px solid var(--lx-line); }
.lx-blog-card-meta i{ margin-right:.25rem; }
.lx-blog-empty{ text-align:center; padding:4rem 1rem; }
.lx-blog-empty-icon{ font-size:3rem; color:var(--lx-faint); margin-bottom:1rem; }
.lx-blog-empty h2{ color:var(--lx-navy); margin-bottom:.5rem; }
.lx-blog-empty p{ color:var(--lx-muted); max-width:40ch; margin-inline:auto; }
.lx-blog-closing{ padding-block:clamp(3rem,5vw,4.5rem); background:var(--lx-navy); }
.lx-blog-closing-card{ text-align:center; }
.lx-blog-closing-card h2{ color:#fff; margin:0 0 .75rem; font-size:clamp(1.4rem,3vw,2rem); }
.lx-blog-closing-card p{ color:rgba(255,255,255,.7); max-width:44ch; margin:0 auto 2rem; line-height:1.65; }
.lx-blog-closing-actions{ display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; }
@media(max-width:860px){ .lx-blog-featured{ grid-template-columns:1fr; } .lx-blog-grid{ grid-template-columns:1fr 1fr; } }
@media(max-width:520px){ .lx-blog-grid{ grid-template-columns:1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Main",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Company news" },
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "Latest from LogixX" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Announcements, partnerships, awards, and the latest from our team." },

    { "type": "header", "content": "Closing CTA" },
    { "type": "checkbox", "id": "show_closing", "label": "Show closing CTA", "default": true },
    { "type": "text", "id": "closing_heading", "label": "Heading", "default": "Stay in the loop" },
    { "type": "textarea", "id": "closing_sub", "label": "Sub-text", "default": "Get the latest LogixX news and fertility science delivered to your inbox." },
    { "type": "text", "id": "closing_btn1_text", "label": "Primary button", "default": "Speak to a specialist" },
    { "type": "text", "id": "closing_btn1_link", "label": "Primary button link", "default": "/pages/contact" },
    { "type": "text", "id": "closing_btn2_text", "label": "Secondary button", "default": "Browse products" },
    { "type": "text", "id": "closing_btn2_link", "label": "Secondary button link", "default": "/pages/shop" }
  ]
}
{% endschema %}
