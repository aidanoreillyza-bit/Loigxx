<section class="search-page">
  <div class="container">

    <!-- Header -->
    <header class="search-head">
      <h1>{% if search.terms != blank %}Results for "{{ search.terms }}"{% else %}Search{% endif %}</h1>
      <form action="/search" method="get" role="search" class="search-form">
        <i class="ph ph-magnifying-glass"></i>
        <input type="hidden" name="type" value="product,page,article">
        <input type="search" name="q" value="{{ search.terms }}" placeholder="Search products, guides, pages…" autocomplete="off">
        <button type="submit">Search</button>
      </form>
      {% if search.performed and search.results_count > 0 %}
        <p class="search-count">{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}</p>
      {% endif %}
    </header>

    <!-- Results -->
    {% if search.performed %}
      {% if search.results_count == 0 %}
        <div class="search-empty">
          <i class="ph ph-magnifying-glass"></i>
          <h3>No results for "{{ search.terms }}"</h3>
          <p>Try different keywords, or browse our products below.</p>
          <a href="/pages/shop" class="btn btn-primary">Browse all products</a>
        </div>
      {% else %}
        {% paginate search.results by 12 %}
          <div class="product-grid product-grid--3col">
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                <a href="{{ item.url }}" class="product-card">
                  <div class="product-image">
                    {% if item.featured_image %}
                      <img src="{{ item.featured_image | image_url: width: 600 }}" alt="{{ item.title }}">
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    {% endif %}
                    {% if item.compare_at_price > item.price %}
                      <span class="product-badge">Sale</span>
                    {% endif %}
                  </div>
                  <div class="product-info">
                    {% if item.vendor %}<div class="product-cat">{{ item.vendor }}</div>{% endif %}
                    <h3 class="product-title">{{ item.title }}</h3>
                    <div class="product-price">
                      {{ item.price | money }}
                      {% if item.compare_at_price > item.price %}
                        <span class="compare">{{ item.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                  </div>
                </a>
              {% else %}
                <a href="{{ item.url }}" class="search-page-card">
                  <span class="search-page-type">{{ item.object_type | capitalize }}</span>
                  <h3>{{ item.title }}</h3>
                  {% if item.content %}
                    <p>{{ item.content | strip_html | truncate: 140 }}</p>
                  {% endif %}
                  <span class="search-page-link">Read more →</span>
                </a>
              {% endif %}
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <nav class="shop-pagination">
              {% if paginate.previous %}<a href="{{ paginate.previous.url }}" class="shop-page-btn">← Previous</a>{% endif %}
              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}" class="shop-page-btn">{{ part.title }}</a>
                {% else %}
                  <span class="shop-page-btn is-current">{{ part.title }}</span>
                {% endif %}
              {% endfor %}
              {% if paginate.next %}<a href="{{ paginate.next.url }}" class="shop-page-btn">Next →</a>{% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      {% endif %}
    {% else %}
      <div class="search-empty">
        <i class="ph ph-magnifying-glass"></i>
        <h3>Start typing to search</h3>
        <p>Find products by name, brand, or category.</p>
      </div>
    {% endif %}

  </div>
</section>

{% stylesheet %}
/* ================================================================
   MAIN-SEARCH — scoped to .search-page and children
   Design tokens are globally defined. Do not redefine :root.
   ================================================================ */

/* ---- Section wrapper ---- */
.search-page {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
  background: var(--lx-bg);
}

/* ================================================================
   SEARCH HEADER
   ================================================================ */
.search-head {
  max-width: 700px;
  margin-inline: auto;
  text-align: center;
  margin-bottom: clamp(2.5rem, 5vw, 4rem);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
}
.search-head h1 {
  font-family: var(--lx-display);
  color: var(--lx-navy);
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  line-height: 1.12;
  margin: 0;
}

/* ---- Search form ---- */
.search-form {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 560px;
  background: #fff;
  border: 1.5px solid var(--lx-line-strong);
  border-radius: var(--lx-pill);
  overflow: hidden;
  box-shadow: var(--lx-sh-sm);
  transition: border-color var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease);
}
.search-form:focus-within {
  border-color: var(--lx-blue);
  box-shadow: 0 0 0 3px var(--lx-blue-100);
}
.search-form i {
  position: absolute;
  left: 1.1rem;
  font-size: 1.1rem;
  color: var(--lx-muted);
  pointer-events: none;
}
.search-form input[type="search"] {
  flex: 1;
  padding: 0.85rem 0.75rem 0.85rem 2.9rem;
  border: none;
  outline: none;
  font-size: 0.95rem;
  color: var(--lx-ink);
  background: transparent;
  min-width: 0;
}
.search-form input[type="search"]::placeholder {
  color: var(--lx-faint);
}
.search-form button[type="submit"] {
  flex-shrink: 0;
  padding: 0.75rem 1.35rem;
  background: var(--lx-blue);
  color: #fff;
  border: none;
  font-size: 0.9rem;
  font-weight: 600;
  font-family: var(--lx-display);
  cursor: pointer;
  letter-spacing: 0.03em;
  transition: background var(--lx-dur) var(--lx-ease);
}
.search-form button[type="submit"]:hover {
  background: var(--lx-blue-600);
}

/* Result count */
.search-count {
  font-size: 0.88rem;
  color: var(--lx-muted);
  margin: 0;
}

/* ================================================================
   EMPTY / PRE-SEARCH STATE
   ================================================================ */
.search-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: clamp(3rem, 6vw, 5rem) 1rem;
  text-align: center;
  gap: 1rem;
  background: var(--lx-bg-soft);
  border: 1px dashed var(--lx-line-strong);
  border-radius: var(--lx-r-lg);
  max-width: 480px;
  margin-inline: auto;
}
.search-empty i {
  font-size: 3rem;
  color: var(--lx-faint);
}
.search-empty h3 {
  font-family: var(--lx-display);
  color: var(--lx-navy);
  font-size: 1.4rem;
  margin: 0;
}
.search-empty p {
  color: var(--lx-muted);
  font-size: 0.95rem;
  margin: 0;
}

/* ================================================================
   NON-PRODUCT (page/article) RESULT CARD
   ================================================================ */
.search-page-card {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 1.35rem 1.5rem;
  background: #fff;
  border: 1px solid var(--lx-line);
  border-radius: var(--lx-r-lg);
  text-decoration: none;
  color: inherit;
  transition: transform var(--lx-dur) var(--lx-ease),
              box-shadow var(--lx-dur) var(--lx-ease),
              border-color var(--lx-dur) var(--lx-ease);
}
.search-page-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--lx-sh-lg);
  border-color: transparent;
}
.search-page-type {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--lx-blue-ink);
  background: var(--lx-blue-050);
  border: 1px solid var(--lx-blue-100);
  border-radius: var(--lx-pill);
  padding: 0.18rem 0.6rem;
  width: fit-content;
}
.search-page-card h3 {
  font-family: var(--lx-display);
  color: var(--lx-navy);
  font-size: 1.05rem;
  margin: 0;
  line-height: 1.3;
}
.search-page-card p {
  font-size: 0.88rem;
  color: var(--lx-muted);
  line-height: 1.6;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.search-page-link {
  font-size: 0.83rem;
  font-weight: 600;
  color: var(--lx-blue-ink);
  margin-top: auto;
  transition: color var(--lx-dur) var(--lx-ease);
}
.search-page-card:hover .search-page-link {
  color: var(--lx-blue);
}

/* ================================================================
   REDUCED MOTION
   ================================================================ */
@media (prefers-reduced-motion: reduce) {
  .search-form,
  .search-page-card {
    transition: none;
  }
  .search-page-card:hover {
    transform: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
