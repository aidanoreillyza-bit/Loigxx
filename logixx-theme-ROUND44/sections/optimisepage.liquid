<section class="lx-opt" id="lx-opt-{{ section.id }}">

  <!-- Sperm swimmers background -->
  <div class="lx-opt-swimmers" aria-hidden="true">
    {% for i in (1..35) %}
      <svg class="lx-swimmer lx-swimmer--{{ forloop.index | modulo: 4 | plus: 1 }}" viewBox="0 0 60 12">
        <ellipse cx="6" cy="6" rx="5" ry="4" fill="#00A2ED"/>
        <line x1="11" y1="6" x2="58" y2="6" stroke="#00A2ED" stroke-width="0.8" opacity="0.6"/>
      </svg>
    {% endfor %}
  </div>

  <!-- HERO -->
  <div class="lx-opt-hero">
    <div class="container">
      <div class="lx-opt-hero-inner">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h1>{{ section.settings.heading }}</h1>
        <div class="lx-opt-hero-lead rte">{{ section.settings.lead }}</div>

        {% if section.settings.show_keystat %}
          <div class="lx-opt-keystat">
            <div class="lx-opt-keystat-num">{{ section.settings.keystat_num }}</div>
            <div class="lx-opt-keystat-text">
              <strong>{{ section.settings.keystat_title }}</strong>
              <span>{{ section.settings.keystat_sub }}</span>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- WHAT AFFECTS SPERM (intro content + lifestyle factors) -->
  {% if section.settings.show_intro %}
    <div class="lx-opt-intro">
      <div class="container">
        <div class="lx-opt-intro-grid">
          <div class="lx-opt-intro-text">
            <span class="lx-opt-mini-eyebrow">{{ section.settings.intro_eyebrow }}</span>
            <h2>{{ section.settings.intro_heading }}</h2>
            <div class="rte">{{ section.settings.intro_body }}</div>
          </div>
          <div class="lx-opt-factors">
            <div class="lx-opt-factors-head">
              <i class="ph ph-warning-circle"></i>
              <strong>{{ section.settings.factors_title }}</strong>
            </div>
            <ul class="lx-opt-factors-list">
              {% for block in section.blocks %}
                {% if block.type == 'factor' %}
                  <li {{ block.shopify_attributes }}>
                    <i class="{{ block.settings.icon | default: 'ph ph-x' }}"></i>
                    <span>{{ block.settings.label }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- 74-DAY CYCLE EDUCATIONAL BAND -->
  {% if section.settings.show_cycle %}
    <div class="lx-opt-cycle">
      <div class="container">
        <div class="lx-opt-cycle-head">
          <span class="lx-opt-mini-eyebrow">{{ section.settings.cycle_eyebrow }}</span>
          <h2>{{ section.settings.cycle_heading }}</h2>
          <p>{{ section.settings.cycle_sub }}</p>
        </div>
        <div class="lx-opt-cycle-track">
          <div class="lx-opt-cycle-line"></div>
          <div class="lx-opt-cycle-line-fill" id="lx-opt-fill-{{ section.id }}"></div>
          <div class="lx-opt-cycle-stops">
            <div class="lx-opt-cycle-stop">
              <div class="lx-opt-cycle-dot"><span>1</span></div>
              <strong>Day 1</strong>
              <span>Spermatogenesis begins</span>
            </div>
            <div class="lx-opt-cycle-stop">
              <div class="lx-opt-cycle-dot"><span>30</span></div>
              <strong>Day 30</strong>
              <span>DNA &amp; structure forms</span>
            </div>
            <div class="lx-opt-cycle-stop">
              <div class="lx-opt-cycle-dot"><span>74</span></div>
              <strong>Day 74</strong>
              <span>Sperm matures</span>
            </div>
            <div class="lx-opt-cycle-stop is-final">
              <div class="lx-opt-cycle-dot"><span>94</span></div>
              <strong>Day 94</strong>
              <span>Capable of fertilisation</span>
            </div>
          </div>
        </div>
        <div class="lx-opt-cycle-callout">
          <i class="ph ph-info"></i>
          <p>{{ section.settings.cycle_note }}</p>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- 5 SEMEN PARAMETERS -->
  {% if section.settings.show_parameters %}
    <div class="lx-opt-parameters">
      <div class="container">
        <div class="lx-opt-section-head">
          <span class="lx-opt-mini-eyebrow">{{ section.settings.params_eyebrow }}</span>
          <h2>{{ section.settings.params_heading }}</h2>
          <p>{{ section.settings.params_sub }}</p>
        </div>
        <div class="lx-opt-params-grid">
          {% for block in section.blocks %}
            {% if block.type == 'parameter' %}
              <div class="lx-opt-param" {{ block.shopify_attributes }}>
                <div class="lx-opt-param-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
                <div class="lx-opt-param-icon"><i class="{{ block.settings.icon | default: 'ph ph-circle' }}"></i></div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.description }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- DNA DAMAGE / OXIDATIVE STRESS -->
  {% if section.settings.show_dna %}
    <div class="lx-opt-dna">
      <div class="container">
        <div class="lx-opt-dna-grid">
          <div class="lx-opt-dna-visual">
            <div class="lx-opt-dna-stat-card">
              <div class="lx-opt-dna-stat-num">30%</div>
              <strong>decline in sperm count</strong>
              <span>1989 → 2005</span>
            </div>
            <div class="lx-opt-dna-stat-card lx-opt-dna-stat-card--alt">
              <div class="lx-opt-dna-stat-num">1 in 5</div>
              <strong>young men</strong>
              <span>have low sperm count</span>
            </div>
          </div>
          <div class="lx-opt-dna-text">
            <span class="lx-opt-mini-eyebrow">{{ section.settings.dna_eyebrow }}</span>
            <h2>{{ section.settings.dna_heading }}</h2>
            <div class="rte">{{ section.settings.dna_body }}</div>
            <div class="lx-opt-dna-tip">
              <i class="ph ph-lightbulb"></i>
              <p><strong>MiOXSYS sORP test</strong> is a newer diagnostic that measures sperm oxidative stress — now considered a leading cause of male infertility.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- PROXEED PLUS HIGHLIGHT -->
  {% if section.settings.show_product %}
    <div class="lx-opt-product">
      <div class="container">
        <div class="lx-opt-product-card">
          <div class="lx-opt-product-bg" aria-hidden="true"></div>
          <div class="lx-opt-product-inner">
            <div class="lx-opt-product-content">
              <span class="lx-opt-product-pill">Recommended supplement</span>
              <h2>{{ section.settings.product_heading }}</h2>
              <p>{{ section.settings.product_lead }}</p>

              <div class="lx-opt-product-pillars">
                <div class="lx-opt-product-pillar">
                  <div class="lx-opt-product-pillar-icon"><i class="ph ph-lightning"></i></div>
                  <strong>Enhances energy</strong>
                  <span>Fuel for sperm to develop &amp; swim</span>
                </div>
                <div class="lx-opt-product-pillar">
                  <div class="lx-opt-product-pillar-icon"><i class="ph ph-trend-up"></i></div>
                  <strong>Improves function</strong>
                  <span>Count, motility, speed, morphology</span>
                </div>
                <div class="lx-opt-product-pillar">
                  <div class="lx-opt-product-pillar-icon"><i class="ph ph-shield-check"></i></div>
                  <strong>Protects from stress</strong>
                  <span>Reduces oxidative damage to DNA</span>
                </div>
              </div>

              <div class="lx-opt-product-actions">
                <a href="{{ section.settings.product_cta_link }}" class="btn btn-primary">{{ section.settings.product_cta_text }} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
                <a href="{{ section.settings.product_cta2_link }}" class="btn btn-ghost">{{ section.settings.product_cta2_text }}</a>
              </div>
            </div>
            {% if section.settings.product_image != blank %}
              <div class="lx-opt-product-visual">
                <img src="{{ section.settings.product_image | image_url: width: 800 }}" alt="Proxeed Plus">
              </div>
            {% else %}
              <div class="lx-opt-product-visual">
                <div class="lx-opt-product-placeholder">
                  <i class="ph ph-package"></i>
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- BEYOND SUPPLEMENTS (additional treatments) -->
  {% if section.settings.show_beyond %}
    <div class="lx-opt-beyond">
      <div class="container">
        <div class="lx-opt-section-head">
          <span class="lx-opt-mini-eyebrow">{{ section.settings.beyond_eyebrow }}</span>
          <h2>{{ section.settings.beyond_heading }}</h2>
          <p>{{ section.settings.beyond_sub }}</p>
        </div>
        <div class="lx-opt-beyond-grid">
          {% for block in section.blocks %}
            {% if block.type == 'treatment' %}
              <div class="lx-opt-treatment" {{ block.shopify_attributes }}>
                <div class="lx-opt-treatment-icon"><i class="{{ block.settings.icon }}"></i></div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.description }}</p>
                {% if block.settings.link_text != blank %}
                  <a href="{{ block.settings.link_url }}" class="lx-opt-treatment-link">{{ block.settings.link_text }} →</a>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- CLOSING CTA -->
  {% if section.settings.show_closing %}
    <div class="lx-opt-closing">
      <div class="container">
        <div class="lx-opt-closing-card">
          {% if section.settings.closing_heading != blank %}<h2>{{ section.settings.closing_heading }}</h2>{% endif %}
          <p>{{ section.settings.closing_sub }}</p>
          <div class="lx-opt-closing-actions">
            <a href="{{ section.settings.closing_btn1_link }}" class="btn btn-primary">{{ section.settings.closing_btn1_text }}</a>
            <a href="{{ section.settings.closing_btn2_link }}" class="btn btn-ghost">{{ section.settings.closing_btn2_text }}</a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</section>

<script>
(function(){
  var section = document.getElementById('lx-opt-{{ section.id }}');
  if (!section) return;
  var fill = document.getElementById('lx-opt-fill-{{ section.id }}');
  var track = section.querySelector('.lx-opt-cycle-track');
  if (fill && track && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting) fill.style.width = '100%'; });
    }, { threshold: 0.3 });
    io.observe(track);
  }
})();
</script>

{% stylesheet %}
.lx-opt{ font-family:var(--lx-body); position:relative; overflow:hidden; }
.lx-opt-swimmers{ position:absolute; inset:0; pointer-events:none; z-index:0; }
.lx-opt-hero{ position:relative; z-index:1; padding-block:clamp(4rem,8vw,7rem); background:var(--lx-bg-soft); border-bottom:1px solid var(--lx-line); text-align:center; }
.lx-opt-hero-inner{ max-width:660px; margin-inline:auto; }
.lx-opt-hero-inner h1{ margin:.75rem 0 1.1rem; font-size:clamp(2rem,5vw,3.2rem); }
.lx-opt-hero-lead.rte{ color:var(--lx-muted); font-size:1.05rem; line-height:1.75; }
.lx-opt-keystat{ display:inline-flex; align-items:center; gap:1.1rem; margin-top:2rem; background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:1.1rem 1.75rem; box-shadow:var(--lx-sh); }
.lx-opt-keystat-num{ font-family:var(--lx-display); font-size:2.2rem; color:var(--lx-blue); line-height:1; }
.lx-opt-keystat-text strong{ display:block; color:var(--lx-navy); font-size:.95rem; }
.lx-opt-keystat-text span{ font-size:.82rem; color:var(--lx-muted); }
.lx-opt-mini-eyebrow{ display:block; text-transform:uppercase; letter-spacing:.14em; font-size:.78rem; font-weight:700; color:var(--lx-blue-ink); margin-bottom:.6rem; }
.lx-opt-intro{ padding-block:clamp(3rem,6vw,5rem); background:#fff; }
.lx-opt-intro-grid{ display:grid; grid-template-columns:1fr 340px; gap:clamp(2.5rem,5vw,4rem); align-items:start; }
.lx-opt-intro-text h2{ font-size:clamp(1.5rem,3.5vw,2.1rem); color:var(--lx-navy); margin:.4rem 0 1rem; }
.lx-opt-intro-text .rte{ color:var(--lx-muted); line-height:1.75; }
.lx-opt-factors{ background:var(--lx-bg-soft); border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:1.5rem; }
.lx-opt-factors-head{ display:flex; align-items:center; gap:.6rem; font-weight:700; color:var(--lx-navy); margin-bottom:1.1rem; font-size:.95rem; }
.lx-opt-factors-head i{ font-size:1.2rem; color:var(--lx-orange); }
.lx-opt-factors-list{ list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:.55rem; }
.lx-opt-factors-list li{ display:flex; align-items:center; gap:.65rem; font-size:.88rem; color:var(--lx-ink); }
.lx-opt-factors-list li i{ font-size:1rem; color:var(--lx-orange); flex:none; }
.lx-opt-cycle{ padding-block:clamp(3rem,6vw,5rem); background:var(--lx-bg-soft); border-top:1px solid var(--lx-line); }
.lx-opt-cycle-head{ text-align:center; max-width:580px; margin:0 auto 3rem; }
.lx-opt-cycle-head h2{ margin:.4rem 0 .6rem; font-size:clamp(1.4rem,3vw,2rem); }
.lx-opt-cycle-head p{ color:var(--lx-muted); }
.lx-opt-cycle-track{ position:relative; padding:3rem 0 1rem; max-width:700px; margin:0 auto; }
.lx-opt-cycle-line{ position:absolute; top:3rem; left:5%; right:5%; height:3px; background:var(--lx-line-strong); border-radius:2px; }
.lx-opt-cycle-line-fill{ position:absolute; top:3rem; left:5%; width:0; height:3px; background:var(--lx-blue); border-radius:2px; transition:width 1.2s var(--lx-ease); }
.lx-opt-cycle-stops{ display:flex; justify-content:space-between; position:relative; z-index:1; }
.lx-opt-cycle-stop{ display:flex; flex-direction:column; align-items:center; gap:.45rem; }
.lx-opt-cycle-dot{ width:44px; height:44px; background:#fff; border:3px solid var(--lx-line-strong); border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:var(--lx-display); font-size:.85rem; font-weight:700; color:var(--lx-muted); transition:border-color .4s, background .4s, color .4s; }
.lx-opt-cycle-stop.is-final .lx-opt-cycle-dot{ background:var(--lx-blue); border-color:var(--lx-blue); color:#fff; }
.lx-opt-cycle-stop strong{ font-size:.85rem; color:var(--lx-navy); }
.lx-opt-cycle-stop span{ font-size:.75rem; color:var(--lx-muted); text-align:center; max-width:80px; }
.lx-opt-cycle-callout{ display:flex; align-items:flex-start; gap:.75rem; background:var(--lx-blue-050); border:1px solid var(--lx-blue-100); border-radius:var(--lx-r); padding:1.1rem 1.25rem; margin-top:2rem; max-width:700px; margin-inline:auto; font-size:.88rem; color:var(--lx-ink); line-height:1.6; }
.lx-opt-cycle-callout i{ font-size:1.2rem; color:var(--lx-blue); flex:none; margin-top:.1rem; }
.lx-opt-section-head{ text-align:center; max-width:560px; margin:0 auto 2.5rem; }
.lx-opt-section-head h2{ margin:.4rem 0 .6rem; font-size:clamp(1.4rem,3vw,2rem); }
.lx-opt-section-head p{ color:var(--lx-muted); }
.lx-opt-parameters{ padding-block:clamp(3rem,6vw,5rem); background:#fff; }
.lx-opt-params-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:1.25rem; }
.lx-opt-param{ background:var(--lx-bg-soft); border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:1.5rem; text-align:center; transition:transform var(--lx-dur), box-shadow var(--lx-dur), border-color var(--lx-dur); }
.lx-opt-param:hover{ transform:translateY(-4px); box-shadow:var(--lx-sh-lg); border-color:transparent; }
.lx-opt-param-num{ font-family:var(--lx-display); font-size:1.8rem; color:var(--lx-blue-100); line-height:1; margin-bottom:.5rem; }
.lx-opt-param-icon{ font-size:1.8rem; color:var(--lx-blue); margin-bottom:.75rem; }
.lx-opt-param h3{ font-size:.95rem; color:var(--lx-navy); margin:0 0 .5rem; }
.lx-opt-param p{ font-size:.82rem; color:var(--lx-muted); margin:0; line-height:1.55; }
.lx-opt-dna{ padding-block:clamp(3rem,6vw,5rem); background:var(--lx-bg-soft); border-top:1px solid var(--lx-line); }
.lx-opt-dna-grid{ display:grid; grid-template-columns:300px 1fr; gap:clamp(2.5rem,5vw,4rem); align-items:center; }
.lx-opt-dna-visual{ display:flex; flex-direction:column; gap:1rem; }
.lx-opt-dna-stat-card{ background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:1.5rem; text-align:center; box-shadow:var(--lx-sh); }
.lx-opt-dna-stat-card--alt{ background:var(--lx-navy); border-color:var(--lx-navy); }
.lx-opt-dna-stat-card--alt .lx-opt-dna-stat-num,.lx-opt-dna-stat-card--alt strong,.lx-opt-dna-stat-card--alt span{ color:#fff !important; }
.lx-opt-dna-stat-num{ font-family:var(--lx-display); font-size:2.5rem; color:var(--lx-blue); line-height:1; }
.lx-opt-dna-stat-card strong{ display:block; font-size:.9rem; color:var(--lx-navy); margin-top:.4rem; }
.lx-opt-dna-stat-card span{ font-size:.8rem; color:var(--lx-muted); }
.lx-opt-dna-text h2{ font-size:clamp(1.4rem,3.5vw,2rem); color:var(--lx-navy); margin:.4rem 0 1rem; }
.lx-opt-dna-text .rte{ color:var(--lx-muted); line-height:1.75; }
.lx-opt-dna-tip{ display:flex; align-items:flex-start; gap:.75rem; background:var(--lx-blue-050); border:1px solid var(--lx-blue-100); border-radius:var(--lx-r); padding:1rem 1.1rem; margin-top:1.25rem; font-size:.88rem; line-height:1.6; }
.lx-opt-dna-tip i{ font-size:1.1rem; color:var(--lx-blue); flex:none; margin-top:.1rem; }
.lx-opt-product{ padding-block:clamp(3rem,6vw,5rem); background:#fff; }
.lx-opt-product-card{ position:relative; background:var(--lx-navy); border-radius:var(--lx-r-lg); overflow:hidden; padding:clamp(2rem,5vw,4rem); }
.lx-opt-product-bg{ position:absolute; inset:0; background:radial-gradient(ellipse at 70% 50%,rgba(0,151,212,.25),transparent 60%); pointer-events:none; }
.lx-opt-product-inner{ position:relative; z-index:1; display:grid; grid-template-columns:1fr auto; gap:2rem; align-items:center; }
.lx-opt-product-pill{ display:inline-block; background:rgba(0,151,212,.25); color:var(--lx-blue-100); font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.12em; padding:.3rem .9rem; border-radius:var(--lx-pill); margin-bottom:.9rem; }
.lx-opt-product-content h2{ color:#fff; font-size:clamp(1.4rem,3.5vw,2.1rem); margin:0 0 .75rem; }
.lx-opt-product-content p{ color:rgba(255,255,255,.75); line-height:1.7; margin-bottom:1.5rem; max-width:48ch; }
.lx-opt-product-pillars{ display:flex; flex-wrap:wrap; gap:.75rem 1.5rem; margin-bottom:2rem; }
.lx-opt-product-pillar{ display:flex; align-items:center; gap:.6rem; }
.lx-opt-product-pillar-icon{ width:32px; height:32px; background:rgba(0,151,212,.2); border-radius:8px; display:flex; align-items:center; justify-content:center; color:var(--lx-blue-100); font-size:1rem; flex:none; }
.lx-opt-product-pillar strong{ color:rgba(255,255,255,.9); font-size:.88rem; }
.lx-opt-product-media{ max-width:200px; }
.lx-opt-product-media img{ width:100%; height:auto; filter:drop-shadow(0 8px 24px rgba(0,0,0,.35)); }
@media(max-width:860px){ .lx-opt-intro-grid,.lx-opt-dna-grid,.lx-opt-product-inner{ grid-template-columns:1fr; } }
@media(max-width:520px){ .lx-opt-params-grid{ grid-template-columns:1fr 1fr; } .lx-opt-cycle-stops{ gap:0; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Optimise Page",
  "settings": [
    {"type": "header", "content": "Hero"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sperm health"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Optimising sperm health"},
    {"type": "richtext", "id": "lead", "label": "Lead paragraph", "default": "<p>Men produce sperm on a continuous basis. Your body needs a constant supply of nutrients and vitamins for healthy sperm development — and the lifestyle changes you make today take 3+ months to show up in a semen analysis.</p>"},
    {"type": "checkbox", "id": "show_keystat", "label": "Show key stat", "default": true},
    {"type": "text", "id": "keystat_num", "label": "Stat number", "default": "74"},
    {"type": "text", "id": "keystat_title", "label": "Stat title", "default": "days to mature"},
    {"type": "text", "id": "keystat_sub", "label": "Stat sub", "default": "+ 20 days to become fertilisation-capable"},

    {"type": "header", "content": "What affects sperm (intro)"},
    {"type": "checkbox", "id": "show_intro", "label": "Show section", "default": true},
    {"type": "text", "id": "intro_eyebrow", "label": "Eyebrow", "default": "The fundamentals"},
    {"type": "text", "id": "intro_heading", "label": "Heading", "default": "What affects sperm quality?"},
    {"type": "richtext", "id": "intro_body", "label": "Body", "default": "<p>Age, diet, lack of certain nutrients and lifestyle factors can all have a negative impact on sperm quality.</p><p>Research has shown that specific nutrients, antioxidants, and vitamins can improve sperm quality and health — but the right combination matters.</p>"},
    {"type": "text", "id": "factors_title", "label": "Factors list title", "default": "Negative lifestyle factors"},

    {"type": "header", "content": "74-day cycle visual"},
    {"type": "checkbox", "id": "show_cycle", "label": "Show cycle", "default": true},
    {"type": "text", "id": "cycle_eyebrow", "label": "Eyebrow", "default": "The science"},
    {"type": "text", "id": "cycle_heading", "label": "Heading", "default": "The sperm production timeline"},
    {"type": "textarea", "id": "cycle_sub", "label": "Sub-text", "default": "On average, sperm requires 74 days to fully mature and up to 20 additional days to become capable of fertilisation."},
