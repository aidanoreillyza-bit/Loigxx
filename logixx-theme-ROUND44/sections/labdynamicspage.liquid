{%- comment -%}
  Lab Dynamics page — partner/3PL client showcase.
  Lab Dynamics' own dark navy clinical palette.
{%- endcomment -%}

{%- capture icon_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{%- endcapture -%}
{%- capture icon_arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>{%- endcapture -%}

<div class="ldx">

  {%- comment -%} ===== HERO ===== {%- endcomment -%}
  <section class="ldx-hero">
    <div class="ldx-container">
      <div class="ldx-hero-grid">
        <div class="ldx-hero-text">
          <span class="ldx-hero-pill">
            <span class="ldx-hero-pill-dot"></span>
            {{ section.settings.hero_eyebrow | default: '30+ Years of Excellence' }}
          </span>
          <h1 class="ldx-hero-title">
            <a href="{{ section.settings.external_url | default: 'https://www.labdynamics.co.uk' }}" target="_blank" rel="noopener" class="ldx-hero-title-link">{{ section.settings.hero_heading | default: 'Clinical, Laboratory & Research Supplies for' }}</a>
            <span class="ldx-hero-title-gold">{{ section.settings.hero_heading_accent | default: 'Hospitals, IVF Labs & Dental Practices' }}</span>
          </h1>
          <p class="ldx-hero-lead">{{ section.settings.hero_sub | default: 'Specialist suppliers of clinical disinfectants, laboratory consumables and equipment to IVF Laboratories, Hospitals, Dentists, and a cross section of industries. We support Scientists, Nurses, Embryologists and clinical teams across the UK with premium quality products.' }}</p>
          <div class="ldx-hero-ctas">
            <a href="#ldx-enquire" class="ldx-btn ldx-btn--primary">{{ section.settings.hero_cta | default: 'Enquire about products' }} <span class="ldx-btn-arrow">{{ icon_arrow }}</span></a>
            <a href="{{ section.settings.external_url | default: 'https://www.labdynamics.co.uk' }}" target="_blank" rel="noopener" class="ldx-btn ldx-btn--ghost">Visit labdynamics.co.uk <span class="ldx-btn-arrow">{{ icon_arrow }}</span></a>
          </div>
        </div>

        <div class="ldx-hero-visual">
          <div class="ldx-hero-circle">
            <div class="ldx-hero-plate">
              <img src="{{ 'labdynamics-logo-v4.png' | asset_url }}" alt="Lab Dynamics — clinical, laboratory and research supplies" width="900" height="631" class="ldx-hero-logo">
            </div>
          </div>
          <span class="ldx-hero-badge ldx-hero-badge--top">
            <span class="ldx-hero-badge-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 L20 5 V11 C20 16 16 20 12 22 C8 20 4 16 4 11 V5 Z"/><polyline points="9 12 11 14 15 10"/></svg>
            </span>
            CE Certified Products
          </span>
          <span class="ldx-hero-badge ldx-hero-badge--bottom">
            <span class="ldx-hero-badge-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M8.5 14 L7 22 L12 19 L17 22 L15.5 14"/></svg>
            </span>
            Premium Quality Products &amp; Service
          </span>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== ABOUT ===== {%- endcomment -%}
  <section class="ldx-about">
    <div class="ldx-container">
      <div class="ldx-head">
        <span class="ldx-mini-eyebrow">{{ section.settings.about_eyebrow | default: 'Who they are' }}</span>
        <h2>{{ section.settings.about_heading | default: 'Trusted by IVF labs for over 30 years' }}</h2>
      </div>
      <div class="ldx-about-grid">
        <div class="ldx-about-text rte">
          {{ section.settings.about_body | default: '<p>Lab Dynamics works directly with scientists and embryologists to identify and supply the key items that support IVF laboratories.</p><p>Their team has advised, directed and supported IVF and clinical teams for over 30 years — supplying IVF units across the UK and internationally, with a complete range of consumables, equipment and quality-management solutions that meet European and UK regulations.</p>' }}
          <p><a href="{{ section.settings.external_url | default: 'https://www.labdynamics.co.uk' }}" target="_blank" rel="noopener" class="ldx-external-link">Visit labdynamics.co.uk <span>{{ icon_arrow }}</span></a></p>
        </div>
        <div class="ldx-about-stats">
          <div class="ldx-stat"><strong>30+</strong><span>Years experience</span></div>
          <div class="ldx-stat"><strong>UK & EU</strong><span>Regulatory compliance</span></div>
          <div class="ldx-stat"><strong>IVF</strong><span>Specialists</span></div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== PRODUCTS ===== {%- endcomment -%}
  <section class="ldx-products">
    <div class="ldx-container">
      <div class="ldx-head">
        <span class="ldx-mini-eyebrow">{{ section.settings.products_eyebrow | default: 'Product range' }}</span>
        <h2>{{ section.settings.products_heading | default: 'What Lab Dynamics supplies' }}</h2>
      </div>
      <div class="ldx-products-grid">
        {% for block in section.blocks %}
          {% if block.type == 'product' %}
            <div class="ldx-product" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}<div class="ldx-product-icon"><i class="ph {{ block.settings.icon }}"></i></div>{% endif %}
              <h3>{{ block.settings.title }}</h3>
              {% if block.settings.tagline != blank %}<p class="ldx-product-tag">{{ block.settings.tagline }}</p>{% endif %}
              {% if block.settings.description != blank %}<p>{{ block.settings.description }}</p>{% endif %}
              {% if block.settings.features != blank %}
                <ul class="ldx-product-features">
                  {% assign feats = block.settings.features | newline_to_br | split: '<br />' %}
                  {% for f in feats %}
                    {% assign ff = f | strip %}
                    {% if ff != blank %}<li><span class="ldx-tick">{{ icon_check }}</span>{{ ff }}</li>{% endif %}
                  {% endfor %}
                </ul>
              {% endif %}
              <a href="#ldx-enquire" class="ldx-product-cta">Enquire about this <span>{{ icon_arrow }}</span></a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {%- comment -%} ===== WHY ===== {%- endcomment -%}
  <section class="ldx-why">
    <div class="ldx-container">
      <div class="ldx-head">
        <span class="ldx-mini-eyebrow">{{ section.settings.why_eyebrow | default: 'Why Lab Dynamics' }}</span>
        <h2>{{ section.settings.why_heading | default: 'Specialist supply, scientific standards' }}</h2>
      </div>
      <div class="ldx-why-grid">
        <div class="ldx-why-card"><div class="ldx-why-icon"><i class="ph ph-microscope"></i></div><strong>Built for IVF labs</strong><p>Every product is selected with embryologists and clinical teams in mind — not generic lab supply.</p></div>
        <div class="ldx-why-card"><div class="ldx-why-icon"><i class="ph ph-shield-check"></i></div><strong>Compliant & certified</strong><p>Products meet UK and European regulations. Used in accredited clinical environments.</p></div>
        <div class="ldx-why-card"><div class="ldx-why-icon"><i class="ph ph-globe-hemisphere-west"></i></div><strong>UK & international supply</strong><p>Serving IVF units across the UK and abroad, with reliable fulfilment supported by LogixX.</p></div>
        <div class="ldx-why-card"><div class="ldx-why-icon"><i class="ph ph-users-three"></i></div><strong>30+ years of expertise</strong><p>A team that has advised, directed and supported clinical teams for three decades.</p></div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== ENQUIRE FORM ===== {%- endcomment -%}
  <section class="ldx-enquire" id="ldx-enquire">
    <div class="ldx-container">
      <div class="ldx-enquire-card">
        <div class="ldx-enquire-text">
          <span class="ldx-mini-eyebrow">{{ section.settings.enquire_eyebrow | default: 'Get in touch' }}</span>
          <h2>{{ section.settings.enquire_heading | default: 'Enquire about Lab Dynamics products' }}</h2>
          <p>{{ section.settings.enquire_sub | default: 'Tell us what you need — disinfectants, instrumentation, wipes, air quality — and we will get the right person back to you.' }}</p>
        </div>
        {% form 'contact', class: 'ldx-enquire-form' %}
          {% if form.posted_successfully? %}
            <div class="ldx-form-success">Thanks — your enquiry has been sent. We will be in touch shortly.</div>
          {% endif %}
          {% if form.errors %}
            <div class="ldx-form-error">There was a problem: {{ form.errors | default_errors }}</div>
          {% endif %}
          <div class="ldx-form-row">
            <label>Name <input type="text" name="contact[name]" required></label>
            <label>Email <input type="email" name="contact[email]" required></label>
          </div>
          <div class="ldx-form-row">
            <label>Organisation <input type="text" name="contact[company]"></label>
            <label>Phone <input type="tel" name="contact[phone]"></label>
          </div>
          <label>Product(s) of interest
            <select name="contact[product]">
              <option value="">Select a product range</option>
              <option>Laboratory disinfectants (UMONIUM38)</option>
              <option>NiloTech instrumentation</option>
              <option>Detergent & disinfectant wipes</option>
              <option>Air quality management</option>
              <option>PCU Medical equipment</option>
              <option>Ultrasound probe covers</option>
              <option>Other / not sure</option>
            </select>
          </label>
          <label>Your enquiry <textarea name="contact[body]" rows="5" required></textarea></label>
          <input type="hidden" name="contact[subject]" value="Lab Dynamics enquiry from LogixX site">
          <button type="submit" class="ldx-btn ldx-btn--primary">Send enquiry <span class="ldx-btn-arrow">{{ icon_arrow }}</span></button>
          <p class="ldx-form-fine">We will respond within 1 working day.</p>
        {% endform %}
      </div>
    </div>
  </section>

</div>

{% stylesheet %}
.ldx{ font-family:var(--lx-body); }
.ldx-container{ max-width:1200px; margin-inline:auto; padding-inline:clamp(1.1rem,4vw,2rem); }
.ldx-hero{ padding-block:clamp(4rem,8vw,7rem); background:var(--lx-navy); }
.ldx-hero-grid{ display:grid; grid-template-columns:1fr 400px; gap:clamp(2.5rem,5vw,4rem); align-items:center; }
.ldx-hero-pill{ display:inline-flex; align-items:center; gap:.55rem; background:rgba(0,151,212,.2); color:var(--lx-blue-100); border:1px solid rgba(0,151,212,.3); padding:.35rem .9rem; border-radius:var(--lx-pill); font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; margin-bottom:1.25rem; }
.ldx-hero-pill-dot{ width:8px; height:8px; background:var(--lx-blue); border-radius:50%; }
.ldx-hero-title{ font-family:var(--lx-display); font-size:clamp(1.7rem,4vw,2.8rem); color:#fff; margin:0 0 1.1rem; line-height:1.2; }
.ldx-hero-title-link{ color:#fff; text-decoration:none; }
.ldx-hero-title-gold{ display:block; color:var(--lx-gold); }
.ldx-hero-lead{ color:rgba(255,255,255,.72); line-height:1.75; margin-bottom:2rem; }
.ldx-hero-ctas{ display:flex; gap:.75rem; flex-wrap:wrap; }
.ldx-btn{ display:inline-flex; align-items:center; gap:.5rem; padding:.8rem 1.75rem; border-radius:var(--lx-pill); font-family:var(--lx-body); font-weight:700; font-size:.95rem; text-decoration:none; cursor:pointer; border:none; transition:background var(--lx-dur), transform var(--lx-dur), color var(--lx-dur); }
.ldx-btn--primary{ background:var(--lx-blue); color:#fff; }
.ldx-btn--primary:hover{ background:var(--lx-blue-600); transform:translateY(-2px); }
.ldx-btn--ghost{ background:transparent; color:rgba(255,255,255,.85); border:1.5px solid rgba(255,255,255,.3); }
.ldx-btn--ghost:hover{ background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.6); }
.ldx-btn-arrow{ display:flex; }
.ldx-btn-arrow svg{ width:16px; height:16px; }
.ldx-hero-visual{ display:flex; align-items:center; justify-content:center; position:relative; }
.ldx-hero-circle{ width:340px; height:340px; border-radius:50%; background:rgba(0,151,212,.08); border:1px solid rgba(0,151,212,.2); display:flex; align-items:center; justify-content:center; }
.ldx-hero-plate{ background:rgba(255,255,255,.06); border-radius:var(--lx-r-lg); padding:2rem; }
.ldx-hero-logo{ max-width:260px; height:auto; filter:brightness(0) invert(1); }
.ldx-hero-badge{ position:absolute; background:#fff; border-radius:var(--lx-r); padding:.5rem .9rem; font-size:.78rem; font-weight:700; color:var(--lx-navy); display:flex; align-items:center; gap:.5rem; box-shadow:var(--lx-sh); }
.ldx-hero-badge--top{ top:10%; right:-20px; }
.ldx-hero-badge--bottom{ bottom:10%; left:-20px; }
.ldx-hero-badge-icon{ width:24px; height:24px; background:var(--lx-blue-050); border-radius:6px; display:flex; align-items:center; justify-content:center; color:var(--lx-blue); }
.ldx-hero-badge-icon svg{ width:14px; height:14px; }
.ldx-head{ text-align:center; max-width:560px; margin:0 auto 2.5rem; }
.ldx-mini-eyebrow{ display:block; text-transform:uppercase; letter-spacing:.14em; font-size:.78rem; font-weight:700; color:var(--lx-blue-ink); margin-bottom:.6rem; }
.ldx-head h2{ margin:.4rem 0 0; font-size:clamp(1.4rem,3.5vw,2.1rem); color:var(--lx-navy); }
.ldx-about{ padding-block:clamp(3rem,6vw,5rem); background:#fff; }
.ldx-about-grid{ display:grid; grid-template-columns:1fr 280px; gap:clamp(2rem,4vw,3.5rem); align-items:start; }
.ldx-about-text.rte{ color:var(--lx-muted); line-height:1.75; }
.ldx-about-text.rte p{ margin-bottom:1rem; }
.ldx-external-link{ display:inline-flex; align-items:center; gap:.4rem; color:var(--lx-blue-ink); font-weight:600; font-size:.9rem; text-decoration:none; }
.ldx-external-link span{ display:flex; }
.ldx-about-stats{ display:flex; flex-direction:column; gap:1rem; }
.ldx-stat{ background:var(--lx-bg-soft); border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:1.25rem; text-align:center; }
.ldx-stat strong{ display:block; font-family:var(--lx-display); font-size:1.8rem; color:var(--lx-blue); line-height:1; }
.ldx-stat span{ font-size:.82rem; color:var(--lx-muted); margin-top:.3rem; display:block; }
.ldx-products{ padding-block:clamp(3rem,6vw,5rem); background:var(--lx-bg-soft); border-top:1px solid var(--lx-line); }
.ldx-products-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:1.25rem; }
.ldx-product{ background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:1.75rem; display:flex; flex-direction:column; transition:transform var(--lx-dur), box-shadow var(--lx-dur), border-color var(--lx-dur); }
.ldx-product:hover{ transform:translateY(-4px); box-shadow:var(--lx-sh-lg); border-color:transparent; }
.ldx-product-icon{ width:48px; height:48px; background:var(--lx-blue-050); border-radius:13px; display:flex; align-items:center; justify-content:center; font-size:1.5rem; color:var(--lx-blue); margin-bottom:1.1rem; }
.ldx-product h3{ margin:0 0 .4rem; font-size:1rem; color:var(--lx-navy); }
.ldx-product-tag{ font-size:.82rem; font-weight:600; color:var(--lx-blue-ink); margin-bottom:.5rem; }
.ldx-product p{ font-size:.85rem; color:var(--lx-muted); line-height:1.55; margin-bottom:.75rem; flex:1; }
.ldx-product-features{ list-style:none; padding:0; margin:.75rem 0; }
.ldx-product-features li{ display:flex; align-items:flex-start; gap:.5rem; font-size:.83rem; color:var(--lx-muted); margin-bottom:.4rem; line-height:1.45; }
.ldx-tick{ color:var(--lx-blue); flex:none; width:16px; height:16px; display:flex; margin-top:1px; }
.ldx-tick svg{ width:16px; height:16px; }
.ldx-product-cta{ display:inline-flex; align-items:center; gap:.4rem; margin-top:auto; font-size:.85rem; font-weight:700; color:var(--lx-blue-ink); text-decoration:none; transition:gap var(--lx-dur); }
.ldx-product-cta span{ display:flex; }
.ldx-product-cta span svg{ width:14px; height:14px; }
.ldx-product-cta:hover{ gap:.65rem; }
.ldx-why{ padding-block:clamp(3rem,6vw,5rem); background:#fff; }
.ldx-why-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:1.25rem; }
.ldx-why-card{ text-align:center; padding:1.75rem 1.25rem; background:var(--lx-bg-soft); border-radius:var(--lx-r-lg); border:1px solid var(--lx-line); }
.ldx-why-icon{ width:52px; height:52px; background:var(--lx-blue-050); border-radius:15px; display:flex; align-items:center; justify-content:center; font-size:1.6rem; color:var(--lx-blue); margin:0 auto 1rem; }
.ldx-why-card strong{ display:block; color:var(--lx-navy); font-size:.95rem; margin-bottom:.4rem; }
.ldx-why-card p{ font-size:.83rem; color:var(--lx-muted); margin:0; line-height:1.55; }
.ldx-enquire{ padding-block:clamp(3.5rem,7vw,6rem); background:var(--lx-bg-soft); border-top:1px solid var(--lx-line); }
.ldx-enquire-card{ background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); box-shadow:var(--lx-sh-lg); display:grid; grid-template-columns:1fr 1fr; overflow:hidden; }
.ldx-enquire-text{ background:var(--lx-navy); padding:clamp(2rem,4vw,3rem); color:#fff; }
.ldx-enquire-text .ldx-mini-eyebrow{ color:var(--lx-blue-100); }
.ldx-enquire-text h2{ color:#fff; margin:.4rem 0 .75rem; font-size:clamp(1.3rem,3vw,1.9rem); }
.ldx-enquire-text p{ color:rgba(255,255,255,.72); line-height:1.7; }
.ldx-enquire-form{ padding:clamp(2rem,4vw,3rem); display:flex; flex-direction:column; gap:1rem; }
.ldx-form-row{ display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
.ldx-enquire-form label{ display:flex; flex-direction:column; gap:.4rem; font-size:.88rem; font-weight:600; color:var(--lx-navy); }
.ldx-enquire-form input,.ldx-enquire-form select,.ldx-enquire-form textarea{ padding:.7rem 1rem; border:1.5px solid var(--lx-line-strong); border-radius:var(--lx-r); font-family:var(--lx-body); font-size:.9rem; color:var(--lx-ink); background:#fff; }
.ldx-enquire-form input:focus,.ldx-enquire-form select:focus,.ldx-enquire-form textarea:focus{ outline:none; border-color:var(--lx-blue); }
.ldx-form-success{ background:#e8f8f0; border:1px solid #a0dcb8; border-radius:var(--lx-r); padding:.9rem 1.1rem; color:#1e6e44; font-size:.9rem; }
.ldx-form-error{ background:#fef2f2; border:1px solid #fca5a5; border-radius:var(--lx-r); padding:.9rem 1.1rem; color:#b91c1c; font-size:.9rem; }
.ldx-form-fine{ font-size:.78rem; color:var(--lx-faint); margin:0; }
@media(max-width:860px){ .ldx-hero-grid{ grid-template-columns:1fr; } .ldx-hero-visual{ display:none; } .ldx-about-grid{ grid-template-columns:1fr; } .ldx-why-grid{ grid-template-columns:1fr 1fr; } .ldx-enquire-card{ grid-template-columns:1fr; } }
@media(max-width:520px){ .ldx-why-grid{ grid-template-columns:1fr; } .ldx-form-row{ grid-template-columns:1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Lab Dynamics Page",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "url", "id": "external_url", "label": "Lab Dynamics website", "info": "Where 'Visit their site' and the brand name link to" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow pill", "default": "30+ Years of Excellence" },
    { "type": "text", "id": "hero_heading", "label": "Heading (white part)", "default": "Clinical, Laboratory & Research Supplies for" },
    { "type": "text", "id": "hero_heading_accent", "label": "Heading (gold part)", "default": "Hospitals, IVF Labs & Dental Practices" },
    { "type": "textarea", "id": "hero_sub", "label": "Lead text", "default": "Specialist suppliers of clinical disinfectants, laboratory consumables and equipment to IVF Laboratories, Hospitals, Dentists, and a cross section of industries. We support Scientists, Nurses, Embryologists and clinical teams across the UK with premium quality products." },
    { "type": "text", "id": "hero_cta", "label": "CTA label", "default": "Enquire about products" },
    { "type": "header", "content": "About" },
    { "type": "text", "id": "about_eyebrow", "label": "Eyebrow", "default": "Who they are" },
    { "type": "text", "id": "about_heading", "label": "Heading", "default": "Trusted by IVF labs for over 30 years" },
    { "type": "richtext", "id": "about_body", "label": "Body" },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "products_eyebrow", "label": "Eyebrow", "default": "Product range" },
    { "type": "text", "id": "products_heading", "label": "Heading", "default": "What Lab Dynamics supplies" },
    { "type": "header", "content": "Why" },
    { "type": "text", "id": "why_eyebrow", "label": "Eyebrow", "default": "Why Lab Dynamics" },
    { "type": "text", "id": "why_heading", "label": "Heading", "default": "Specialist supply, scientific standards" },
    { "type": "header", "content": "Enquire" },
    { "type": "text", "id": "enquire_eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "enquire_heading", "label": "Heading", "default": "Enquire about Lab Dynamics products" },
    { "type": "textarea", "id": "enquire_sub", "label": "Subtext", "default": "Tell us what you need and we will get the right person back to you." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product range",
      "settings": [
        { "type": "text", "id": "icon", "label": "Phosphor icon", "default": "ph-drop" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "textarea", "id": "features", "label": "Features (one per line)" }
      ]
    }
  ],
  "presets": [
    { "name": "Lab Dynamics Page" }
  ]
}
{% endschema %}
