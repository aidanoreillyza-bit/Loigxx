<section class="lx-news">

  <!-- HERO -->
  <div class="lx-news-hero">
    <div class="container">
      <div class="lx-news-hero-inner">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h1>{{ section.settings.heading }}</h1>
        <p class="lx-news-lead">{{ section.settings.subheading }}</p>
      </div>
    </div>
  </div>

  <!-- NEWS ITEMS -->
  <div class="lx-news-list">
    <div class="container">

      {% assign featured_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'news' and block.settings.featured %}
          {% assign featured_count = featured_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      <!-- FEATURED (large) item if any -->
      {% if featured_count > 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'news' and block.settings.featured %}
            <div class="lx-news-featured" {{ block.shopify_attributes }}>
              <div class="lx-news-featured-media">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.title }}">
                {% else %}
                  <div class="lx-news-placeholder lx-news-placeholder--lg">
                    <i class="ph ph-newspaper"></i>
                  </div>
                {% endif %}
                {% if block.settings.badge != blank %}
                  <span class="lx-news-featured-badge">{{ block.settings.badge }}</span>
                {% endif %}
              </div>
              <div class="lx-news-featured-body">
                {% if block.settings.tag != blank %}
                  <div class="lx-news-tags">
                    <span class="lx-news-tag">{{ block.settings.tag }}</span>
                  </div>
                {% endif %}
                <h2>{{ block.settings.title }}</h2>
                <div class="lx-news-excerpt rte">{{ block.settings.excerpt }}</div>
                <div class="lx-news-meta">
                  {% if block.settings.date != blank %}<span><i class="ph ph-calendar"></i> {{ block.settings.date }}</span>{% endif %}
                  {% if block.settings.author != blank %}<span><i class="ph ph-user"></i> {{ block.settings.author }}</span>{% endif %}
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}" class="lx-news-readmore">{{ block.settings.link_text | default: 'Read more' }} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}

      <!-- GRID of non-featured items -->
      {% assign regular_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'news' and block.settings.featured != true %}
          {% assign regular_count = regular_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if regular_count > 0 %}
        <div class="lx-news-grid">
          {% for block in section.blocks %}
            {% if block.type == 'news' and block.settings.featured != true %}
              <article class="lx-news-card" {{ block.shopify_attributes }}>
                <div class="lx-news-card-media">
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}">
                  {% else %}
                    <div class="lx-news-placeholder"><i class="ph ph-newspaper"></i></div>
                  {% endif %}
                </div>
                <div class="lx-news-card-body">
                  {% if block.settings.tag != blank %}
                    <div class="lx-news-tags">
                      <span class="lx-news-tag">{{ block.settings.tag }}</span>
                    </div>
                  {% endif %}
                  <h3>{{ block.settings.title }}</h3>
                  <div class="lx-news-card-excerpt rte">{{ block.settings.excerpt }}</div>
                  <div class="lx-news-card-meta">
                    {% if block.settings.date != blank %}<span><i class="ph ph-calendar"></i> {{ block.settings.date }}</span>{% endif %}
                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link }}" class="lx-news-card-link">{{ block.settings.link_text | default: 'Read more' }} →</a>
                    {% endif %}
                  </div>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.blocks.size == 0 %}
        <div class="lx-news-empty">
          <div class="lx-news-empty-icon"><i class="ph ph-newspaper-clipping"></i></div>
          <h2>Add your first news item</h2>
          <p>Open the theme customizer and click "Add block" → "News item" to add company announcements, partnerships, and awards.</p>
        </div>
      {% endif %}

    </div>
  </div>

  <!-- CLOSING CTA -->
  {% if section.settings.show_closing %}
    <div class="lx-news-closing">
      <div class="container">
        <div class="lx-news-closing-card">
          {% if section.settings.closing_heading != blank %}<h2>{{ section.settings.closing_heading }}</h2>{% endif %}
          <p>{{ section.settings.closing_sub }}</p>
          <div class="lx-news-closing-actions">
            <a href="{{ section.settings.closing_btn1_link }}" class="btn btn-primary">{{ section.settings.closing_btn1_text }}</a>
            <a href="{{ section.settings.closing_btn2_link }}" class="btn btn-ghost">{{ section.settings.closing_btn2_text }}</a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</section>

{% stylesheet %}
.lx-news{ font-family:var(--lx-body); }
.lx-news-hero{ padding-block:clamp(3.5rem,7vw,6rem); background:var(--lx-bg-soft); border-bottom:1px solid var(--lx-line); text-align:center; }
.lx-news-hero-inner{ max-width:640px; margin-inline:auto; }
.lx-news-hero-inner h1{ margin:.75rem 0 0; font-size:clamp(2rem,5vw,3.2rem); }
.lx-news-lead{ color:var(--lx-muted); font-size:1.1rem; margin-top:.75rem; line-height:1.65; }
.lx-news-list{ padding-block:clamp(3rem,6vw,5rem); }
.lx-news-featured{ display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,5vw,3.5rem); align-items:center; margin-bottom:3rem; padding-bottom:3rem; border-bottom:1px solid var(--lx-line); }
.lx-news-featured-media{ border-radius:var(--lx-r-lg); overflow:hidden; aspect-ratio:16/10; position:relative; background:var(--lx-bg-soft); box-shadow:var(--lx-sh-lg); }
.lx-news-featured-media img{ width:100%; height:100%; object-fit:cover; }
.lx-news-featured-badge{ position:absolute; top:1rem; left:1rem; background:var(--lx-blue); color:#fff; font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; padding:.3rem .8rem; border-radius:var(--lx-pill); }
.lx-news-placeholder--lg{ min-height:280px; display:flex; align-items:center; justify-content:center; font-size:3rem; color:var(--lx-faint); }
.lx-news-featured-body h2{ font-size:clamp(1.4rem,3vw,2rem); color:var(--lx-navy); margin:.75rem 0 .9rem; }
.lx-news-excerpt.rte{ color:var(--lx-muted); line-height:1.7; }
.lx-news-meta{ display:flex; flex-wrap:wrap; align-items:center; gap:.6rem 1.25rem; font-size:.85rem; color:var(--lx-faint); margin-top:1rem; }
.lx-news-meta i{ margin-right:.3rem; }
.lx-news-readmore{ color:var(--lx-blue-ink); font-weight:600; display:inline-flex; align-items:center; gap:.4rem; text-decoration:none; }
.lx-news-tags{ display:flex; flex-wrap:wrap; gap:.4rem; margin-bottom:.75rem; }
.lx-news-tag{ background:var(--lx-blue-050); color:var(--lx-blue-ink); font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; padding:.2rem .6rem; border-radius:var(--lx-pill); }
.lx-news-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }
.lx-news-card{ display:flex; flex-direction:column; background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); overflow:hidden; transition:transform var(--lx-dur) var(--lx-ease), box-shadow var(--lx-dur), border-color var(--lx-dur); }
.lx-news-card:hover{ transform:translateY(-4px); box-shadow:var(--lx-sh-lg); border-color:transparent; }
.lx-news-card-media{ aspect-ratio:16/9; overflow:hidden; background:var(--lx-bg-soft); }
.lx-news-card-media img{ width:100%; height:100%; object-fit:cover; }
.lx-news-placeholder{ width:100%; min-height:140px; display:flex; align-items:center; justify-content:center; font-size:2rem; color:var(--lx-faint); }
.lx-news-card-body{ padding:1.25rem; flex:1; display:flex; flex-direction:column; }
.lx-news-card-body h3{ margin:0 0 .5rem; font-size:1rem; color:var(--lx-navy); line-height:1.45; }
.lx-news-card-excerpt.rte{ font-size:.88rem; color:var(--lx-muted); flex:1; line-height:1.6; }
.lx-news-card-meta{ display:flex; justify-content:space-between; align-items:center; gap:.75rem; font-size:.8rem; color:var(--lx-faint); margin-top:1rem; padding-top:.75rem; border-top:1px solid var(--lx-line); }
.lx-news-card-link{ color:var(--lx-blue-ink); font-weight:600; text-decoration:none; }
.lx-news-empty{ text-align:center; padding:4rem 1rem; }
.lx-news-empty-icon{ font-size:3rem; color:var(--lx-faint); margin-bottom:1rem; }
.lx-news-closing{ padding-block:clamp(3rem,5vw,4.5rem); background:var(--lx-navy); }
.lx-news-closing-card{ text-align:center; }
.lx-news-closing-card h2{ color:#fff; margin:0 0 .75rem; }
.lx-news-closing-card p{ color:rgba(255,255,255,.7); max-width:44ch; margin:0 auto 2rem; line-height:1.65; }
.lx-news-closing-actions{ display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; }
@media(max-width:860px){ .lx-news-featured{ grid-template-columns:1fr; } .lx-news-grid{ grid-template-columns:1fr 1fr; } }
@media(max-width:520px){ .lx-news-grid{ grid-template-columns:1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "News Page",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Company news" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest from LogixX" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Announcements, partnerships, awards, and the latest from our team." },

    { "type": "header", "content": "Closing CTA" },
    { "type": "checkbox", "id": "show_closing", "label": "Show closing CTA", "default": true },
    { "type": "text", "id": "closing_heading", "label": "Heading", "default": "Get in touch" },
    { "type": "textarea", "id": "closing_sub", "label": "Sub-text", "default": "Have a press enquiry or want to learn more about LogixX? Get in touch with our team." },
    { "type": "text", "id": "closing_btn1_text", "label": "Primary button", "default": "Contact us" },
    { "type": "text", "id": "closing_btn1_link", "label": "Primary button link", "default": "/pages/contact" },
    { "type": "text", "id": "closing_btn2_text", "label": "Secondary button", "default": "Browse products" },
    { "type": "text", "id": "closing_btn2_link", "label": "Secondary button link", "default": "/pages/shop" }
  ],
  "blocks": [
    {
      "type": "news",
      "name": "News item",
      "settings": [
        { "type": "checkbox", "id": "featured", "label": "Featured (large card at top)", "default": false },
        { "type": "text", "id": "badge", "label": "Featured badge text", "default": "Latest" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag (e.g. Partnership, Award)" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "excerpt", "label": "Excerpt / summary" },
        { "type": "text", "id": "date", "label": "Date", "default": "January 2026" },
        { "type": "text", "id": "author", "label": "Author (optional)" },
        { "type": "text", "id": "link", "label": "Link URL (optional)" },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "Read more" }
      ]
    }
  ],
  "presets": [
    { "name": "News Page" }
  ]
}
{% endschema %}
