<section class="lx-cart" id="lx-cart-{{ section.id }}">
  <div class="container">

    <!-- HEAD -->
    <div class="lx-cart-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      {% if cart.item_count > 0 %}
        <p class="lx-cart-count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %} in your basket</p>
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <form action="/cart" method="post" novalidate class="lx-cart-form" id="lx-cart-form">

        <div class="lx-cart-grid">

          <!-- LEFT: ITEMS LIST -->
          <div class="lx-cart-items">
            {% for item in cart.items %}
              <article class="lx-cart-item" data-line="{{ forloop.index }}">
                <a href="{{ item.url }}" class="lx-cart-item-media">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title }}">
                  {% else %}
                    <div class="lx-cart-item-placeholder"><i class="ph ph-package"></i></div>
                  {% endif %}
                </a>

                <div class="lx-cart-item-info">
                  <a href="{{ item.url }}" class="lx-cart-item-title">{{ item.product.title }}</a>
                  {% if item.variant.title != 'Default Title' %}
                    <span class="lx-cart-item-variant">{{ item.variant.title }}</span>
                  {% endif %}

                  {%- if item.selling_plan_allocation -%}
                    <span class="lx-cart-item-plan">
                      <i class="ph ph-repeat"></i> {{ item.selling_plan_allocation.selling_plan.name }}
                    </span>
                  {%- endif -%}

                  {%- if item.properties.size > 0 -%}
                    <ul class="lx-cart-item-props">
                      {%- for p in item.properties -%}
                        {%- unless p.last == blank or p.first == '_' -%}
                          <li><strong>{{ p.first }}:</strong> {{ p.last }}</li>
                        {%- endunless -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  <div class="lx-cart-item-price-mobile">
                    {{ item.final_line_price | money }}
                  </div>
                </div>

                <div class="lx-cart-item-qty">
                  <span class="lx-cart-item-label">Quantity</span>
                  <div class="lx-cart-qty-control">
                    <button type="button" class="lx-cart-qty-btn" data-action="dec" aria-label="Decrease quantity">
                      <i class="ph ph-minus"></i>
                    </button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" class="lx-cart-qty-input" data-line="{{ forloop.index }}">
                    <button type="button" class="lx-cart-qty-btn" data-action="inc" aria-label="Increase quantity">
                      <i class="ph ph-plus"></i>
                    </button>
                  </div>
                  <button type="button" class="lx-cart-item-remove" data-remove-key="{{ item.key }}">
                    <i class="ph ph-trash"></i> Remove
                  </button>
                </div>

                <div class="lx-cart-item-price">
                  {%- if item.original_line_price > item.final_line_price -%}
                    <span class="lx-cart-item-was">{{ item.original_line_price | money }}</span>
                  {%- endif -%}
                  <strong>{{ item.final_line_price | money }}</strong>
                </div>
              </article>
            {% endfor %}

            <!-- Order note -->
            {% if section.settings.show_note %}
              <details class="lx-cart-note">
                <summary>
                  <i class="ph ph-note-pencil"></i>
                  Add a note to your order
                </summary>
                <textarea name="note" rows="3" placeholder="Special instructions for delivery, gift messages, etc.">{{ cart.note }}</textarea>
              </details>
            {% endif %}
          </div>

          <!-- RIGHT: SUMMARY (sticky) -->
          <aside class="lx-cart-summary">
            <div class="lx-cart-summary-card">
              <h2>Order summary</h2>

              <div class="lx-cart-summary-row">
                <span>Subtotal</span>
                <strong>{{ cart.items_subtotal_price | money }}</strong>
              </div>

              {%- if cart.cart_level_discount_applications.size > 0 -%}
                {%- for discount in cart.cart_level_discount_applications -%}
                  <div class="lx-cart-summary-row lx-cart-summary-row--discount">
                    <span><i class="ph ph-tag"></i> {{ discount.title }}</span>
                    <strong>−{{ discount.total_allocated_amount | money }}</strong>
                  </div>
                {%- endfor -%}
              {%- endif -%}

              <div class="lx-cart-summary-row lx-cart-summary-row--shipping">
                <span><i class="ph ph-truck"></i> Shipping</span>
                <span>{{ section.settings.shipping_note }}</span>
              </div>

              <div class="lx-cart-summary-total">
                <span>Total</span>
                <strong>{{ cart.total_price | money }}</strong>
              </div>

              <button type="submit" name="checkout" class="lx-cart-checkout">
                Secure checkout
                <i class="ph ph-lock"></i>
              </button>

              <a href="{{ section.settings.continue_link }}" class="lx-cart-continue">
                <i class="ph ph-arrow-left"></i> Continue shopping
              </a>

              <!-- Trust badges -->
              <div class="lx-cart-trust">
                <div class="lx-cart-trust-item">
                  <i class="ph ph-shield-check"></i>
                  <div>
                    <strong>Secure checkout</strong>
                    <span>SSL encrypted</span>
                  </div>
                </div>
                <div class="lx-cart-trust-item">
                  <i class="ph ph-truck"></i>
                  <div>
                    <strong>Free UK shipping</strong>
                    <span>On orders over £50</span>
                  </div>
                </div>
                <div class="lx-cart-trust-item">
                  <i class="ph ph-arrow-counter-clockwise"></i>
                  <div>
                    <strong>30-day returns</strong>
                    <span>No-quibble policy</span>
                  </div>
                </div>
              </div>
            </div>
          </aside>

        </div>
      </form>

    {% else %}

      <!-- EMPTY STATE -->
      <div class="lx-cart-empty">
        <div class="lx-cart-empty-icon">
          <i class="ph ph-shopping-bag"></i>
        </div>
        <h2>Your basket is empty</h2>
        <p>{{ section.settings.empty_text }}</p>
        <a href="{{ section.settings.continue_link }}" class="lx-cart-empty-cta">
          Browse products
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>

        <!-- Quick links -->
        <div class="lx-cart-quicklinks">
          <span>Or explore:</span>
          <a href="/products/proxeed-plus">Proxeed Plus</a>
          <a href="/products/proxeed-men">Proxeed Men</a>
          <a href="/products/punalpin">Punalpin</a>
        </div>
      </div>

    {% endif %}

  </div>
</section>

<script>
(function(){
  var section = document.getElementById('lx-cart-{{ section.id }}');
  if (!section) return;

  // Qty +/− buttons
  section.addEventListener('click', function(e){
    var btn = e.target.closest('.lx-cart-qty-btn');
    if (!btn) return;
    e.preventDefault();
    var control = btn.closest('.lx-cart-qty-control');
    if (!control) return;
    var input = control.querySelector('.lx-cart-qty-input');
    var val = parseInt(input.value, 10) || 0;
    var action = btn.dataset.action;
    if (action === 'inc') val += 1;
    else if (action === 'dec' && val > 0) val -= 1;
    input.value = val;
    // Auto-submit when value changes
    var form = document.getElementById('lx-cart-form');
    if (form) {
      var updateBtn = document.createElement('input');
      updateBtn.type = 'hidden';
      updateBtn.name = 'update';
      updateBtn.value = '1';
      form.appendChild(updateBtn);
      form.submit();
    }
  });

  // Remove item using AJAX cart change API with line item key (unique & reliable)
  section.addEventListener('click', function(e){
    var btn = e.target.closest('.lx-cart-item-remove');
    if (!btn) return;
    e.preventDefault();
    var key = btn.dataset.removeKey;
    if (!key) return;

    // Visual feedback
    var item = btn.closest('.lx-cart-item');
    if (item) {
      item.style.opacity = '0.4';
      item.style.pointerEvents = 'none';
    }

    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: key, quantity: 0 })
    })
    .then(function(r){ return r.json(); })
    .then(function(){
      // Reload to refresh the cart display
      window.location.reload();
    })
    .catch(function(err){
      console.error('Remove failed:', err);
      if (item) {
        item.style.opacity = '';
        item.style.pointerEvents = '';
      }
      alert('Could not remove item. Please try again.');
    });
  });
})();
</script>

{% stylesheet %}
.lx-cart{ padding-block:clamp(3rem,6vw,5rem); font-family:var(--lx-body); }
.lx-cart-head{ margin-bottom:2.5rem; }
.lx-cart-head h1{ margin:.5rem 0 0; font-size:clamp(1.8rem,4vw,2.6rem); }
.lx-cart-count{ color:var(--lx-muted); font-size:.95rem; margin-top:.35rem; }
.lx-cart-grid{ display:grid; grid-template-columns:1fr 360px; gap:3rem; align-items:start; }
.lx-cart-item{ display:grid; grid-template-columns:88px 1fr auto auto; gap:1.25rem; align-items:start; padding-block:1.5rem; border-bottom:1px solid var(--lx-line); }
.lx-cart-item-media{ display:block; width:88px; height:88px; border-radius:var(--lx-r); overflow:hidden; border:1px solid var(--lx-line); background:var(--lx-bg-soft); flex:none; }
.lx-cart-item-media img{ width:100%; height:100%; object-fit:cover; }
.lx-cart-item-placeholder{ width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:1.5rem; color:var(--lx-faint); }
.lx-cart-item-title{ font-weight:700; color:var(--lx-navy); text-decoration:none; font-size:.95rem; display:block; margin-bottom:.35rem; }
.lx-cart-item-title:hover{ color:var(--lx-blue-ink); }
.lx-cart-item-variant,.lx-cart-item-plan{ display:block; font-size:.82rem; color:var(--lx-muted); margin-bottom:.25rem; }
.lx-cart-item-plan i{ margin-right:.3rem; color:var(--lx-blue); }
.lx-cart-item-props{ list-style:none; padding:0; margin:.25rem 0 0; font-size:.82rem; color:var(--lx-muted); }
.lx-cart-item-price-mobile{ display:none; font-weight:700; color:var(--lx-navy); margin-top:.5rem; }
.lx-cart-item-label{ display:block; font-size:.78rem; font-weight:600; color:var(--lx-muted); text-transform:uppercase; letter-spacing:.08em; margin-bottom:.5rem; }
.lx-cart-qty-control{ display:flex; align-items:center; border:1.5px solid var(--lx-line-strong); border-radius:var(--lx-pill); overflow:hidden; width:110px; }
.lx-cart-qty-btn{ width:34px; height:36px; background:none; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--lx-muted); font-size:1rem; transition:color var(--lx-dur), background var(--lx-dur); }
.lx-cart-qty-btn:hover{ color:var(--lx-blue); background:var(--lx-blue-050); }
.lx-cart-qty-input{ width:42px; text-align:center; border:none; font-family:var(--lx-body); font-size:.9rem; font-weight:600; color:var(--lx-navy); -moz-appearance:textfield; background:none; }
.lx-cart-qty-input::-webkit-outer-spin-button,.lx-cart-qty-input::-webkit-inner-spin-button{ -webkit-appearance:none; }
.lx-cart-item-remove{ display:flex; align-items:center; gap:.35rem; margin-top:.75rem; font-size:.8rem; color:var(--lx-faint); background:none; border:none; cursor:pointer; padding:0; font-family:var(--lx-body); transition:color var(--lx-dur); }
.lx-cart-item-remove:hover{ color:var(--lx-pink); }
.lx-cart-item-price{ font-weight:700; font-size:1.05rem; color:var(--lx-navy); text-align:right; white-space:nowrap; }
.lx-cart-item-was{ display:block; font-size:.82rem; font-weight:400; color:var(--lx-faint); text-decoration:line-through; }
.lx-cart-note{ margin-top:1.5rem; }
.lx-cart-note summary{ cursor:pointer; font-weight:600; color:var(--lx-muted); font-size:.9rem; display:inline-flex; align-items:center; gap:.5rem; list-style:none; }
.lx-cart-note summary::-webkit-details-marker{ display:none; }
.lx-cart-note textarea{ width:100%; margin-top:.75rem; padding:.75rem 1rem; border:1.5px solid var(--lx-line-strong); border-radius:var(--lx-r); font-family:var(--lx-body); font-size:.9rem; color:var(--lx-ink); resize:vertical; }
.lx-cart-note textarea:focus{ outline:none; border-color:var(--lx-blue); }
.lx-cart-summary-card{ background:#fff; border:1px solid var(--lx-line); border-radius:var(--lx-r-lg); padding:1.75rem; box-shadow:var(--lx-sh); position:sticky; top:calc(var(--header-height,72px) + 1.5rem); }
.lx-cart-summary-card h2{ margin:0 0 1.5rem; font-size:1.15rem; color:var(--lx-navy); }
.lx-cart-summary-row{ display:flex; justify-content:space-between; align-items:center; font-size:.9rem; color:var(--lx-muted); padding-block:.55rem; border-bottom:1px solid var(--lx-line); }
.lx-cart-summary-row--discount{ color:var(--lx-green); }
.lx-cart-summary-row--shipping{ color:var(--lx-muted); }
.lx-cart-summary-total{ display:flex; justify-content:space-between; align-items:center; padding-top:1rem; margin-top:.25rem; font-size:1.05rem; font-weight:700; color:var(--lx-navy); }
.lx-cart-checkout{ width:100%; margin-top:1.25rem; padding:1rem; background:var(--lx-blue); color:#fff; border:none; border-radius:var(--lx-pill); font-family:var(--lx-body); font-size:1rem; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:.5rem; transition:background var(--lx-dur), transform var(--lx-dur); }
.lx-cart-checkout:hover{ background:var(--lx-blue-700); transform:translateY(-1px); }
.lx-cart-continue{ display:block; text-align:center; margin-top:.75rem; font-size:.88rem; color:var(--lx-muted); text-decoration:none; transition:color var(--lx-dur); }
.lx-cart-continue:hover{ color:var(--lx-blue-ink); }
.lx-cart-trust{ display:flex; flex-direction:column; gap:.85rem; margin-top:1.5rem; padding-top:1.5rem; border-top:1px solid var(--lx-line); }
.lx-cart-trust-item{ display:flex; align-items:center; gap:.75rem; font-size:.83rem; }
.lx-cart-trust-item i{ font-size:1.3rem; color:var(--lx-blue); flex:none; }
.lx-cart-trust-item strong{ display:block; font-weight:700; color:var(--lx-navy); }
.lx-cart-trust-item span{ color:var(--lx-muted); }
.lx-cart-empty{ text-align:center; padding:5rem 1rem; }
.lx-cart-empty-icon{ width:80px; height:80px; background:var(--lx-blue-050); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem; font-size:2.2rem; color:var(--lx-blue); }
.lx-cart-empty h2{ color:var(--lx-navy); margin-bottom:.6rem; }
.lx-cart-empty p{ color:var(--lx-muted); max-width:38ch; margin:0 auto 2rem; line-height:1.65; }
.lx-cart-empty-cta{ display:inline-flex; align-items:center; gap:.5rem; background:var(--lx-blue); color:#fff; padding:.8rem 1.75rem; border-radius:var(--lx-pill); font-weight:700; text-decoration:none; transition:background var(--lx-dur), transform var(--lx-dur); }
.lx-cart-empty-cta:hover{ background:var(--lx-blue-700); transform:translateY(-2px); }
.lx-cart-quicklinks{ display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:.5rem 1rem; margin-top:1.5rem; font-size:.88rem; }
.lx-cart-quicklinks span{ color:var(--lx-muted); }
.lx-cart-quicklinks a{ color:var(--lx-blue-ink); font-weight:600; text-decoration:none; }
.lx-cart-quicklinks a:hover{ text-decoration:underline; }
@media(max-width:860px){ .lx-cart-grid{ grid-template-columns:1fr; } .lx-cart-summary-card{ position:static; } }
@media(max-width:520px){ .lx-cart-item{ grid-template-columns:72px 1fr; } .lx-cart-item-qty,.lx-cart-item-price{ grid-column:2; } .lx-cart-item-price{ display:none; } .lx-cart-item-price-mobile{ display:block; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Basket" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your basket" },

    { "type": "header", "content": "Summary" },
    { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Calculated at checkout" },
    { "type": "text", "id": "continue_link", "label": "Continue shopping URL", "default": "/" },

    { "type": "header", "content": "Order note" },
    { "type": "checkbox", "id": "show_note", "label": "Show order note field", "default": true },

    { "type": "header", "content": "Empty state" },
    { "type": "textarea", "id": "empty_text", "label": "Empty state text", "default": "Looks like you haven't added anything yet. Browse our science-backed range of fertility products." }
  ]
}
{% endschema %}
