{%- liquid
  assign mk = section.settings.mark_word | strip
  if mk != blank
    assign head_parts = section.settings.heading | split: mk
  endif
-%}

<section class="lx-hero" aria-label="{{ section.settings.heading | escape }}">
  <div class="lx-hero-grid">

    {%- comment -%} Text column {%- endcomment -%}
    <div class="lx-hero-text">
      <div class="lx-hero-eyebrow">
        <span class="lx-hero-eyebrow-rule" aria-hidden="true"></span>
        <span>{{ section.settings.eyebrow | default: 'Evidence-Based Fertility Support' }}</span>
      </div>

      <h1 class="lx-hero-heading">
        {%- if mk != blank and head_parts.size >= 2 -%}
          {{ head_parts[0] }}<mark class="lx-mark">{{ mk }}</mark>{{ head_parts[1] }}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="lx-hero-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="lx-hero-actions">
        {%- if section.settings.btn1_text != blank -%}
          <a href="{{ section.settings.btn1_link | default: '#' }}" class="lx-hero-btn-primary">
            {{ section.settings.btn1_text }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.btn2_text != blank -%}
          <a href="{{ section.settings.btn2_link | default: '#' }}" class="lx-hero-btn-ghost">
            {{ section.settings.btn2_text }}
          </a>
        {%- endif -%}
      </div>

      <div class="lx-hero-data" aria-label="Key statistics">
        <div class="lx-hero-stat">
          <strong>{{ section.settings.stat1_value | default: '94%' }}</strong>
          <span>{{ section.settings.stat1_label | default: 'of couples see improvement within 90 days' }}</span>
        </div>
        <div class="lx-hero-stat-divider" aria-hidden="true"></div>
        <div class="lx-hero-stat">
          <strong>{{ section.settings.stat2_value | default: '311k+' }}</strong>
          <span>{{ section.settings.stat2_label | default: 'couples supported since 2014' }}</span>
        </div>
      </div>
    </div>

    {%- comment -%} Image column — bleeds to right edge {%- endcomment -%}
    <div class="lx-hero-media" aria-hidden="true">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                  {{ section.settings.image | image_url: width: 900 }} 900w,
                  {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 860px) 100vw, 45vw"
          alt="{{ section.settings.image_alt | default: '' }}"
          width="1200"
          height="1500"
          loading="eager"
          fetchpriority="high"
          class="lx-hero-img">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'lx-hero-img lx-hero-placeholder' }}
      {%- endif -%}
    </div>

  </div>
</section>

{% stylesheet %}
/* ====================================================
   Hero — warm clinical, paper ground, Lora headline
   ==================================================== */
.lx-hero{
  background:var(--p-paper, #FAF8F5);
  overflow:hidden;
}

.lx-hero-grid{
  display:grid;
  grid-template-columns:55fr 45fr;
  min-height:min(100dvh, 860px);
  max-width:var(--lx-container, 1200px);
  margin-inline:auto;
}

/* ---- Text column ---- */
.lx-hero-text{
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:clamp(3rem, 8vw, 6rem) clamp(1.25rem, 4vw, 2.5rem) clamp(3rem, 8vw, 6rem) clamp(1.25rem, 6vw, 4rem);
  position:relative;
}
/* Right-edge hairline rule separating columns */
.lx-hero-text::after{
  content:"";
  position:absolute;
  right:0; top:15%; bottom:15%;
  width:1px;
  background:var(--p-rule, #D8D2C8);
}

/* ---- Eyebrow ---- */
.lx-hero-eyebrow{
  display:inline-flex;
  align-items:center;
  gap:.75rem;
  font-family:var(--lx-display);
  font-size:.72rem;
  font-weight:700;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--p-muted, #6B6460);
  margin-bottom:1.5rem;
}
.lx-hero-eyebrow-rule{
  display:block;
  width:2rem;
  height:2px;
  background:var(--p-amber, #C8860A);
  flex:none;
}

/* ---- Heading ---- */
.lx-hero-heading{
  font-family:var(--lx-serif, 'Lora', Georgia, serif);
  font-weight:500;
  font-size:clamp(2.4rem, 2vw + 1.6rem, 4rem);
  line-height:1.12;
  letter-spacing:-.01em;
  color:var(--p-charcoal, #1C1C1C);
  margin:0 0 1.5rem;
  text-wrap:balance;
  max-width:16ch;
}

/* ---- Sub ---- */
.lx-hero-sub{
  font-size:clamp(1rem, .5vw + .85rem, 1.15rem);
  color:var(--p-muted, #6B6460);
  line-height:1.7;
  max-width:44ch;
  margin:0 0 2.5rem;
}

/* ---- CTAs ---- */
.lx-hero-actions{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:1.25rem;
  margin-bottom:3rem;
}

.lx-hero-btn-primary{
  display:inline-flex;
  align-items:center;
  gap:.5rem;
  background:var(--p-blue, #1B5F8C);
  color:#fff;
  font-family:var(--lx-display);
  font-weight:700;
  font-size:.95rem;
  letter-spacing:.03em;
  padding:.85rem 1.6rem;
  border-radius:6px;
  border:none;
  cursor:pointer;
  text-decoration:none;
  transition:background .18s ease-out, transform .14s ease-out;
}
.lx-hero-btn-primary:hover{
  background:var(--p-blue-hover, #154E75);
  transform:translateY(-1px);
}
.lx-hero-btn-primary:active{ transform:scale(.97); }
.lx-hero-btn-primary svg{ transition:transform .14s ease-out; }
.lx-hero-btn-primary:hover svg{ transform:translateX(3px); }

.lx-hero-btn-ghost{
  font-family:var(--lx-body);
  font-size:.95rem;
  font-weight:500;
  color:var(--p-ink, #2E2E2E);
  text-decoration:underline;
  text-decoration-color:var(--p-rule-strong, #B8B0A4);
  text-decoration-thickness:1.5px;
  text-underline-offset:.2em;
  transition:text-decoration-color .16s;
}
.lx-hero-btn-ghost:hover{
  text-decoration-color:var(--p-amber, #C8860A);
  color:var(--p-ink, #2E2E2E);
}

/* ---- Data row ---- */
.lx-hero-data{
  display:flex;
  align-items:flex-start;
  gap:2rem;
}
.lx-hero-stat{
  display:flex;
  flex-direction:column;
  gap:.25rem;
}
.lx-hero-stat strong{
  font-family:var(--lx-display);
  font-size:clamp(1.6rem, 1vw + 1.2rem, 2rem);
  font-weight:700;
  color:var(--p-charcoal, #1C1C1C);
  font-variant-numeric:tabular-nums;
  line-height:1;
}
.lx-hero-stat span{
  font-size:.82rem;
  color:var(--p-muted, #6B6460);
  line-height:1.4;
  max-width:18ch;
}
.lx-hero-stat-divider{
  width:1px;
  align-self:stretch;
  background:var(--p-rule, #D8D2C8);
  margin-top:.25rem;
}

/* ---- Image column ---- */
.lx-hero-media{
  position:relative;
  overflow:hidden;
}
.lx-hero-img,
.lx-hero-placeholder{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center top;
  display:block;
}

/* ---- Responsive ---- */
@media (max-width:860px){
  .lx-hero-grid{
    grid-template-columns:1fr;
    grid-template-rows:auto auto;
    min-height:auto;
  }
  .lx-hero-text{
    order:2;
    padding:2.5rem clamp(1rem, 5vw, 2rem) 3rem;
  }
  .lx-hero-text::after{ display:none; }
  .lx-hero-heading{ max-width:none; }
  .lx-hero-media{
    order:1;
    height:min(55vw, 420px);
    position:relative;
  }
  .lx-hero-img,
  .lx-hero-placeholder{
    position:absolute;
  }
}

@media (max-width:480px){
  .lx-hero-data{ flex-direction:column; gap:1.25rem; }
  .lx-hero-stat-divider{ width:2rem; height:1px; align-self:auto; }
}

@media (prefers-reduced-motion:reduce){
  .lx-hero-btn-primary,
  .lx-hero-btn-primary svg,
  .lx-hero-btn-ghost{ transition:none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type":"text",     "id":"eyebrow",      "label":"Eyebrow",        "default":"Evidence-Based Fertility Support" },
    { "type":"textarea", "id":"heading",       "label":"Heading",        "default":"Science-backed support for your fertility journey" },
    { "type":"text",     "id":"mark_word",     "label":"Word to underline (amber)", "default":"fertility journey" },
    { "type":"textarea", "id":"subheading",    "label":"Subheading",     "default":"Clinically formulated supplements and testing kits trusted by over 311,000 couples." },
    { "type":"text",     "id":"btn1_text",     "label":"Primary CTA",    "default":"Shop the Protocol" },
    { "type":"url",      "id":"btn1_link",     "label":"Primary CTA link" },
    { "type":"text",     "id":"btn2_text",     "label":"Secondary CTA",  "default":"Read the science" },
    { "type":"url",      "id":"btn2_link",     "label":"Secondary CTA link" },
    { "type":"image_picker", "id":"image",     "label":"Hero image" },
    { "type":"text",     "id":"image_alt",     "label":"Image alt text" },
    { "type":"text",     "id":"stat1_value",   "label":"Stat 1 value",   "default":"94%" },
    { "type":"text",     "id":"stat1_label",   "label":"Stat 1 label",   "default":"of couples see improvement within 90 days" },
    { "type":"text",     "id":"stat2_value",   "label":"Stat 2 value",   "default":"311k+" },
    { "type":"text",     "id":"stat2_label",   "label":"Stat 2 label",   "default":"couples supported since 2014" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
